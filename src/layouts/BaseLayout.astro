---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/global.css";
import "../styles/ui.css";
interface Props { title?: string; description?: string; }
const { title = "Vinith Reddy Banda — Software Engineer", description = "Software engineer building useful products across backend systems, web interfaces, Android and applied AI." } = Astro.props;
---
<!doctype html><html lang="en"><head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="theme-color" content="#101010" /><meta name="color-scheme" content="dark" /><meta name="description" content={description} />
<meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content="website" /><meta property="og:url" content="https://vinithreddybanda.github.io/" />
<title>{title}</title></head><body>
<canvas class="paper-canvas" data-paper-canvas aria-hidden="true"></canvas><div class="paper-grain" aria-hidden="true"></div>
<a class="skip-link" href="#main">Skip to content</a><SiteHeader /><main id="main"><slot /></main><div class="page-end"><SiteFooter /></div>
<div class="visitor-layer" data-visitor-layer aria-hidden="true"></div>
<div class="cursor-dot" data-cursor aria-hidden="true"></div>
<div class="scroll-instrument" data-scroll-instrument aria-label="Scroll progress"><span data-scroll-fill></span><div class="scroll-clock" data-scroll-clock><i></i><b></b></div></div>
<div class="command-overlay" data-command-overlay aria-hidden="true"><div class="command-panel" role="dialog" aria-modal="true" aria-label="Command menu"><div class="command-search"><span>⌘</span><input data-command-input type="search" placeholder="Find a page or project..." autocomplete="off" /><kbd>ESC</kbd></div><div class="command-results" data-command-results></div><div class="command-foot"><span>↑↓ Navigate</span><span>↵ Open</span><span>ESC Close</span></div></div></div>
<script>import "../scripts/paper"; import "../scripts/app";</script>
</body></html>