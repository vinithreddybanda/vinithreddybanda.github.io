---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/global.css";
interface Props { title?: string; description?: string; }
const { title = "Vinith | Creative developer", description = "I’m Vinith. I build apps, websites and little experiments for the internet." } = Astro.props;
---
<!doctype html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#f3f2ed" />
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://vinithreddybanda.github.io/" />
  <title>{title}</title>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <SiteHeader />
  <main id="main"><slot /></main>
  <SiteFooter />
  <script>import "../scripts/app";</script>
</body>
</html>