---
import { socials } from "../data/content";
const {
  title = "Vinith Reddy Banda — Software Engineer & Builder",
  description = "A small world of software, experiments and things made with care."
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#eae0ce" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://vinithreddybanda.github.io/" />
    <meta property="og:image" content="https://avatars.githubusercontent.com/u/116493221?v=4" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600&family=DM+Sans:wght@400;500;600;700&family=Fraunces:opsz,wght,SOFT,WONK@9..144,400,20,1;9..144,500,20,1&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="paper-noise" aria-hidden="true"></div>
    <div class="page-progress" aria-hidden="true"><span id="page-progress-bar"></span></div>
    <header class="site-nav" data-site-nav>
      <a class="brand" href="#home" aria-label="Vinith, home"><span class="brand-mark">v.</span><span class="brand-name">vinith reddy banda</span></a>
      <nav aria-label="Main navigation">
        <a href="#home">Home</a>
        <a href="#work">Work</a>
        <a href="#about">About</a>
        <a href="#contact">Contact</a>
      </nav>
      <a class="nav-availability" href="#contact"><span></span> Open to good problems</a>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="footer-top">
        <div>
          <span class="footer-kicker">THE LITTLE WORLD OF</span>
          <a class="footer-signature" href="#home">Vinith<span>.</span></a>
        </div>
        <p>Made slowly, with curiosity<br />and a suspicious number of commits.</p>
        <a class="back-top" href="#home">Back to the clouds <span>↑</span></a>
      </div>
      <div class="footer-bottom">
        <span>© {new Date().getFullYear()} Vinith Reddy Banda</span>
        <div class="footer-links">
          {socials.filter((item) => ["GitHub", "LinkedIn", "Devpost"].includes(item.label)).map((item) => (
            <a href={item.href} target="_blank" rel="noreferrer">{item.label}<span>↗</span></a>
          ))}
        </div>
        <span>Somewhere in India · <span id="local-time">--:--</span></span>
      </div>
    </footer>
    <script>
      import "../scripts/styles.js";
      import "../scripts/world.js";
    </script>
  </body>
</html>
