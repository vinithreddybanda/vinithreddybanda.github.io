---
interface Props { scene?: string; class?: string; }
const { scene = "hero", class: className = "" } = Astro.props;
---
<div class={`iso-scene ${className}`} aria-hidden="true" data-iso-scene={scene}>
<svg viewBox="0 0 640 450" role="presentation" focusable="false" xmlns="http://www.w3.org/2000/svg">
<defs>
 <linearGradient id="top" x2="1" y2="1"><stop stop-color="#f4f4f1"/><stop offset="1" stop-color="#777"/></linearGradient>
 <linearGradient id="face" x2="0" y2="1"><stop stop-color="#777"/><stop offset="1" stop-color="#242424"/></linearGradient>
 <linearGradient id="screen" x2="1" y2="1"><stop stop-color="#d8d8d4"/><stop offset="1" stop-color="#555"/></linearGradient>
 <pattern id={`grain-${scene}`} width="8" height="8" patternUnits="userSpaceOnUse"><path d="M0 8L8 0" stroke="#fff" stroke-opacity=".08"/></pattern>
 <filter id={`shadow-${scene}`} x="-30%" y="-30%" width="160%" height="180%"><feGaussianBlur stdDeviation="9"/></filter>
</defs>
<ellipse cx="320" cy="365" rx="245" ry="28" fill="#000" opacity=".58" filter={`url(#shadow-${scene})`}/>
{scene === "hero" && <>
 <!-- A developer's desk: display, keyboard, notebook and a small task board. -->
 <g class="base"><path d="M52 284l266-133 270 135-266 133z" fill="#181818" stroke="#777"/><path d="M52 284l270 135v13L52 297z" fill="#090909"/><path d="M322 419l266-133v13L322 432z" fill="#333"/><path d="M52 284l266-133 270 135-266 133z" fill={`url(#grain-${scene})`}/></g>
 <g class="desk-monitor"><path d="M193 92l133-67 146 73-133 67z" fill="#eee" stroke="#fff"/><path d="M339 165l133-67v113l-133 67z" fill="#333" stroke="#aaa"/><path d="M193 92l146 73v113l-146-73z" fill="#777" stroke="#ddd"/><path d="M207 94l119-60 126 63-119 60z" fill="#111" stroke="#aaa"/><path d="M207 94l126 63v86l-126-63z" fill="#171717"/><path d="M333 157l119-60v86l-119 60z" fill="#090909"/><g class="code-lines" stroke-linecap="round" fill="none"><path d="M229 111l46-23m-46 35 83-42m-83 54 63-32m-63 44 92-47m-92 59 48-24" stroke="#eee" stroke-width="3"/><path d="M348 165l52-26m-52 39 78-39m-78 52 54-27" stroke="#999" stroke-width="2"/></g><path d="M310 280l29 14v18l-29-14z" fill="#aaa"/><path d="M275 312l65-33 64 32-65 33z" fill="#777" stroke="#ddd"/></g>
 <g class="keyboard"><path d="M153 296l111-56 112 56-111 56z" fill="#777" stroke="#ddd"/><path d="M153 296l112 56v13l-112-56z" fill="#444"/><path d="M265 352l111-56v13l-111 56z" fill="#222"/><path d="M169 295l95-48 94 47-95 48z" fill="#171717"/><path d="M184 294l14-7 12 6-14 7zm24-12 14-7 12 6-14 7zm24-12 14-7 12 6-14 7zm24-12 14-7 12 6-14 7zm24 12 14-7 12 6-14 7zm24 12 14-7 12 6-14 7z" fill="#ddd"/></g>
 <g class="notebook"><path d="M405 300l71-36 76 38-71 36z" fill="#eee" stroke="#fff"/><path d="M481 338l71-36v10l-71 36z" fill="#555"/><path d="M405 300l76 38v10l-76-38z" fill="#888"/><path d="M420 299l56-28 57 28-56 28z" fill="#bbb"/><path d="M430 297l44-22m-38 29 45-23m-36 30 38-19" stroke="#333" stroke-width="2"/></g>
 <g class="desk-lamp"><path d="M105 270l18-9 13 7-18 9z" fill="#777"/><path d="M124 268l17-62 8 2-17 63z" fill="#aaa"/><circle cx="145" cy="205" r="7" fill="#eee"/><path d="M145 205l39-29 7 8-39 29z" fill="#aaa"/><path d="M177 177l23-18 27 14-24 18z" fill="#eee" stroke="#fff"/><path d="M183 180l17-13 16 8-17 13z" fill="#222"/></g>
 <g class="terminal-cursor"><rect x="227" y="137" width="5" height="8" fill="#fff"/></g>
 </>}
{scene === "clinic" && <>
 <!-- CareSchedule: a cutaway clinic with reception, waiting, provider room and live schedule. -->
 <g class="base"><path d="M38 292l280-140 284 142-282 141z" fill="#1a1a1a" stroke="#777"/><path d="M38 292l282 143v13L38 305z" fill="#080808"/><path d="M320 435l282-141v13L320 448z" fill="#333"/><path d="M38 292l280-140 284 142-282 141z" fill={`url(#grain-${scene})`}/></g>
 <g class="clinic-building"><path d="M113 183l203-102 211 105-204 102z" fill="#eee" stroke="#fff"/><path d="M323 288l204-102v111L323 399z" fill="#444" stroke="#aaa"/><path d="M113 183l210 105v111L113 294z" fill="#777" stroke="#ddd"/><path d="M130 184l186-93 194 97-187 94z" fill="#242424"/><path d="M130 184l194 97v95l-194-97z" fill="#555"/><path d="M324 281l186-93v95l-186 93z" fill="#292929"/>
 <!-- reception window and entry --> <path d="M147 210l77 38v47l-77-38z" fill="#171717" stroke="#ddd"/><path d="M157 218l56 28v25l-56-28z" fill="#999"/><path d="M163 276l67 33-1 18-67-33z" fill="#eee"/><path d="M181 285l31 15v-7l-31-15z" fill="#333"/>
 <!-- exam-room window --> <path d="M359 292l91-46v43l-91 46z" fill="#111" stroke="#ddd"/><path d="M370 294l69-35v26l-69 35z" fill="#777"/><path d="M377 308l54-27" stroke="#eee" stroke-width="2"/>
 <!-- door and cross --> <path d="M263 235l39 20v87l-39-20z" fill="#151515" stroke="#eee"/><path d="M282 245v84" stroke="#888"/><path d="M170 153l27-14 28 14-27 14z" fill="#eee"/><path d="M198 167l27-14v40l-27 14z" fill="#444"/><path d="M170 153l28 14v40l-28-14z" fill="#888"/><path d="M197 151v25m-12-12h24" stroke="#111" stroke-width="6"/>
 </g>
 <!-- Reception desk, chairs and exam bed are separate, recognisable pieces. -->
 <g class="reception"><path d="M111 310l49-25 52 26-49 26z" fill="#ddd"/><path d="M163 337l49-26v22l-49 26z" fill="#444"/><path d="M111 310l52 27v22l-52-27z" fill="#777"/><path d="M123 307l37-19 37 19-37 19z" fill="#222"/></g>
 <g class="waiting-chair"><path d="M226 335l24-12 28 14-24 12z" fill="#ddd"/><path d="M250 349l24-12v22l-24 12z" fill="#555"/><path d="M226 335l24 14v22l-24-14z" fill="#888"/><path d="M232 321l19-10 23 12-19 10z" fill="#aaa"/></g>
 <g class="exam-bed"><path d="M376 350l58-29 64 32-58 29z" fill="#eee"/><path d="M440 382l58-29v9l-58 29z" fill="#555"/><path d="M376 350l64 32v9l-64-32z" fill="#888"/><path d="M387 348l47-24 43 22-47 24z" fill="#aaa"/><path d="M398 372v18m66-26v18" stroke="#ddd" stroke-width="4"/></g>
 <!-- schedule board: appointment cards travel from request queue into a real provider slot -->
 <g class="schedule-board"><path d="M425 78l94-47 99 49-94 47z" fill="#eee" stroke="#fff"/><path d="M524 127l94-47v94l-94 47z" fill="#444"/><path d="M425 78l99 49v94l-99-49z" fill="#777"/><path d="M438 79l81-40 80 40-81 40z" fill="#151515"/><path d="M448 83l26-13m-26 23 49-25m-49 35 37-19m-37 29 60-31" stroke="#aaa" stroke-width="2"/><g class="calendar-slot"><path d="M467 107l25-13 27 13-25 13z" fill="#eee"/><path d="M494 120l25-13v17l-25 13z" fill="#888"/><path d="M467 107l27 13v17l-27-13z" fill="#bbb"/></g><path d="M538 84l58-29m-58 41 58-29m-58 41 58-29" stroke="#ddd" stroke-width="2"/></g>
 <g class="patient" style="translate:220px 300px"><circle cx="0" cy="-24" r="8" fill="#eee"/><path d="M-8-15l16 0 8 25-24 0z" fill="#aaa" stroke="#eee"/><path d="M-5 9l-5 16m15-16 6 16" stroke="#ddd" stroke-width="4" stroke-linecap="round"/></g>
 </>}
{scene === "journal" && <>
 <!-- JournalAI: private writing becomes a mood signal and a compact insight, not a generic AI orb. -->
 <g class="base"><path d="M40 294l278-139 282 141-280 140z" fill="#1a1a1a" stroke="#777"/><path d="M40 294l280 142v13L40 307z" fill="#090909"/><path d="M320 436l280-140v13L320 449z" fill="#333"/><path d="M40 294l278-139 282 141-280 140z" fill={`url(#grain-${scene})`}/></g>
 <g class="journal-book"><path d="M93 248l170-85 164 82-170 85z" fill="#777" stroke="#eee"/><path d="M257 330l170-85v13l-170 85z" fill="#444"/><path d="M93 248l164 82v13L93 261z" fill="#555"/><path d="M107 245l156-78 147 73-156 78z" fill="#eee" stroke="#fff"/><path d="M263 318l147-78v10l-147 78z" fill="#aaa"/><path d="M107 245l156 73v10l-156-73z" fill="#bbb"/><path d="M263 170v148" stroke="#777" stroke-width="2"/><g class="handwriting" fill="none" stroke="#333" stroke-width="2" stroke-linecap="round"><path d="M128 231l68 32m-61-43 51 24m-43-36 59 28m-52-39 38 18"/><path d="M281 210l94 46m-87-59 75 37m-67-48 82 41"/></g><path d="M133 266l83 39m-74-26 54 25m99 20 88-44" stroke="#777" stroke-width="1.4"/></g>
 <g class="pen"><path d="M183 112l13-7 99 50-13 7z" fill="#eee" stroke="#fff"/><path d="M282 162l13-7-7 17-10 4z" fill="#555"/><path d="M183 112l99 50-8 11-99-50z" fill="#888"/><path d="M190 109l8-4 98 49-8 4z" fill="#fff"/><path d="M281 167l7-3-3 9-6 3z" fill="#ddd"/></g>
 <!-- Private entry cards flow into local analysis, then an insight chart. -->
 <g class="entry-stack"><path d="M385 119l67-34 70 35-67 35z" fill="#eee"/><path d="M455 155l67-35v54l-67 35z" fill="#555"/><path d="M385 119l70 36v54l-70-36z" fill="#888"/><path d="M400 119l52-26 51 26-52 26z" fill="#171717"/><path d="M410 119l31-16m-27 24 40-20" stroke="#ddd" stroke-width="2"/></g>
 <g class="insight-panel"><path d="M414 258l83-42 91 45-83 42z" fill="#eee" stroke="#fff"/><path d="M505 303l83-42v55l-83 42z" fill="#444"/><path d="M414 258l91 45v55l-91-45z" fill="#777"/><path d="M428 258l69-35 69 34-69 35z" fill="#151515"/><path d="M442 274l16-8 13 6 14-19 14 7 17-17 20 10" fill="none" stroke="#eee" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/><path d="M442 283h98m-98 8h70" stroke="#888" stroke-width="1.5"/></g>
 <g class="analysis-pulse"><circle cx="343" cy="180" r="7" fill="#eee"/><circle cx="343" cy="180" r="17" fill="none" stroke="#ddd" stroke-opacity=".5"/></g>
 <g class="mood-marker"><path d="M474 202l8-4 8 4-8 4z" fill="#fff"/><path d="M482 206l8-4v12l-8 4z" fill="#555"/><path d="M474 202l8 4v12l-8-4z" fill="#999"/></g>
 </>}
{scene === "android" && <>
 <!-- Android Discord presence: handset controls a desktop client through a JNI/native bridge. -->
 <g class="base"><path d="M36 293l282-141 285 143-283 142z" fill="#1a1a1a" stroke="#777"/><path d="M36 293l284 144v13L36 306z" fill="#090909"/><path d="M320 437l283-142v13L320 450z" fill="#333"/><path d="M36 293l282-141 285 143-283 142z" fill={`url(#grain-${scene})`}/></g>
 <!-- Desktop client -->
 <g class="desktop"><path d="M290 102l137-69 154 77-137 69z" fill="#eee" stroke="#fff"/><path d="M444 179l137-69v118l-137 69z" fill="#333" stroke="#aaa"/><path d="M290 102l154 77v118l-154-77z" fill="#777" stroke="#ddd"/><path d="M305 104l122-61 135 67-122 61z" fill="#111" stroke="#aaa"/><path d="M305 104l135 67v91l-135-67z" fill="#171717"/><path d="M440 171l122-61v91l-122 61z" fill="#090909"/><path d="M321 120l21-11 0 68-21 11z" fill="#777"/><path d="M355 116l75 37m-75-23 75 37m-75-23 75 37" stroke="#aaa" stroke-width="2"/><circle cx="367" cy="133" r="8" fill="#eee"/><path d="M355 204l68 34 43-22-68-34z" fill="#555"/><path d="M421 271l23-12v17l-23 12z" fill="#aaa"/></g>
 <!-- Android handset -->
 <g class="handset"><path d="M104 157l83-42 97 49-83 42z" fill="#eee" stroke="#fff"/><path d="M201 206l83-42v144l-83 42z" fill="#333" stroke="#aaa"/><path d="M104 157l97 49v144l-97-49z" fill="#777" stroke="#ddd"/><path d="M115 159l72-36 82 41-72 36z" fill="#111"/><path d="M115 159l82 41v120l-82-41z" fill="#151515"/><path d="M197 200l72-36v120l-72 36z" fill="#090909"/><path d="M129 175l45 23m-45-11 45 23m-45-11 45 23" stroke="#ddd" stroke-width="2"/><circle cx="170" cy="275" r="7" fill="#aaa" stroke="#fff"/><path d="M134 150l28-14 31 15-28 14z" fill="#555"/><path d="M146 150l16-8 17 8-16 8z" fill="#eee"/></g>
 <!-- Native bridge: distinct paired endpoints and a cable path, with data packets travelling both ways. -->
 <g class="bridge"><path d="M232 291c42 45 69 51 108 22s60-32 95-1" fill="none" stroke="#aaa" stroke-width="4"/><path d="M232 291c42 45 69 51 108 22s60-32 95-1" fill="none" stroke="#222" stroke-width="1.5" stroke-dasharray="5 6"/></g>
 <g class="packet packet-a"><circle r="5" fill="#fff"/><circle r="10" fill="none" stroke="#eee" stroke-opacity=".6"/></g>
 <g class="packet packet-b"><circle r="4" fill="#aaa"/><circle r="8" fill="none" stroke="#ddd" stroke-opacity=".5"/></g>
 <!-- Status activity card on desktop -->
 <g class="presence-card"><path d="M457 297l61-31 67 34-61 31z" fill="#eee"/><path d="M524 331l61-31v35l-61 31z" fill="#555"/><path d="M457 297l67 34v35l-67-34z" fill="#888"/><circle cx="489" cy="300" r="7" fill="#222" stroke="#fff"/><path d="M505 303l34-17m-34 27 44-22" stroke="#222" stroke-width="2"/></g>
 </>}
</svg>
</div>
<style>
.iso-scene{position:relative;width:100%;height:100%;overflow:visible;isolation:isolate;contain:layout paint}
.iso-scene svg{display:block;width:100%;height:100%;overflow:visible}
.base{transform-origin:center}
.desk-monitor{transform-origin:333px 157px}
.code-lines{animation:code-refresh 5s steps(5,end) infinite}
.terminal-cursor{animation:cursor-blink 1.05s steps(2,start) infinite}
.keyboard{animation:keyboard-tap 4.8s ease-in-out infinite}
.desk-lamp{transform-origin:145px 205px;animation:lamp-adjust 9s ease-in-out infinite alternate}
.calendar-slot{animation:slot-shift 8s cubic-bezier(.45,0,.2,1) infinite alternate}
.patient{animation:patient-route 11s cubic-bezier(.4,0,.2,1) infinite}

.waiting-chair{animation:chair-rock 6s ease-in-out infinite alternate}
.handwriting{stroke-dasharray:none}
.pen{transform-origin:280px 160px;animation:pen-write 7s ease-in-out infinite alternate}
.entry-stack{animation:entry-lift 8s ease-in-out infinite alternate}
.analysis-pulse{animation:analysis-breathe 3.8s ease-in-out infinite}
.mood-marker{animation:mood-rise 8s ease-in-out infinite alternate}
.insight-panel{animation:insight-tilt 8s ease-in-out infinite alternate}
.packet{offset-path:path("M232 291 C274 336 301 342 340 313 S400 281 435 312");offset-rotate:0deg;animation:packet-travel 3.4s linear infinite}
.packet-b{animation-delay:-1.7s;animation-direction:reverse}
.handset{animation:handset-tap 5.2s ease-in-out infinite}
.presence-card{animation:presence-sync 5.2s ease-in-out infinite}
@keyframes code-refresh{0%,12%{opacity:.5}40%,75%{opacity:1}100%{opacity:.5}}
@keyframes cursor-blink{50%{opacity:0}}
@keyframes keyboard-tap{0%,100%{transform:translateY(0)}48%,54%{transform:translateY(2px)}}
@keyframes lamp-adjust{from{transform:rotate(-2deg)}to{transform:rotate(2deg)}}
@keyframes slot-shift{0%{transform:translate(0,0)}100%{transform:translate(19px,-10px)}}
@keyframes patient-route{0%,100%{translate:220px 300px}50%{translate:286px 267px}}

@keyframes chair-rock{from{transform:translateY(0)}to{transform:translateY(-2px)}}

@keyframes pen-write{from{transform:translate(0,0) rotate(-2deg)}to{transform:translate(17px,-9px) rotate(2deg)}}
@keyframes entry-lift{from{transform:translateY(0)}to{transform:translateY(-12px)}}
@keyframes analysis-breathe{0%,100%{opacity:.45;transform:scale(.8)}50%{opacity:1;transform:scale(1.15)}}
@keyframes mood-rise{from{transform:translateY(12px)}to{transform:translateY(-12px)}}
@keyframes insight-tilt{from{transform:translateY(0)}to{transform:translateY(-7px)}}
@keyframes packet-travel{0%{offset-distance:0%;opacity:0}8%,90%{opacity:1}100%{offset-distance:100%;opacity:0}}
@keyframes handset-tap{0%,40%,100%{transform:translateY(0)}48%,54%{transform:translateY(-3px)}}
@keyframes presence-sync{0%,38%,100%{opacity:.7}48%,72%{opacity:1;filter:brightness(1.35)}}
@media(prefers-reduced-motion:reduce){.iso-scene [class]{animation:none!important}}
</style>
