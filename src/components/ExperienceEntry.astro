---
interface Props {
  item: { period: string; role: string; company: string; location: string; summary: string; highlights: string[]; stack: string[]; };
}
const { item } = Astro.props;
---
<article class="experience-entry" data-reveal>
  <div class="experience-period"><span>{item.period}</span><small>{item.location}</small></div>
  <div class="experience-main">
    <div class="experience-heading"><h3>{item.role}</h3><p>{item.company}</p></div>
    <p class="experience-summary">{item.summary}</p>
    <ul class="experience-highlights">{item.highlights.map((highlight) => <li>{highlight}</li>)}</ul>
    <p class="experience-stack">{item.stack.join("  ·  ")}</p>
  </div>
</article>