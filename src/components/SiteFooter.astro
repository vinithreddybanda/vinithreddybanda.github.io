---
import { profile } from "@data/portfolio";
---
<footer class="site-footer" id="contact">
  <div class="container">
    <p class="contact-label">HAVE A PROJECT IN MIND?</p>
    <h2 class="contact-title">Let’s build<br />something <em>useful.</em></h2>
    <div class="contact-row"><div><p class="contact-label">EMAIL</p><a class="contact-email" href={`mailto:${profile.email}`}>{profile.email}<span> ↗</span></a></div><p class="contact-note">Open to thoughtful work, interesting problems, and opportunities to build.</p></div>
    <div class="footer-bottom"><span>© {new Date().getFullYear()} {profile.name}</span><div class="footer-links"><a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a href={`mailto:${profile.email}`}>Email ↗</a><a href="#top">Back to top ↑</a></div></div>
  </div>
</footer>
