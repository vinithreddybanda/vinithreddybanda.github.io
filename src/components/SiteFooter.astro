---
import { profile } from "@data/portfolio";
---
<footer class="contact-section" id="contact"><div class="contact-inner section-pad">
  <div class="contact-top"><span>ONE LAST THING</span><span>04 / SAY HELLO</span></div>
  <p class="contact-prelude">Have something good growing?</p>
  <a class="contact-title" href={`mailto:${profile.email}`}>Let's make<br /><span>it happen.</span><i>↗</i></a>
  <div class="contact-bottom"><a class="contact-email" href={`mailto:${profile.email}`}>{profile.email}</a><div class="social-links"><a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a></div><span>© {new Date().getFullYear()} {profile.name}</span></div>
</div></footer>
