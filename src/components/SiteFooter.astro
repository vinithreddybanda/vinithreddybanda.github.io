import { profile } from "@data/portfolio";
---
<footer class="site-footer" id="contact">
  <div class="footer-inner">
    <p class="eyebrow">HAVE SOMETHING IN MIND?</p>
    <h2>Let's make<br /><em>it happen.</em></h2>
    <a class="footer-email" href={`mailto:${profile.email}`}>{profile.email} <span>↗</span></a>
    <div class="footer-bottom"><span>© {new Date().getFullYear()} {profile.name}</span><div class="footer-links"><a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a href="#top">Back to top ↑</a></div></div>
  </div>
</footer>
