---
const path = Astro.url.pathname;
const links = [{href:"/work/",label:"Work",number:"01"},{href:"/about/",label:"About",number:"02"},{href:"/contact/",label:"Contact",number:"03"}];
const active = (href: string) => path.startsWith(href);
---
<header class="site-header" data-header>
<a class="site-header__brand" href="/" aria-label="Vinith Reddy Banda, home"><span class="site-header__monogram">V<span>/</span>B</span><span class="site-header__identity">VINITH REDDY BANDA<small>SOFTWARE ENGINEER</small></span></a>
<nav class="site-nav" aria-label="Primary navigation">{links.map((link)=><a class:list={["site-nav__link",active(link.href)&&"is-active"]} href={link.href} aria-current={active(link.href)?"page":undefined}><span>{link.number}</span>{link.label}</a>)}</nav>
<span class="site-header__location">INDIA <i aria-hidden="true"></i> 2026</span>
</header>