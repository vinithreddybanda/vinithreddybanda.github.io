---
const path = Astro.url.pathname;
const links = [{ href: "/work/", label: "Work" }, { href: "/about/", label: "Studio" }, { href: "/lab/", label: "Lab" }, { href: "/contact/", label: "Contact" }];
---
<div class="site-topline">
  <div class="topline-left"><span class="status-light"></span><span>INDEPENDENT SOFTWARE ENGINEER</span><span class="topline-divider">/</span><span>HYDERABAD, IN</span></div>
  <div class="topline-right"><span>LOCAL <b data-local-time>--:--:--</b></span><span>FPS <b data-fps>--</b></span><span>HERE <b data-presence-count>01</b></span></div>
</div>
<header class="site-header" data-header>
  <a class="site-brand" href="/" aria-label="Vinith Reddy Banda, home"><span class="brand-monogram">V<span>.</span>B</span><span class="brand-name">VINITH REDDY BANDA<small>SOFTWARE / SYSTEMS / INTERACTION</small></span></a>
  <nav class="site-nav" aria-label="Primary navigation">{links.map((link) => <a class:list={["nav-link", path === link.href || (link.href !== "/" && path.startsWith(link.href)) ? "is-active" : ""]} href={link.href} aria-current={path === link.href || (link.href !== "/" && path.startsWith(link.href)) ? "page" : undefined}>{link.label}</a>)}</nav>
  <div class="header-actions"><button class="theme-button" type="button" data-theme-toggle aria-label="Switch to light theme" title="Switch theme"><span data-theme-icon>☼</span><span data-theme-label>LIGHT</span></button><button class="command-button" type="button" data-command-open aria-label="Open command menu"><span>⌘</span><kbd>K</kbd></button></div>
</header>