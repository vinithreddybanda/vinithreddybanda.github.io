---
import type { Project } from "../data/projects";
interface Props { project: Project; featured?: boolean; }
const { project, featured = false } = Astro.props;
---
<article class:list={["project-card", featured && "project-card--featured"]}>
  <a class="project-card__link" href={`/work/${project.slug}/`} aria-label={`Read the ${project.name} case study`}>
    <div class="project-card__top">
      <span class="eyebrow">{project.number} / {project.category}</span>
      <span class="project-card__year">{project.year}</span>
    </div>
    <div class="project-card__body">
      <div>
        <h3>{project.name}</h3>
        <p>{project.summary}</p>
      </div>
      <span class="project-card__arrow" aria-hidden="true">↗</span>
    </div>
    <div class="project-card__bottom">
      <div class="tag-list">{project.stack.slice(0, 5).map((item) => <span>{item}</span>)}</div>
      <span class="project-status">{project.status}</span>
    </div>
  </a>
</article>
