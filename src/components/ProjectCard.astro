---
import type { Project } from "../data/projects";
interface Props { project: Project; featured?: boolean; }
const { project } = Astro.props;
---
<article class="project-card">
  <a class="project-card__link" href={`/work/${project.slug}/`} aria-label={`Read the ${project.name} case study`}>
    <div class="project-card__top"><span class="eyebrow">{project.number}</span><span class="project-card__year">{project.year}</span></div>
    <div class="project-card__body"><div><h3>{project.name}</h3><p>{project.summary}</p></div><span class="project-card__arrow" aria-hidden="true">↗</span></div>
    <div class="project-card__bottom"><span class="project-category">{project.category}</span></div>
  </a>
</article>