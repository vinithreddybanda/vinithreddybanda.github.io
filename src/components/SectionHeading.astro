---
interface Props { eyebrow: string; title: string; accent?: string; note?: string; number?: string; }
const { eyebrow, title, accent, note, number } = Astro.props;
---
<div class="section-heading">
  <div class="section-heading__meta">
    {number && <span class="eyebrow-number">{number}</span>}
    <span class="eyebrow">{eyebrow}</span>
  </div>
  <div class="section-heading__main">
    <h2>{title}{accent && <> <em>{accent}</em></>}</h2>
    {note && <p>{note}</p>}
  </div>
</div>
