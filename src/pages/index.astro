---
const projects = [
  { id: "care", index: "01", name: "CareSchedule", category: "Systems / Healthcare", year: "2026", summary: "A clinic operations platform that makes complex care logistics feel simple.", detail: "Designed and built during my .NET Full Stack internship at Cognizant. The platform uses six-layer Clean Architecture, 148 REST APIs and six role-based workflows. Its appointment engine resolves provider availability, leave, holidays and resource constraints before a slot is offered.", stack: ".NET · React · EF Core · SQL Server", metric: "148", metricLabel: "REST endpoints", accent: "#b7c6ad" },
  { id: "journal", index: "02", name: "JournalAI", category: "Product / Applied AI", year: "2025", summary: "A quieter space for reflection, with patterns that emerge over time.", detail: "A private journaling experience that turns personal entries into structured mood insights. Built with a cloud-ready architecture and an automated delivery pipeline.", stack: "Next.js · TypeScript · Supabase · Azure · Docker", metric: "∞", metricLabel: "Room to reflect", accent: "#d5b89b" },
  { id: "presence", index: "03", name: "Activities for Discord", category: "Android / Native systems", year: "2025", summary: "Taking desktop presence controls somewhere they were never meant to be.", detail: "An Android application bringing mobile control to Discord Rich Presence through a native integration layer, persistent SDK sessions, JNI and encrypted credential storage.", stack: "Android · Java · C++ · JNI · Discord Partner SDK", metric: "Native", metricLabel: "Android integration", accent: "#aeb8dc" },
];
const capabilities = ["C# / .NET", "TypeScript", "React / Next.js", "Java / Kotlin", "C++ / JNI", "SQL / PostgreSQL", "Azure / Docker", "Systems design"];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#10110f" />
    <meta name="description" content="Vinith Reddy Banda — software engineer exploring the space between systems, interfaces and ideas." />
    <title>Vinith Reddy Banda — Selected thoughts & work</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />
    <style>
      :root {
        color-scheme: dark;
        --bg:#10110f; --ink:#eeeee8; --muted:#96978f; --dim:#62645d;
        --line:rgba(238,238,232,.13); --panel:#191b18; --accent:#c9c1ad;
        --serif:"Instrument Serif",Georgia,serif;
        --sans:"DM Sans",-apple-system,BlinkMacSystemFont,"SF Pro Display","Helvetica Neue",sans-serif;
        --mono:"DM Mono",ui-monospace,monospace;
        --ease:cubic-bezier(.2,.8,.2,1); --gutter:clamp(20px,5.5vw,88px);
        --nav-h:76px;
      }
      [data-theme="light"] { color-scheme:light; --bg:#e9e9e3; --ink:#171914; --muted:#65675f; --dim:#92948b; --line:rgba(23,25,20,.15); --panel:#f1f1eb; --accent:#77684f; }
      *{box-sizing:border-box}
      html{background:var(--bg);scroll-behavior:smooth;scroll-padding-top:var(--nav-h)}
      body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--sans);-webkit-font-smoothing:antialiased;overflow-x:clip;transition:background .5s,color .5s}
      body,button,a{font-family:var(--sans)}
      a{color:inherit;text-decoration:none}
      button{color:inherit}
      ::selection{background:var(--accent);color:var(--bg)}
      .wrap{width:min(100%,1600px);margin:auto;padding-inline:var(--gutter)}
      .mono{font:10px/1.5 var(--mono);letter-spacing:.1em;text-transform:uppercase}
      .muted{color:var(--muted)}
      .grain{position:fixed;inset:0;z-index:30;pointer-events:none;opacity:.12;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.16'/%3E%3C/svg%3E");mix-blend-mode:soft-light}
      .ambient{position:fixed;z-index:-1;inset:-20%;pointer-events:none;background:radial-gradient(38vw 38vw at var(--mx,70%) var(--my,28%),rgba(173,158,126,.10),transparent 70%);opacity:.9;transition:opacity .5s}
      .top{height:var(--nav-h);position:fixed;z-index:40;inset:0 0 auto;border-bottom:1px solid transparent;transition:background .45s,border-color .45s,backdrop-filter .45s}
      .top.scrolled{background:color-mix(in srgb,var(--bg) 66%,transparent);border-color:var(--line);backdrop-filter:blur(22px) saturate(145%);-webkit-backdrop-filter:blur(22px) saturate(145%)}
      .nav{height:100%;display:flex;align-items:center;justify-content:space-between}
      .brand{font-size:13px;font-weight:600;letter-spacing:-.06em}
      .nav-right{display:flex;align-items:center;gap:clamp(18px,3vw,42px)}
      .nav-links{display:flex;gap:clamp(16px,2.8vw,38px);align-items:center}
      .nav-links a{font-size:11px;color:var(--muted);transition:color .25s}
      .nav-links a:hover{color:var(--ink)}
      .theme{width:36px;height:36px;border:1px solid var(--line);border-radius:50%;background:transparent;display:grid;place-items:center;cursor:pointer;transition:transform .5s var(--ease),background .3s}
      .theme:hover{transform:rotate(35deg);background:var(--panel)}
      .theme svg{width:15px;height:15px}
      .hero{min-height:100svh;min-height:100dvh;display:flex;align-items:center;position:relative;isolation:isolate;padding:calc(var(--nav-h) + 7vh) 0 8vh;overflow:hidden}
      .hero-orb{position:absolute;z-index:-1;width:min(64vw,900px);aspect-ratio:1;border-radius:50%;right:-18%;top:5%;background:radial-gradient(circle at 42% 45%,rgba(195,174,139,.17),rgba(125,130,113,.07) 28%,transparent 67%);filter:blur(12px);transform:translate3d(0,var(--orb-y,0),0);will-change:transform}
      .hero-grid{display:grid;grid-template-columns:1fr auto;align-items:end;gap:40px}
      .hero-overline{color:var(--muted);display:flex;align-items:center;gap:13px;margin-bottom:clamp(28px,5vh,56px)}
      .hero-overline:before{content:"";width:30px;height:1px;background:var(--accent)}
      h1{font-size:clamp(70px,13.8vw,210px);line-height:.76;letter-spacing:-.105em;font-weight:500;margin:0;max-width:1200px}
      h1 span{display:block}
      h1 .second{font-family:var(--serif);font-weight:400;font-style:italic;letter-spacing:-.065em;color:var(--accent);padding-left:clamp(35px,13vw,190px);margin-top:.12em}
      .hero-foot{display:flex;justify-content:space-between;align-items:end;gap:40px;margin-top:clamp(54px,10vh,112px)}
      .intro{max-width:340px;color:var(--muted);font-size:clamp(14px,1.3vw,17px);line-height:1.75;margin:0}
      .intro strong{color:var(--ink);font-weight:500}
      .hero-coord{color:var(--dim);writing-mode:vertical-rl;transform:rotate(180deg);padding-bottom:5px}
      .scroll-word{display:flex;align-items:center;gap:14px;color:var(--muted)}
      .scroll-word i{display:block;width:54px;height:1px;background:var(--line);position:relative;overflow:hidden}
      .scroll-word i:after{content:"";position:absolute;inset:0;background:var(--accent);animation:travel 2s var(--ease) infinite}
      @keyframes travel{from{transform:translateX(-110%)}to{transform:translateX(110%)}}
      .hero-enter{opacity:0;transform:translateY(35px);filter:blur(12px);animation:enter 1.1s var(--ease) forwards}
      .hero-enter.d1{animation-delay:.12s}.hero-enter.d2{animation-delay:.25s}.hero-enter.d3{animation-delay:.4s}
      @keyframes enter{to{opacity:1;transform:translateY(0);filter:blur(0)}}
      .chapter{padding:clamp(100px,15vw,190px) 0;border-top:1px solid var(--line)}
      .chapter-top{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:clamp(38px,7vw,84px);color:var(--muted)}
      .chapter-title{font-size:clamp(38px,7.2vw,100px);line-height:.91;letter-spacing:-.085em;font-weight:500;margin:0;max-width:1050px}
      .chapter-title em{font:italic 400 1.04em/.9 var(--serif);color:var(--accent)}
      .work-intro{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:34px}
      .work-intro p{max-width:280px;color:var(--muted);font-size:13px;line-height:1.7;margin:0}
      .project-list{border-top:1px solid var(--line)}
      .project{--tone:#b7c6ad;position:relative;border-bottom:1px solid var(--line);isolation:isolate}
      .project-trigger{width:100%;padding:clamp(28px,4.2vw,58px) 0;display:grid;grid-template-columns:55px minmax(0,1fr) auto;align-items:center;gap:clamp(14px,3vw,42px);text-align:left;border:0;background:none;cursor:pointer;position:relative;z-index:2}
      .project-index{align-self:start;padding-top:12px;color:var(--dim)}
      .project-name{font-size:clamp(36px,7.4vw,104px);line-height:.9;letter-spacing:-.085em;font-weight:500;transition:transform .65s var(--ease),color .4s}
      .project-trigger:hover .project-name{transform:translateX(12px);color:var(--tone)}
      .project-side{display:flex;flex-direction:column;align-items:flex-end;gap:12px;color:var(--muted);font-size:11px}
      .project-arrow{width:42px;height:42px;border:1px solid var(--line);border-radius:50%;display:grid;place-items:center;font-size:18px;transition:transform .55s var(--ease),background .35s,color .35s}
      .project-trigger:hover .project-arrow{transform:rotate(45deg);background:var(--tone);color:var(--bg)}
      .project-preview{height:0;overflow:hidden;transition:height .8s var(--ease);position:relative}
      .project-preview-inner{height:clamp(190px,30vw,370px);margin:0 0 32px 55px;border:1px solid var(--line);background:radial-gradient(ellipse at 50% 110%,color-mix(in srgb,var(--tone) 22%,transparent),transparent 65%),var(--panel);display:grid;place-items:center;position:relative;overflow:hidden;transform:translateY(20px) scale(.985);opacity:0;filter:blur(10px);transition:transform .8s var(--ease),opacity .7s,filter .7s}
      .project.open .project-preview{height:clamp(220px,34vw,410px)}
      .project.open .project-preview-inner{transform:translateY(0) scale(1);opacity:1;filter:blur(0)}
      .preview-glass{width:min(58%,580px);min-height:140px;padding:clamp(18px,3vw,34px);border:1px solid color-mix(in srgb,var(--tone) 40%,var(--line));background:color-mix(in srgb,var(--bg) 72%,transparent);backdrop-filter:blur(24px);box-shadow:0 30px 100px rgba(0,0,0,.16);transform:perspective(900px) rotateX(7deg) rotateY(-8deg);transition:transform .9s var(--ease)}
      .project.open .preview-glass{transform:perspective(900px) rotateX(0) rotateY(0)}
      .preview-top{display:flex;justify-content:space-between;color:var(--muted);font:9px var(--mono);letter-spacing:.1em;border-bottom:1px solid var(--line);padding-bottom:16px}
      .preview-bottom{display:flex;justify-content:space-between;align-items:end;padding-top:24px;gap:20px}
      .preview-number{font-size:clamp(36px,6vw,72px);letter-spacing:-.08em;line-height:1}
      .preview-caption{font:10px var(--mono);color:var(--muted);text-transform:uppercase}
      .preview-word{font:italic clamp(34px,7vw,84px)/.9 var(--serif);color:var(--tone);text-align:center}
      .project-hint{position:absolute;bottom:14px;left:16px;color:var(--dim)}
      .detail-layer{position:fixed;z-index:60;inset:0;display:grid;place-items:center;padding:clamp(14px,4vw,48px);background:rgba(5,6,5,.55);backdrop-filter:blur(0);opacity:0;visibility:hidden;transition:opacity .45s,visibility .45s,backdrop-filter .55s}
      .detail-layer.visible{opacity:1;visibility:visible;backdrop-filter:blur(22px)}
      .detail-panel{--tone:var(--accent);width:min(900px,100%);max-height:min(86dvh,850px);overflow:auto;background:var(--panel);border:1px solid var(--line);padding:clamp(24px,5vw,64px);position:relative;transform:translateY(35px) scale(.97);filter:blur(10px);transition:transform .65s var(--ease),filter .65s var(--ease);overscroll-behavior:contain}
      .detail-layer.visible .detail-panel{transform:translateY(0) scale(1);filter:blur(0)}
      .detail-close{position:absolute;right:clamp(18px,3vw,34px);top:clamp(18px,3vw,34px);width:42px;height:42px;border:1px solid var(--line);border-radius:50%;background:transparent;cursor:pointer;font-size:20px}
      .detail-meta{display:flex;gap:18px;flex-wrap:wrap;color:var(--muted);padding-right:50px}
      .detail-panel h2{font-size:clamp(44px,9vw,104px);line-height:.88;letter-spacing:-.09em;font-weight:500;margin:clamp(45px,8vw,85px) 0 30px}
      .detail-panel p{font-size:clamp(16px,2vw,20px);line-height:1.75;color:var(--muted);max-width:690px}
      .detail-stack{border-top:1px solid var(--line);padding-top:20px;margin-top:42px;color:var(--tone)}
      .detail-cta{display:inline-flex;align-items:center;gap:12px;margin-top:34px;font-size:13px;border-bottom:1px solid var(--tone);padding-bottom:8px}
      .interlude{padding:clamp(100px,16vw,220px) 0;position:relative;overflow:hidden}
      .interlude:before{content:"";position:absolute;width:50vw;aspect-ratio:1;border-radius:50%;background:radial-gradient(circle,color-mix(in srgb,var(--accent) 12%,transparent),transparent 68%);right:-18%;top:5%;filter:blur(20px);pointer-events:none}
      .interlude-copy{max-width:1050px;font-size:clamp(34px,7vw,94px);line-height:1.02;letter-spacing:-.075em;margin:0;position:relative}
      .interlude-copy span{color:var(--muted)}
      .interlude-copy em{font:italic 400 1.08em var(--serif);color:var(--accent)}
      .facts{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);border:1px solid var(--line);margin-top:clamp(55px,9vw,110px)}
      .fact{background:var(--bg);padding:clamp(20px,3vw,38px);min-height:145px}
      .fact b{display:block;font-size:clamp(28px,4vw,48px);font-weight:500;letter-spacing:-.08em;margin:18px 0 8px}
      .fact span{font-size:11px;color:var(--muted)}
      .signal{display:grid;grid-template-columns:1fr 1.2fr;gap:40px;margin-top:clamp(75px,12vw,140px);padding-top:24px;border-top:1px solid var(--line)}
      .signal-label{color:var(--accent)}
      .signal-list{display:flex;flex-wrap:wrap;gap:12px 22px}
      .signal-list span{font-size:clamp(14px,1.5vw,18px);color:var(--muted);letter-spacing:-.03em}
      .end{padding:clamp(110px,18vw,240px) 0 34px;text-align:center}
      .end .eyebrow{color:var(--muted);margin-bottom:34px}
      .end h2{font-size:clamp(58px,12vw,160px);line-height:.82;letter-spacing:-.1em;font-weight:500;margin:0 auto 54px}
      .end h2 em{font:italic 400 1.02em var(--serif);color:var(--accent)}
      .contact-link{display:inline-flex;align-items:center;gap:18px;padding:16px 22px;border:1px solid var(--line);border-radius:99px;font-size:13px;transition:background .35s,color .35s,transform .35s}
      .contact-link:hover{background:var(--accent);color:var(--bg);transform:translateY(-4px)}
      footer{display:flex;justify-content:space-between;gap:20px;align-items:center;padding:26px 0 calc(26px + env(safe-area-inset-bottom));margin-top:clamp(90px,13vw,160px);border-top:1px solid var(--line);color:var(--muted);font-size:11px}
      .footer-links{display:flex;gap:22px}
      .footer-links a:hover{color:var(--ink)}
      .reveal{opacity:0;transform:translateY(34px);filter:blur(9px);transition:opacity .9s var(--ease),transform .9s var(--ease),filter .9s var(--ease)}
      .reveal.in{opacity:1;transform:translateY(0);filter:blur(0)}
      @media(min-width:1500px){.hero-grid{max-width:1500px}.project-preview-inner{max-width:1100px}}
      @media(max-width:800px){
        :root{--nav-h:68px}
        .hero-grid{grid-template-columns:1fr}
        .hero-coord{display:none}
        .hero-foot{margin-top:70px}
        .chapter-title{max-width:700px}
        .project-trigger{grid-template-columns:34px minmax(0,1fr) auto}
        .project-preview-inner{margin-left:34px}
        .signal{grid-template-columns:1fr;gap:22px}
      }
      @media(max-width:560px){
        :root{--gutter:20px;--nav-h:62px}
        .nav-links{gap:14px}
        .nav-links a{font-size:10px}
        .nav-links a:nth-child(2){display:none}
        .nav-right{gap:14px}
        .hero{padding-top:calc(var(--nav-h) + 5vh);min-height:92svh}
        h1{font-size:clamp(62px,16.5vw,94px)}
        h1 .second{padding-left:9vw}
        .hero-foot{align-items:start;flex-direction:column;gap:30px;margin-top:58px}
        .intro{max-width:310px}
        .scroll-word{align-self:flex-end}
        .chapter{padding:100px 0}
        .chapter-top{margin-bottom:42px}
        .work-intro{align-items:start;flex-direction:column}
        .project-trigger{grid-template-columns:25px minmax(0,1fr) 36px;gap:10px;padding:30px 0}
        .project-name{font-size:clamp(34px,9vw,52px);overflow-wrap:anywhere}
        .project-index{font-size:9px;padding-top:8px}
        .project-side{gap:0}
        .project-side .category{display:none}
        .project-arrow{width:34px;height:34px}
        .project-preview-inner{margin-left:0;height:220px}
        .project.open .project-preview{height:245px}
        .preview-glass{width:82%;min-height:125px;padding:16px}
        .preview-bottom{padding-top:17px}
        .facts{grid-template-columns:1fr}
        .fact{min-height:110px}
        .detail-layer{padding:10px}
        .detail-panel{max-height:90dvh;padding:24px}
        .detail-panel h2{margin-top:65px}
        footer{align-items:flex-start;flex-direction:column}
      }
      @media(max-width:360px){
        .nav-links a:nth-child(3){display:none}
        h1{font-size:59px}
        .project-name{font-size:32px}
        .end h2{font-size:56px}
      }
      @media(hover:none),(pointer:coarse){.project-trigger:hover .project-name{transform:none}.project-trigger:hover .project-arrow{transform:none}.contact-link:hover{transform:none}}
      @media(prefers-reduced-motion:reduce){
        *,*::before,*::after{scroll-behavior:auto!important;animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}
        .hero-enter{opacity:1;transform:none;filter:none}
        .reveal{opacity:1;transform:none;filter:none}
      }
      @supports not (height:100dvh){.hero{min-height:100svh}}
    </style>
  </head>
  <body>
    <div class="grain" aria-hidden="true"></div><div class="ambient" aria-hidden="true"></div>
    <header class="top" id="topbar"><div class="wrap nav">
      <a class="brand" href="#home" aria-label="Vinith home">VRB.</a>
      <div class="nav-right"><nav class="nav-links" aria-label="Main navigation"><a href="#work">Work</a><a href="#about">Perspective</a><a href="#contact">Contact</a></nav>
      <button class="theme" id="themeToggle" aria-label="Switch theme" title="Switch theme"><svg id="themeIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2"/></svg></button></div>
    </div></header>
    <main id="home">
      <section class="hero"><div class="hero-orb" id="orb"></div><div class="wrap">
        <div class="hero-grid"><div>
          <div class="hero-overline mono hero-enter">Software engineer · Hyderabad, India</div>
          <h1 class="hero-enter d1"><span>Vinith Reddy</span><span class="second">Banda.</span></h1>
          <div class="hero-foot hero-enter d2"><p class="intro">I build <strong>digital things with a point of view.</strong> Moving between software systems, native experiences and ideas worth exploring.</p><div class="scroll-word mono"><span>Scroll slowly</span><i></i></div></div>
        </div><div class="hero-coord mono hero-enter d3">17° 23′ N — 78° 29′ E</div></div>
      </div></section>
      <section class="chapter" id="work"><div class="wrap">
        <div class="chapter-top mono reveal"><span>01 — Selected work</span><span>Three things made real</span></div>
        <div class="work-intro reveal"><h2 class="chapter-title">Less, but <em>with intent.</em></h2><p>Open a project. The details unfold here, without sending you somewhere else.</p></div>
        <div class="project-list">
          {projects.map((p) => <article class="project reveal" style={`--tone:${p.accent}`} data-project={p.id}>
            <button class="project-trigger" type="button" aria-expanded="false" aria-label={`Expand ${p.name} project`}>
              <span class="project-index mono">{p.index}</span><span class="project-name">{p.name}</span>
              <span class="project-side"><span class="category">{p.category}</span><span class="project-arrow" aria-hidden="true">↗</span></span>
            </button>
            <div class="project-preview" aria-hidden="true"><div class="project-preview-inner">
              {p.id === "care" ? <div class="preview-glass"><div class="preview-top"><span>CARESCHEDULE / SYSTEM OVERVIEW</span><span>2026</span></div><div class="preview-bottom"><b class="preview-number">148</b><span class="preview-caption">REST APIs<br/>six role-based workflows</span></div></div> : <div class="preview-word">{p.id === "journal" ? "A quieter mind." : "Presence, anywhere."}</div>}
              <span class="project-hint mono">{p.index} / {p.name}</span>
            </div></div>
          </article>)}
        </div>
      </div></section>
      <section class="interlude" id="about"><div class="wrap">
        <div class="chapter-top mono reveal"><span>02 — Perspective</span><span>How I think</span></div>
        <p class="interlude-copy reveal">Good software is not just what it <em>does.</em> <span>It is how quietly, clearly and naturally it lets people do what matters.</span></p>
        <div class="facts reveal">
          <div class="fact"><span class="mono">Education</span><b>8.43</b><span>CGPA · B.E. Information Technology, CBIT · 2026</span></div>
          <div class="fact"><span class="mono">Research</span><b>IEEE</b><span>Published research · I3CTCON 2026</span></div>
          <div class="fact"><span class="mono">Experience</span><b>2026</b><span>.NET Full Stack Intern · Cognizant</span></div>
        </div>
        <div class="signal reveal"><div class="signal-label mono">03 — Things I work with</div><div class="signal-list">{capabilities.map((c)=><span>{c}</span>)}</div></div>
      </div></section>
      <section class="end" id="contact"><div class="wrap">
        <div class="eyebrow mono reveal">A good conversation can start anywhere</div>
        <h2 class="reveal">Have a good<br/><em>problem?</em></h2>
        <a class="contact-link reveal" href="mailto:vinithreddybanda@gmail.com">Let's talk <span>↗</span></a>
        <footer><span>© {new Date().getFullYear()} Vinith Reddy Banda</span><div class="footer-links"><a href="mailto:vinithreddybanda@gmail.com">Email</a><a href="https://github.com/vinithreddybanda" target="_blank" rel="noreferrer">GitHub ↗</a></div><span>Made with intent.</span></footer>
      </div></section>
    </main>
    <div class="detail-layer" id="detailLayer" role="dialog" aria-modal="true" aria-labelledby="detailTitle" aria-hidden="true">
      <div class="detail-panel" id="detailPanel" tabindex="-1"><button class="detail-close" id="detailClose" aria-label="Close project details">×</button><div class="detail-meta mono"><span id="detailIndex"></span><span id="detailCategory"></span><span id="detailYear"></span></div><h2 id="detailTitle"></h2><p id="detailDescription"></p><div class="detail-stack mono" id="detailStack"></div><a class="detail-cta" href="https://github.com/vinithreddybanda" target="_blank" rel="noreferrer">Explore my GitHub <span>↗</span></a></div>
    </div>
    <script>
      const root=document.documentElement, toggle=document.querySelector("#themeToggle"), icon=document.querySelector("#themeIcon"), meta=document.querySelector('meta[name="theme-color"]');
      const saved=localStorage.getItem("portfolio-theme"), preferred=matchMedia("(prefers-color-scheme: light)").matches?"light":"dark";
      function setTheme(theme){root.dataset.theme=theme;const light=theme==="light";meta.content=light?"#e9e9e3":"#10110f";toggle.setAttribute("aria-label",light?"Switch to dark theme":"Switch to light theme");icon.innerHTML=light?'<path d="M20.2 15.1A8.5 8.5 0 0 1 8.9 3.8 8.5 8.5 0 1 0 20.2 15.1Z"/>':'<circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2"/>'}
      setTheme(saved||preferred);toggle.addEventListener("click",()=>{const next=root.dataset.theme==="dark"?"light":"dark";if(document.startViewTransition)document.startViewTransition(()=>setTheme(next));else setTheme(next);localStorage.setItem("portfolio-theme",next)});
      const topbar=document.querySelector("#topbar");let scrollQueued=false;
      function scrollFrame(){const y=window.scrollY;topbar.classList.toggle("scrolled",y>18);const orb=document.querySelector("#orb");if(orb&&matchMedia("(pointer:fine)").matches)orb.style.setProperty("--orb-y",Math.min(y*.12,100)+"px");scrollQueued=false}
      addEventListener("scroll",()=>{if(!scrollQueued){requestAnimationFrame(scrollFrame);scrollQueued=true}},{passive:true});scrollFrame();
      const ambient=document.querySelector(".ambient");if(matchMedia("(pointer:fine)").matches){let pointerQueued=false,px=0,py=0;addEventListener("pointermove",e=>{px=e.clientX/innerWidth*100;py=e.clientY/innerHeight*100;if(!pointerQueued){requestAnimationFrame(()=>{ambient.style.setProperty("--mx",px+"%");ambient.style.setProperty("--my",py+"%");pointerQueued=false});pointerQueued=true}},{passive:true})}
      const observer=new IntersectionObserver(entries=>entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add("in");observer.unobserve(e.target)}}),{threshold:.1,rootMargin:"0px 0px -30px 0px"});
      document.querySelectorAll(".reveal").forEach(el=>observer.observe(el));
      const details={
        {projects.map(p=>JSON.stringify(p.id)+": "+JSON.stringify({index:p.index,category:p.category,year:p.year,name:p.name,detail:p.detail,stack:p.stack,accent:p.accent})).join(",")}
      };
      const layer=document.querySelector("#detailLayer"),panel=document.querySelector("#detailPanel"),close=document.querySelector("#detailClose");let lastTrigger=null;
      function openDetail(id,trigger){const p=details[id];if(!p)return;lastTrigger=trigger;document.querySelector("#detailIndex").textContent=p.index;document.querySelector("#detailCategory").textContent=p.category;document.querySelector("#detailYear").textContent=p.year;document.querySelector("#detailTitle").textContent=p.name;document.querySelector("#detailDescription").textContent=p.detail;document.querySelector("#detailStack").textContent=p.stack;panel.style.setProperty("--tone",p.accent);layer.classList.add("visible");layer.setAttribute("aria-hidden","false");document.body.style.overflow="hidden";setTimeout(()=>panel.focus(),80)}
      function closeDetail(){layer.classList.remove("visible");layer.setAttribute("aria-hidden","true");document.body.style.overflow="";lastTrigger?.focus()}
      document.querySelectorAll(".project").forEach(card=>{const button=card.querySelector("button"),preview=card.querySelector(".project-preview");button.addEventListener("click",()=>{const open=card.classList.toggle("open");button.setAttribute("aria-expanded",String(open));preview.setAttribute("aria-hidden",String(!open));document.querySelectorAll(".project").forEach(other=>{if(other!==card){other.classList.remove("open");other.querySelector("button").setAttribute("aria-expanded","false");other.querySelector(".project-preview").setAttribute("aria-hidden","true")}});if(open)openDetail(card.dataset.project,button)})});
      close.addEventListener("click",closeDetail);layer.addEventListener("click",e=>{if(e.target===layer)closeDetail()});addEventListener("keydown",e=>{if(e.key==="Escape"&&layer.classList.contains("visible"))closeDetail()});
    </script>
  </body>
</html>