---
import NowPlaying from "../components/NowPlaying";
import CommitCanvas from "../components/CommitCanvas";
import "../styles/global.css";

const projects = [
  {
    mark: "S",
    name: "SimpMusic",
    description: "An open-source music player built around YouTube Music. I work on search reliability, playback flows and a more coherent Android experience.",
    meta: "ANDROID · OPEN SOURCE",
    href: "https://github.com/vinithreddybanda/SimpMusic",
    source: "Source",
  },
  {
    mark: "W",
    name: "WhatsApp Status Saver",
    description: "A media-first Android gallery for browsing, saving and sharing WhatsApp statuses, with natural image sizing and fast interactions.",
    meta: "ANDROID · 29 STARS",
    href: "https://github.com/vinithreddybanda/WhatsapStatusSaver",
    source: "Source",
  },
  {
    mark: "S",
    name: "Saturn",
    description: "A Rust-powered Discord bot for cross-server communication, relaying messages and keeping edits, reactions and media in sync.",
    meta: "RUST · DISCORD",
    href: "https://github.com/vinithreddybanda/saturn",
    source: "Source",
  },
  {
    mark: "J",
    name: "Journal AI",
    description: "An AI-assisted journaling project exploring a practical full-stack workflow with Supabase, Groq and a containerized deployment pipeline.",
    meta: "NEXT.JS · AI · DEVOPS",
    href: "https://github.com/vinithreddybanda/journalai",
    source: "Source",
  },
  {
    mark: "L",
    name: "LiveVoiceX",
    description: "A real-time multilingual voice experience built with React, TypeScript and Deepgram speech recognition.",
    meta: "REACT · REAL TIME",
    href: "https://github.com/vinithreddybanda/livevoicex",
    source: "Source",
  },
];
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#080808" />
    <meta name="description" content="Vinith Reddy Banda. Software engineer building Android, web and developer tools, and contributing to open source." />
    <meta property="og:title" content="Vinith Reddy Banda" />
    <meta property="og:description" content="Software engineer building thoughtful software." />
    <meta property="og:type" content="website" />
    <title>Vinith Reddy Banda</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <main class="page" id="top">
      <section class="intro reveal">
        <h1>Vinith Reddy Banda</h1>
        <p class="role">Software Engineer · Hyderabad, India</p>
        <p class="cozy-note">usually building something, or listening to something.</p>

        <div class="intro-copy">
          <p>I look beneath the surface, finding <strong>clarity</strong> in complexity and exploring the space where thoughtful ideas become <strong>tangible solutions.</strong></p>
          <p>For me, <strong>engineering</strong> is not just about making things work. It is about questioning how things can work better, building with <strong>intention</strong>, and caring about the small details that shape the experience.</p>
          <p>I build across Android, web and developer tooling. I enjoy understanding unfamiliar codebases, improving existing software and contributing to projects that people actually use.</p>
          <p class="reach">Based in <strong>Hyderabad, India.</strong> Open to meaningful collaborations and interesting problems. Find me on <a href="https://github.com/vinithreddybanda" target="_blank" rel="noreferrer">GitHub</a> or reach me by <a href="mailto:vinithreddybanda@gmail.com">email</a>.</p>
        </div>
      </section>

      <section class="section commit-section reveal" id="activity">
        <div class="section-title-row">
          <h2 class="editorial-heading">Commit canvas</h2>
          <a class="quiet-link" href="https://github.com/vinithreddybanda" target="_blank" rel="noreferrer">GitHub ↗</a>
        </div>
        <CommitCanvas client:load />
      </section>

      <section class="section reveal" id="updates">
        <div class="section-title-row">
          <h2 class="editorial-heading">Latest updates</h2>
          <a class="quiet-link" href="https://github.com/vinithreddybanda">See all ↗</a>
        </div>
        <div class="updates-list">
          <a class="update-row" href="https://github.com/vinithreddybanda/saturn/pulls" target="_blank" rel="noreferrer">
            <span class="update-mark">S</span>
            <span class="update-copy"><strong>Saturn · Cross-server relay</strong><small>Working on message edits, reactions and inline GIF delivery</small></span>
            <span class="update-date">NOV ’26</span>
          </a>
          <a class="update-row" href="https://github.com/vinithreddybanda/WhatsapStatusSaver" target="_blank" rel="noreferrer">
            <span class="update-mark">W</span>
            <span class="update-copy"><strong>WhatsApp Status Saver</strong><small>Refining the gallery, media presentation and save actions</small></span>
            <span class="update-date">NOV ’26</span>
          </a>
          <a class="update-row" href="https://github.com/vinithreddybanda/SimpMusic" target="_blank" rel="noreferrer">
            <span class="update-mark">S</span>
            <span class="update-copy"><strong>SimpMusic · Search experience</strong><small>Investigating keyboard insets, search flow and stability</small></span>
            <span class="update-date">NOV ’26</span>
          </a>
        </div>
      </section>

      <section class="section reveal" id="listening">
        <h2 class="editorial-heading">What I’ve been playing <em>lately is often random, it just depends.</em></h2>
        <NowPlaying client:load />
      </section>

      <section class="section reveal" id="projects">
        <div class="section-title-row">
          <h2 class="editorial-heading">Selected projects</h2>
          <a class="quiet-link" href="https://github.com/vinithreddybanda?tab=repositories" target="_blank" rel="noreferrer">See all ↗</a>
        </div>
        <div class="projects-list">
          {projects.map((project) => (
            <article class="project-item">
              <div class="project-heading">
                <span class="project-icon">{project.mark}</span>
                <div class="project-name-wrap">
                  <h3><a href={project.href} target="_blank" rel="noreferrer">{project.name}</a></h3>
                  <span class="project-meta">{project.meta}</span>
                </div>
                <a class="source-link" href={project.href} target="_blank" rel="noreferrer">{project.source} ↗</a>
              </div>
              <p>{project.description}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="section reveal" id="experience">
        <h2 class="editorial-heading">Work experience</h2>
        <div class="timeline-list">
          <article class="timeline-item">
            <div class="timeline-mark">C</div>
            <div class="timeline-content">
              <div class="timeline-topline"><h3>Cognizant</h3><span class="timeline-tag">EXPERIENCE</span></div>
              <p class="timeline-role">Internship → Full-time</p>
              <div class="career-steps">
                <div><span class="career-dot"></span><p><strong>Programmer Analyst (PA)</strong><small>Full-time · Cognizant Technology Solutions</small></p></div>
                <div><span class="career-dot"></span><p><strong>Software Developer</strong><small>Role progression</small></p></div>
              </div>
              <p class="timeline-description">Started with an internship at Cognizant and continued as a full-time employee.</p>
            </div>
          </article>
        </div>
      </section>

      <section class="section reveal" id="education">
        <h2 class="editorial-heading">Education</h2>
        <div class="education-grid">
          <article class="education-card">
            <a class="education-photo-link" href="https://share.google/SfiXB3khshqV682cG" target="_blank" rel="noreferrer" aria-label="View CBIT image reference">
              <img class="education-photo" src="https://share.google/SfiXB3khshqV682cG" alt="Chaitanya Bharati Institute of Technology campus" loading="lazy" />
            </a>
            <div class="education-copy">
              <h3>Chaitanya Bharati Institute of Technology</h3>
              <p class="timeline-role">B.E. · Information Technology</p>
              <p class="timeline-description">Hyderabad · CGPA 8.43</p>
            </div>
          </article>
          <article class="education-card">
            <a class="education-photo-link" href="https://gptwgl.dte.telangana.gov.in/filePreview?fileName=CMS%2FImg_1761571554904.jpeg" target="_blank" rel="noreferrer" aria-label="View Government Polytechnic College image">
              <img class="education-photo" src="https://gptwgl.dte.telangana.gov.in/filePreview?fileName=CMS%2FImg_1761571554904.jpeg" alt="Government Polytechnic College, Warangal" loading="lazy" />
            </a>
            <div class="education-copy">
              <h3>Government Polytechnic College, Warangal</h3>
              <p class="timeline-role">Diploma · Computer Engineering</p>
              <p class="timeline-description">Warangal · CGPA 9.74</p>
            </div>
          </article>
        </div>
      </section>

      <footer class="site-footer reveal" id="contact">
        <div class="footer-intro">
          <h2>Vinith Reddy Banda</h2>
          <p>I share what I’m building and learning. Hopefully it’s useful to you.</p>
          <div class="footer-socials">
            <a href="https://github.com/vinithreddybanda" aria-label="GitHub" target="_blank" rel="noreferrer">GitHub ↗</a>
            <a href="mailto:vinithreddybanda@gmail.com">Email ↗</a>
          </div>
        </div>
        <div class="footer-links">
          <div><h3>General</h3><a href="#top">Home</a><a href="#updates">Latest updates</a><a href="#projects">Projects</a><a href="#experience">Experience</a><a href="#education">Education</a></div>
          <div><h3>The website</h3><a href="#listening">Listening</a><a href="https://github.com/vinithreddybanda?tab=repositories" target="_blank" rel="noreferrer">Repositories ↗</a><a href="mailto:vinithreddybanda@gmail.com">Contact ↗</a></div>
        </div>
        <div class="footer-bottom"><span>© {new Date().getFullYear()} Vinith Reddy Banda.</span><a href="#top">Back to top ↑</a></div>
      </footer>
    </main>

    <div class="dock" aria-label="Quick controls">
      <a class="dock-button brand-button" href="#top" aria-label="Back to home">
        <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M5 25 14.8 6.5h3.1L27 25h-4.2l-6.5-12.7L9.1 25H5Z" fill="currentColor"/><path d="m12.1 25 4.2-8 4.1 8h-3.8l-.4-.9h-1.1l-.5.9h-2.5Z" fill="currentColor"/></svg>
      </a>
      <button class="dock-button theme-button" id="theme-toggle" aria-label="Switch color theme">
        <svg class="moon-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.2 15.4A8.5 8.5 0 0 1 8.6 3.8 8.6 8.6 0 1 0 20.2 15.4Z"/></svg>
        <svg class="sun-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/></svg>
      </button>
      <button class="dock-button menu-button" id="menu-toggle" aria-label="Open navigation" aria-expanded="false">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>

    <div class="menu-backdrop" id="menu-backdrop" hidden>
      <div class="menu-sheet" role="dialog" aria-modal="true" aria-label="Navigation">
        <div class="sheet-handle"></div>
        <div class="menu-group"><h3>Navigation</h3>
          <a href="#top"><span class="menu-icon">⌂</span>Home<span class="menu-chevron">›</span></a>
          <a href="#updates"><span class="menu-icon">▤</span>Latest updates<span class="menu-chevron">›</span></a>
          <a href="#projects"><span class="menu-icon">⌘</span>Projects<span class="menu-chevron">›</span></a>
          <a href="#experience"><span class="menu-icon">▣</span>Experience<span class="menu-chevron">›</span></a>
          <a href="#education"><span class="menu-icon">⌂</span>Education<span class="menu-chevron">›</span></a>
        </div>
        <div class="menu-group"><h3>Elsewhere</h3>
          <a href="https://github.com/vinithreddybanda" target="_blank" rel="noreferrer"><span class="menu-icon">◉</span>GitHub<span class="menu-external">↗</span></a>
          <a href="mailto:vinithreddybanda@gmail.com"><span class="menu-icon">✉</span>Email<span class="menu-external">↗</span></a>
        </div>
      </div>
    </div>

    <script>
      const root = document.documentElement;
      const themeButton = document.getElementById("theme-toggle")!;
      const menuButton = document.getElementById("menu-toggle")!;
      const backdrop = document.getElementById("menu-backdrop")!;
      const metaTheme = document.querySelector('meta[name="theme-color"]');

      const applyTheme = (theme: "light" | "dark") => {
        root.dataset.theme = theme;
        metaTheme?.setAttribute("content", theme === "dark" ? "#080808" : "#ffffff");
        localStorage.setItem("vinith-theme", theme);
      };

      const savedTheme = localStorage.getItem("vinith-theme");
      if (savedTheme === "light" || savedTheme === "dark") applyTheme(savedTheme);

      themeButton?.addEventListener("click", () => {
        applyTheme(root.dataset.theme === "dark" ? "light" : "dark");
      });

      const closeMenu = () => {
        backdrop.hidden = true;
        menuButton?.setAttribute("aria-expanded", "false");
        document.body.classList.remove("menu-open");
      };
      const openMenu = () => {
        backdrop.hidden = false;
        menuButton?.setAttribute("aria-expanded", "true");
        document.body.classList.add("menu-open");
      };

      menuButton?.addEventListener("click", () => {
        if (backdrop.hidden) openMenu();
        else closeMenu();
      });
      backdrop?.addEventListener("click", (event) => {
        if (event.target === backdrop) closeMenu();
      });
      backdrop?.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMenu));
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") closeMenu();
      });

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.08 });
      document.querySelectorAll(".reveal").forEach((item) => observer.observe(item));
    </script>
  </body>
</html>
