---
import BaseLayout from "@layouts/BaseLayout.astro";
import ExperienceEntry from "@components/ExperienceEntry.astro";
import { profile, projects, experience, skills, education, recognition } from "@data/portfolio";
---
<BaseLayout>
  <section class="hero section-wrap" id="top">
    <div class="hero-copy">
      <p class="overline"><span class="status-dot"></span> SOFTWARE DEVELOPER · INDIA</p>
      <h1>Thoughtful<br />software, <em>made</em><br />with purpose.</h1>
      <p class="hero-description">I’m {profile.name}. I build across backend systems, Android, and AI, turning complex problems into useful, dependable products.</p>
      <div class="hero-actions"><a class="button button-dark" href="#work">Explore my work <span>↗</span></a><a class="text-link" href="#contact">Get in touch</a></div>
    </div>
    <div class="hero-art" aria-label="Abstract gradient artwork"><div class="art-glow"></div><div class="art-disc"></div><div class="art-orbit"></div><span class="art-monogram">VB</span><span class="art-caption">DESIGNING · BUILDING · LEARNING</span></div>
    <a class="scroll-cue" href="#work" aria-label="Scroll to selected work"><span></span> SCROLL TO EXPLORE</a>
  </section>
  <section class="work-section section-wrap" id="work">
    <div class="section-heading"><div><p class="overline">SELECTED WORK</p><h2>Built with <em>intent.</em></h2></div><p>A selection of projects across AI, Android, and open source.</p></div>
    <div class="project-list">{projects.map((project, index) => <article class:list={["project-panel", `project-${project.visual}`]} data-reveal>
      <div class="project-copy"><span class="project-index">0{index + 1} / 0{projects.length}</span><p class="project-type">{project.type}</p><h3>{project.name}</h3><p class="project-description">{project.description}</p><div class="project-stack">{project.stack.slice(0, 5).map((item) => <span>{item}</span>)}</div><a class="project-link" href={project.link} target="_blank" rel="noopener noreferrer">{project.linkLabel} <span>↗</span></a></div>
      <div class="project-art" aria-hidden="true"><div class="project-art-shape"></div><span class="project-art-name">{project.visual === "journal" ? "journal" : project.visual === "discord" ? "connect" : "offline"}</span><span class="project-art-symbol">{index === 0 ? "✳" : index === 1 ? "◌" : "↗"}</span></div>
    </article>)}</div>
  </section>
  <section class="experience-section section-wrap" id="experience">
    <div class="section-heading"><div><p class="overline">EXPERIENCE</p><h2>Learning through <em>doing.</em></h2></div><p>Working with real teams, real constraints, and real users.</p></div>
    <div class="experience-list">{experience.map((item) => <ExperienceEntry item={item} />)}</div>
  </section>
  <section class="skills-section section-wrap" id="skills">
    <div class="section-heading"><div><p class="overline">TECHNICAL SKILLS</p><h2>My <em>toolkit.</em></h2></div><p>Tools I use to design, build, ship, and maintain software.</p></div>
    <div class="skills-list">{skills.map((group) => <div class="skill-group" data-reveal><h3>{group.title}</h3><div>{group.items.map((item) => <span>{item}</span>)}</div></div>)}</div>
  </section>
  <section class="about-section section-wrap" id="about">
    <div class="section-heading"><div><p class="overline">A LITTLE BACKGROUND</p><h2>Beyond the <em>code.</em></h2></div><p>Education, research, and a few milestones along the way.</p></div>
    <div class="about-columns">
      <div class="about-block"><h3>EDUCATION</h3>{education.map((item) => <article class="about-entry" data-reveal><span>{item.period}</span><div><h4>{item.institution}</h4><p>{item.qualification}</p></div><strong>{item.result}</strong></article>)}</div>
      <div class="about-block"><h3>RECOGNITION & MORE</h3>{recognition.map((item) => <article class="recognition-entry" data-reveal><div><h4>{item.title}</h4><p>{item.description}</p></div>{item.link && <a href={item.link} target="_blank" rel="noopener noreferrer" aria-label="Read details">↗</a>}</article>)}</div>
    </div>
  </section>
  <script>import "../scripts/motion";</script>
</BaseLayout>
