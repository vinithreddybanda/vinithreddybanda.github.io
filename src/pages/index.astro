---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/projects";
import { skillGroups } from "../data/skills";
---
<BaseLayout>
  <section class="home-hero page-wrap" id="top">
    <div class="home-hero__eyebrow"><span class="eyebrow">Software engineer</span><span class="eyebrow home-hero__location">Hyderabad, India · 17°N 78°E</span></div>
    <div class="home-hero__title" data-reveal>
      <p class="home-hero__pretitle">Independent in thought.<br />Practical in execution.</p>
      <h1>Vinith Reddy<br /><em>Banda.</em></h1>
    </div>
    <div class="home-hero__bottom">
      <p class="home-hero__intro">I build <strong>useful software</strong> across backend systems, web interfaces, Android and applied AI. Interested in the engineering beneath the interface and the details that make it feel right.</p>
      <a class="text-link" href="/work/">Explore selected work <span>↗</span></a>
    </div>
    <div class="hero-index"><span>PORTFOLIO / 2026</span><span>SCROLL TO EXPLORE ↓</span></div>
  </section>

  <section class="section-block page-wrap" aria-labelledby="selected-work">
    <SectionHeading eyebrow="Selected projects" title="Built with" accent="intent." note="A selection of products, experiments and engineering work." number="01" />
    <div class="project-grid">
      {projects.slice(0, 3).map((project, index) => <ProjectCard project={project} featured={index === 0} />)}
    </div>
    <div class="section-action"><span class="eyebrow">04 projects / and counting</span><a class="text-link" href="/work/">View all work <span>↗</span></a></div>
  </section>

  <section class="section-block page-wrap about-preview">
    <SectionHeading eyebrow="A little context" title="Curious by" accent="nature." note="The short version: understand the problem, choose the right tools, then make the details count." number="02" />
    <div class="about-preview__grid">
      <p class="display-copy">I like understanding how things work, then making them work <em>better.</em></p>
      <div class="about-preview__aside">
        <p>My work moves between backend architecture, frontend experiences and native Android. I care about clear systems, useful interfaces and software that performs well beyond the demo.</p>
        <a class="text-link" href="/about/">More about me <span>↗</span></a>
      </div>
    </div>
  </section>

  <section class="section-block page-wrap capabilities">
    <SectionHeading eyebrow="Tools & technologies" title="The working" accent="toolkit." number="03" />
    <div class="capability-grid">
      {skillGroups.map((group, index) => <div class="capability-group"><span class="eyebrow">0{index + 1} / {group.title}</span><div class="tag-list tag-list--large">{group.items.map((item) => <span>{item}</span>)}</div></div>)}
    </div>
  </section>

  <section class="closing-cta page-wrap">
    <span class="eyebrow">Have a good problem?</span>
    <div class="closing-cta__row"><h2>Let's make<br /><em>something matter.</em></h2><a class="round-link" href="/contact/" aria-label="Get in touch">↗</a></div>
  </section>
</BaseLayout>
