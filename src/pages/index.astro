---
const projects = [
  {
    number: "01",
    name: "CareSchedule",
    type: "Healthcare platform",
    year: "2026",
    summary: "A clinic operations platform built around the realities of scheduling care.",
    description: "Developed during my Cognizant .NET training. The system uses six-layer Clean Architecture, 148 REST APIs and role-based workflows. Its appointment engine considers provider availability, leave, holidays and resource constraints before offering a slot.",
    stack: [".NET", "ASP.NET Core", "React", "Entity Framework Core", "SQL Server"],
    link: null,
    linkLabel: "Case study"
  },
  {
    number: "02",
    name: "JournalAI",
    type: "AI · Full stack · DevOps",
    year: "2025",
    summary: "A private journaling space that turns reflection into useful patterns.",
    description: "A full-stack journaling application with AI-assisted insights. The project explores Supabase-backed data, containerization, CI/CD, Kubernetes orchestration and Azure deployment.",
    stack: ["Next.js", "TypeScript", "Supabase", "Groq", "Docker", "Kubernetes", "Azure"],
    link: "https://github.com/vinithreddybanda/journalai",
    linkLabel: "View repository"
  },
  {
    number: "03",
    name: "WhatsApp Status Saver",
    type: "Android · Kotlin",
    year: "2026",
    summary: "A native Android gallery for viewing, saving and sharing status media.",
    description: "A privacy-focused Android app that works locally on-device. Built with Kotlin and Jetpack Compose, with progressive media loading and a Pinterest-inspired gallery experience.",
    stack: ["Kotlin", "Jetpack Compose", "Android", "MediaStore"],
    link: "https://github.com/vinithreddybanda/WhatsapStatusSaver",
    linkLabel: "View repository"
  },
  {
    number: "04",
    name: "LiveVoiceX",
    type: "Applied AI · Voice",
    year: "2025",
    summary: "Real-time voice transcription designed for multilingual conversations.",
    description: "An in-progress voice transcription experience built around live speech recognition and multilingual support.",
    stack: ["React", "TypeScript", "Deepgram"],
    link: "https://github.com/vinithreddybanda/livevoicex",
    linkLabel: "View repository"
  }
];

const skills = [
  { group: "Backend engineering", items: ["C#", ".NET", "ASP.NET Core", "Entity Framework Core", "REST APIs"] },
  { group: "Interfaces", items: ["TypeScript", "React", "Next.js", "Angular"] },
  { group: "Mobile & systems", items: ["Kotlin", "Android", "Java", "C++", "JNI"] },
  { group: "Data & delivery", items: ["SQL Server", "PostgreSQL", "Supabase", "Docker", "Azure", "CI/CD"] }
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#11110f" />
    <meta name="description" content="Vinith Reddy Banda is a software engineer working across full-stack development, Android and applied AI." />
    <meta property="og:title" content="Vinith Reddy Banda · Software Engineer" />
    <meta property="og:description" content="Engineering thoughtful software across systems, interfaces and applied AI." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://vinithreddybanda.github.io/" />
    <title>Vinith Reddy Banda · Software Engineer</title>
    <style>
      :root {
        color-scheme: dark;
        --bg: #11110f;
        --surface: #191916;
        --ink: #f0efe9;
        --muted: #a09f97;
        --quiet: #77766f;
        --line: rgba(240,239,233,.16);
        --soft-line: rgba(240,239,233,.09);
        --accent: #c9d2b8;
        --gutter: clamp(22px, 6vw, 92px);
        --sans: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "Helvetica Neue", Inter, ui-sans-serif, system-ui, sans-serif;
        --serif: "Iowan Old Style", "Baskerville", "Palatino Linotype", Georgia, serif;
        --mono: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
        --ease: cubic-bezier(.2,.75,.25,1);
      }
      :root[data-theme="light"] {
        color-scheme: light;
        --bg: #f3f2ed;
        --surface: #e9e8e1;
        --ink: #171714;
        --muted: #5f5f58;
        --quiet: #85847b;
        --line: rgba(23,23,20,.19);
        --soft-line: rgba(23,23,20,.1);
        --accent: #53634a;
      }
      *,*::before,*::after{box-sizing:border-box}
      html{background:var(--bg);scroll-behavior:smooth;scroll-padding-top:92px}
      body{margin:0;min-width:320px;background:var(--bg);color:var(--ink);font-family:var(--sans);-webkit-font-smoothing:antialiased;overflow-x:hidden;transition:background .3s,color .3s}
      ::selection{background:var(--accent);color:var(--bg)}
      a{color:inherit;text-decoration:none}
      button{font:inherit}
      a:focus-visible,button:focus-visible,summary:focus-visible{outline:2px solid var(--accent);outline-offset:5px}
      .shell{width:100%;max-width:1600px;margin-inline:auto;padding-inline:var(--gutter)}
      .mono{font:10px/1.55 var(--mono);letter-spacing:.075em;text-transform:uppercase}
      .muted{color:var(--muted)}
      .skip{position:absolute;z-index:100;top:10px;left:10px;padding:12px 16px;background:var(--ink);color:var(--bg);transform:translateY(-150%)}
      .skip:focus{transform:none}
      .header{position:fixed;z-index:50;inset:0 0 auto;height:72px;border-bottom:1px solid transparent;transition:background .3s,border-color .3s,backdrop-filter .3s}
      .header.scrolled{background:color-mix(in srgb,var(--bg) 84%,transparent);border-color:var(--soft-line);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px)}
      .nav{height:100%;display:flex;align-items:center;justify-content:space-between;gap:20px}
      .wordmark{font-size:15px;font-weight:650;letter-spacing:-.07em;white-space:nowrap}
      .nav-links{display:flex;align-items:center;gap:clamp(17px,3vw,42px)}
      .nav-links a,.theme-toggle{font:10px var(--mono);letter-spacing:.055em;text-transform:uppercase;color:var(--muted);transition:color .2s}
      .nav-links a:hover,.theme-toggle:hover{color:var(--ink)}
      .nav-actions{display:flex;align-items:center;gap:clamp(16px,2.5vw,34px)}
      .theme-toggle{padding:8px 0;border:0;background:none;cursor:pointer}
      .hero{min-height:min(900px,100svh);min-height:max(700px,100svh);display:flex;align-items:flex-end;padding-top:150px;padding-bottom:clamp(48px,7vw,96px)}
      .hero-inner{width:100%}
      .hero-top{display:flex;justify-content:space-between;gap:20px;margin-bottom:clamp(65px,12vh,145px);color:var(--muted)}
      .hero-top span:last-child{text-align:right}
      .eyebrow{display:flex;align-items:center;gap:12px;color:var(--muted)}
      .eyebrow::before{content:"";width:24px;height:1px;background:var(--accent)}
      h1{max-width:1200px;margin:0;font-size:clamp(68px,12.5vw,190px);font-weight:570;line-height:.83;letter-spacing:-.105em}
      h1 span{display:block}
      h1 .serif{font-family:var(--serif);font-weight:400;font-style:italic;letter-spacing:-.09em}
      .hero-bottom{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:end;gap:36px;margin-top:clamp(60px,10vh,120px)}
      .hero-copy{max-width:470px;margin:0;color:var(--muted);font-size:clamp(16px,1.65vw,21px);line-height:1.65;letter-spacing:-.035em}
      .hero-copy strong{color:var(--ink);font-weight:500}
      .hero-side{display:flex;gap:clamp(24px,5vw,72px)}
      .hero-side p{margin:8px 0 0;font-size:12px;color:var(--ink)}
      .section{padding-block:clamp(92px,12vw,160px)}
      .section-intro{display:grid;grid-template-columns:1fr minmax(0,2fr) minmax(180px,.8fr);align-items:end;gap:28px;margin:0 0 clamp(55px,8vw,100px)}
      .section-kicker{color:var(--muted)}
      .section-intro h2{grid-column:2;margin:0;font-size:clamp(54px,8.5vw,118px);font-weight:520;line-height:.88;letter-spacing:-.09em}
      .section-intro h2 em{font-family:var(--serif);font-weight:400}
      .section-intro>p{margin:0;color:var(--muted);font-size:13px;line-height:1.8}
      .project-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:clamp(28px,6vw,90px);row-gap:clamp(58px,8vw,110px)}
      .project{min-width:0;padding:0}
      .project:nth-child(1){grid-column:1/-1;max-width:1120px}
      .project-main{min-width:0}
      .project-type{display:block;margin-bottom:20px;color:var(--muted)}
      .project-year{color:var(--quiet)}
      .project-name{margin:0;font-size:clamp(38px,5.6vw,76px);font-weight:520;line-height:.94;letter-spacing:-.085em;overflow-wrap:anywhere}
      .project:nth-child(1) .project-name{font-size:clamp(54px,8.5vw,116px)}
      .project-summary{max-width:590px;margin:17px 0 0;color:var(--ink);font-size:clamp(15px,1.5vw,19px);line-height:1.65;letter-spacing:-.025em}
      .project-description{max-width:650px;margin:13px 0 0;color:var(--muted);font-size:13px;line-height:1.85}
      .project-bottom{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-top:25px}
      .project-stack{display:flex;flex-wrap:wrap;gap:7px 17px;max-width:560px}
      .project-stack span{color:var(--quiet);font:9px var(--mono);letter-spacing:.025em}
      .project-link{display:inline-flex;align-items:center;gap:9px;padding-bottom:5px;border-bottom:1px solid var(--line);font:9px var(--mono);letter-spacing:.045em;text-transform:uppercase;white-space:nowrap;transition:gap .25s,border-color .25s}
      .project-link:hover{gap:15px;border-color:var(--ink)}
      .project-link span{font-size:14px}
      .about-lead{max-width:1000px;margin:clamp(48px,7vw,82px) 0 0;font-size:clamp(36px,6.6vw,88px);font-weight:500;line-height:1.04;letter-spacing:-.075em}
      .about-lead em{font-family:var(--serif);font-weight:400;letter-spacing:-.065em}
      .about-grid{display:grid;grid-template-columns:minmax(180px,.65fr) minmax(0,1.35fr);gap:clamp(40px,9vw,125px);margin-top:clamp(58px,8vw,105px)}
      .about-note{max-width:370px;margin:0;color:var(--muted);font-size:14px;line-height:1.95}
      .facts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:30px 46px}
      .fact{min-width:0;padding:0}
      .fact h3{margin:0 0 10px;color:var(--quiet);font:9px var(--mono);letter-spacing:.08em;text-transform:uppercase}
      .fact p{margin:0;color:var(--ink);font-size:13px;line-height:1.85}
      .fact .sub{color:var(--muted)}
      .skills{display:grid;grid-template-columns:minmax(180px,.65fr) minmax(0,1.35fr);gap:clamp(40px,9vw,125px);margin-top:clamp(75px,10vw,130px);padding:0;border:0}
      .skills-heading h3{max-width:280px;margin:18px 0 0;font-size:clamp(28px,3.7vw,46px);font-weight:500;line-height:1;letter-spacing:-.07em}
      .skills-heading h3 em{font-family:var(--serif);font-weight:400}
      .skill-groups{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:34px 44px}
      .skill-group h4{margin:0 0 14px;color:var(--muted);font:10px var(--mono);letter-spacing:.035em}
      .skill-items{display:flex;flex-wrap:wrap;gap:8px 18px}
      .skill-items span{color:var(--ink);font-size:14px;line-height:1.55;letter-spacing:-.02em}
      .contact{padding-top:clamp(100px,15vw,210px);padding-bottom:28px}
      .contact-title{margin:clamp(55px,8vw,100px) 0;font-size:clamp(62px,11.5vw,160px);font-weight:520;line-height:.88;letter-spacing:-.1em}
      .contact-title em{font-family:var(--serif);font-weight:400;letter-spacing:-.075em}
      .contact-bottom{display:flex;justify-content:space-between;align-items:end;gap:28px;padding-bottom:clamp(75px,11vw,145px)}
      .contact-bottom p{margin:0;color:var(--muted);font-size:13px;line-height:1.9}
      .mail{display:inline-flex;align-items:center;gap:18px;padding-bottom:10px;border-bottom:1px solid var(--ink);font-size:clamp(16px,1.6vw,20px);transition:gap .25s}
      .mail:hover{gap:27px}
      .mail span{font-size:19px}
      footer{display:flex;justify-content:space-between;gap:20px;padding-top:18px;border-top:1px solid var(--line);color:var(--muted)}
      .footer-links{display:flex;gap:24px}
      .footer-links a:hover{color:var(--ink)}
      .reveal{opacity:1;transform:none}
      .js .reveal{opacity:0;transform:translateY(18px);transition:opacity .7s var(--ease),transform .7s var(--ease)}
      .js .reveal.visible{opacity:1;transform:none}
      @media(max-width:760px){
        .header{height:64px}
        .hero{min-height:850px;min-height:100svh;padding-top:120px}
        h1{font-size:clamp(65px,13.8vw,105px)}
        .hero-bottom{grid-template-columns:1fr;gap:30px;margin-top:62px}
        .hero-side{justify-content:flex-start}
        .section-intro{grid-template-columns:1fr;gap:18px}
        .section-intro h2{grid-column:auto;font-size:clamp(54px,12vw,82px)}
        .section-intro>p{max-width:370px}
        .project-list{grid-template-columns:1fr;row-gap:58px}
        .project:nth-child(1){grid-column:auto}
        .project:nth-child(1) .project-name{font-size:clamp(48px,12vw,76px)}
        .project-name{font-size:clamp(40px,10vw,60px)}
        .project-bottom{align-items:flex-start;flex-direction:column;gap:16px}
        .about-grid,.skills{grid-template-columns:1fr;gap:34px}
        .about-note{max-width:520px}
        .skills-heading h3{max-width:none}
        .contact-title{font-size:clamp(68px,14vw,112px)}
      }
      @media(max-width:480px){
        :root{--gutter:21px}
        .nav-links{gap:15px}
        .nav-links a{font-size:9px}
        .nav-actions{gap:14px}
        .theme-toggle{font-size:9px}
        .hero{min-height:820px;min-height:100svh;padding-bottom:38px}
        .hero-top{margin-bottom:65px;font-size:8px}
        .hero-top span:last-child{max-width:110px}
        h1{font-size:clamp(54px,13.8vw,72px)}
        .hero-side{gap:30px}
        .hero-side p{font-size:11px}
        .section{padding-block:90px}
        .section-intro h2{font-size:clamp(52px,13vw,68px)}
        .project-name{font-size:clamp(39px,10.5vw,48px)}
        .project-summary{margin-top:14px;font-size:14px}
        .project-type{font-size:8px}
        .project-stack{gap:7px 13px}
        .facts{gap:25px 20px}
        .fact p{font-size:12px}
        .skill-groups{gap:26px 20px}
        .skill-items{gap:7px 14px}
        .skill-items span{font-size:13px}
        .contact-title{font-size:clamp(60px,15vw,78px)}
        .contact-bottom{align-items:flex-start;flex-direction:column;gap:28px}
        footer{flex-direction:column;font-size:9px}
      }
      @media(max-width:350px){
        .nav-links{gap:10px}
        .nav-links a{font-size:8px}
        .theme-toggle{font-size:8px}
        h1{font-size:51px}
        .project-name{font-size:36px}
      }
      @media(hover:none),(pointer:coarse){.mail:hover{gap:18px}.project-link:hover{gap:10px}}
      @media(prefers-reduced-motion:reduce){
        *,*::before,*::after{scroll-behavior:auto!important;animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}
        .js .reveal{opacity:1;transform:none}
      }

      /* Monochrome glass system */
      :root{
        --bg:#090909;--surface:rgba(255,255,255,.055);--ink:#f5f5f5;
        --muted:#a3a3a3;--quiet:#707070;--line:rgba(255,255,255,.14);
        --soft-line:rgba(255,255,255,.075);--accent:#fff;
        --glass:rgba(255,255,255,.065);--glass-edge:rgba(255,255,255,.16);
      }
      :root[data-theme="light"]{
        --bg:#f2f2f2;--surface:rgba(0,0,0,.045);--ink:#101010;
        --muted:#5f5f5f;--quiet:#858585;--line:rgba(0,0,0,.15);
        --soft-line:rgba(0,0,0,.07);--accent:#111;
        --glass:rgba(255,255,255,.62);--glass-edge:rgba(255,255,255,.85);
      }
      html{scroll-padding-top:100px}
      body{
        background:
          radial-gradient(ellipse at 78% 12%,rgba(255,255,255,.075),transparent 34rem),
          radial-gradient(ellipse at 8% 48%,rgba(255,255,255,.035),transparent 38rem),
          var(--bg);
      }
      :root[data-theme="light"] body{
        background:
          radial-gradient(ellipse at 78% 12%,rgba(255,255,255,.95),transparent 34rem),
          radial-gradient(ellipse at 8% 48%,rgba(0,0,0,.035),transparent 38rem),
          var(--bg);
      }
      .header{height:78px;border:0;pointer-events:none}
      .nav{
        width:calc(100% - 2 * var(--gutter));max-width:1440px;height:52px;margin:13px auto 0;
        padding:0 18px 0 21px;border:1px solid var(--glass-edge);border-radius:999px;
        background:rgba(22,22,22,.48);backdrop-filter:blur(26px) saturate(130%);
        -webkit-backdrop-filter:blur(26px) saturate(130%);
        box-shadow:0 12px 40px rgba(0,0,0,.12);pointer-events:auto;
        transition:background .35s,border-color .35s,transform .35s;
      }
      :root[data-theme="light"] .nav{background:rgba(255,255,255,.62);box-shadow:0 12px 40px rgba(0,0,0,.045)}
      .header.scrolled .nav{transform:scale(.985);background:rgba(22,22,22,.72)}
      :root[data-theme="light"] .header.scrolled .nav{background:rgba(255,255,255,.82)}
      .wordmark{font-size:14px;letter-spacing:-.065em}
      .nav-links{gap:clamp(17px,2.8vw,34px)}
      .nav-links a,.theme-toggle{font-family:var(--sans);font-size:11px;letter-spacing:-.015em;text-transform:none;color:var(--muted)}
      .theme-toggle{padding:7px 12px;border:1px solid var(--line);border-radius:999px}
      .hero{min-height:100svh;position:relative;align-items:center;padding-top:160px;padding-bottom:78px}
      .hero-inner{position:relative;z-index:1}
      .hero-top{margin-bottom:clamp(55px,9vh,100px)}
      .eyebrow{gap:10px}
      .eyebrow::before{width:7px;height:7px;border-radius:50%;background:var(--ink);box-shadow:0 0 18px rgba(255,255,255,.6)}
      h1{font-size:clamp(76px,13.2vw,194px);line-height:.79;letter-spacing:-.115em}
      h1 .serif{font-family:var(--serif);font-style:italic;font-weight:400}
      .hero-bottom{margin-top:clamp(52px,9vh,100px)}
      .hero-copy{max-width:520px;font-size:clamp(16px,1.55vw,20px);line-height:1.55}
      .hero-side{padding:17px 20px;border:1px solid var(--glass-edge);border-radius:18px;background:var(--glass);backdrop-filter:blur(22px);-webkit-backdrop-filter:blur(22px)}
      .hero-side p{font-size:12px}
      .section{padding-block:clamp(100px,13vw,175px)}
      .section-intro{grid-template-columns:minmax(110px,.55fr) minmax(0,2fr) minmax(160px,.8fr);gap:24px;margin-bottom:clamp(48px,7vw,84px)}
      .section-intro h2{font-size:clamp(58px,8vw,112px);letter-spacing:-.105em}
      .section-intro>p{font-size:13px}
      .project-list{gap:18px;align-items:stretch}
      .project{
        position:relative;overflow:hidden;padding:clamp(24px,3.4vw,46px);
        border:1px solid var(--glass-edge);border-radius:24px;
        background:linear-gradient(145deg,rgba(255,255,255,.075),rgba(255,255,255,.018) 58%,rgba(255,255,255,.035));
        backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);
        transition:transform .55s var(--ease),background .45s,border-color .45s;
      }
      :root[data-theme="light"] .project{background:linear-gradient(145deg,rgba(255,255,255,.9),rgba(255,255,255,.36))}
      .project::after{content:"";position:absolute;inset:0;pointer-events:none;opacity:0;background:radial-gradient(500px circle at var(--mx,50%) var(--my,50%),rgba(255,255,255,.1),transparent 55%);transition:opacity .4s}
      .project:hover{transform:translateY(-5px);border-color:rgba(255,255,255,.3)}
      .project:hover::after{opacity:1}
      .project:nth-child(1){grid-column:1/-1;max-width:none;min-height:340px;display:flex;align-items:flex-end}
      .project:nth-child(1) .project-main{width:100%}
      .project-type{margin-bottom:26px;font-size:9px;letter-spacing:.11em}
      .project-name{font-size:clamp(38px,4.8vw,68px);letter-spacing:-.095em}
      .project:nth-child(1) .project-name{font-size:clamp(62px,9vw,126px)}
      .project-summary{max-width:640px;font-size:clamp(15px,1.45vw,18px)}
      .project-description{max-width:690px;font-size:13px}
      .project-bottom{margin-top:30px;align-items:center}
      .project-stack{gap:7px}
      .project-stack span{
        padding:7px 10px;border:1px solid var(--soft-line);border-radius:999px;
        color:var(--muted);font:9px var(--sans);letter-spacing:0;
      }
      .project-link{padding:10px 14px;border:1px solid var(--line);border-radius:999px;font:10px var(--sans);letter-spacing:0;text-transform:none}
      .project-link:hover{gap:15px;border-color:var(--ink)}
      .about-lead{max-width:1050px;font-size:clamp(38px,6.5vw,86px)}
      .about-note{font-size:14px}
      .facts{gap:14px}
      .fact{padding:20px;border:1px solid var(--soft-line);border-radius:18px;background:var(--glass);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px)}
      .fact h3{font-size:9px}
      .fact p{font-size:13px}
      .skills{margin-top:clamp(72px,9vw,115px)}
      .skill-groups{gap:14px}
      .skill-group{padding:21px;border:1px solid var(--soft-line);border-radius:18px;background:var(--glass);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px)}
      .skill-group h4{font-family:var(--sans);font-size:11px;letter-spacing:0}
      .skill-items{gap:8px}
      .skill-items span{padding:7px 10px;border:1px solid var(--soft-line);border-radius:999px;font-size:12px}
      .contact{padding-top:clamp(110px,15vw,205px)}
      .contact-title{font-size:clamp(68px,11vw,154px)}
      .mail{padding:13px 18px;border:1px solid var(--line);border-radius:999px;font-size:15px}
      .mail:hover{gap:27px}
      footer{border:0;padding:18px 0 30px}
      .js .reveal{filter:blur(12px);opacity:0;transform:translateY(28px) scale(.99);transition:opacity .85s var(--ease),transform .85s var(--ease),filter .85s var(--ease)}
      .js .reveal.visible{filter:blur(0);opacity:1;transform:none}
      .project:nth-child(2){transition-delay:.04s}.project:nth-child(3){transition-delay:.09s}.project:nth-child(4){transition-delay:.14s}
      @media(max-width:760px){
        .header{height:70px}
        .nav{width:calc(100% - 28px);padding-inline:16px}
        .hero{min-height:100svh;padding-top:130px}
        .hero-top{margin-bottom:70px}
        .hero-bottom{margin-top:60px}
        .hero-side{width:max-content;max-width:100%;gap:25px}
        .section-intro{grid-template-columns:1fr;gap:18px}
        .section-intro h2{grid-column:auto}
        .project-list{grid-template-columns:1fr;gap:14px}
        .project,.project:nth-child(1){grid-column:auto;min-height:0;padding:25px;border-radius:20px}
        .project:nth-child(1) .project-name{font-size:clamp(52px,12vw,80px)}
        .project-name{font-size:clamp(42px,10vw,62px)}
        .project-bottom{align-items:flex-start;flex-direction:column}
        .about-grid,.skills{grid-template-columns:1fr;gap:30px}
        .facts{grid-template-columns:repeat(2,minmax(0,1fr))}
        .contact-bottom{align-items:flex-start;flex-direction:column}
      }
      @media(max-width:480px){
        :root{--gutter:20px}
        .header{height:66px}
        .nav{height:48px;margin-top:9px}
        .nav-links{gap:13px}
        .nav-links a{font-size:10px}
        .nav-actions{gap:11px}
        .theme-toggle{padding:6px 9px;font-size:10px}
        .hero{padding-bottom:48px}
        h1{font-size:clamp(55px,14vw,76px)}
        .hero-top{font-size:8px}
        .hero-side{padding:14px;border-radius:15px;gap:20px}
        .hero-side p{font-size:10px}
        .section{padding-block:86px}
        .section-intro h2{font-size:clamp(52px,13vw,70px)}
        .project,.project:nth-child(1){padding:22px;border-radius:18px}
        .project:nth-child(1) .project-name{font-size:clamp(48px,12vw,66px)}
        .project-name{font-size:clamp(38px,10vw,48px)}
        .project-summary{font-size:14px}
        .project-description{font-size:12px}
        .facts{gap:10px}
        .fact{padding:15px;border-radius:15px}
        .fact p{font-size:11px}
        .skill-groups{gap:10px}
        .skill-group{padding:17px;border-radius:15px}
        .skill-items span{font-size:11px;padding:6px 8px}
        .contact-title{font-size:clamp(58px,14vw,78px)}
        .mail{font-size:12px}
      }
      @media(hover:none),(pointer:coarse){.project:hover{transform:none}.project::after{display:none}}
      @media(prefers-reduced-motion:reduce){.js .reveal{filter:none}}


      /* Square-edged monochrome direction */
      :root{--corner:2px}
      .nav,.theme-toggle,.hero-side,.project,.project-stack span,.project-link,
      .fact,.skill-group,.skill-items span,.mail,.eyebrow::before{
        border-radius:var(--corner)!important;
      }
      .nav{height:54px;padding-inline:20px;background:rgba(18,18,18,.58);border-color:var(--glass-edge)}
      :root[data-theme="light"] .nav{background:rgba(248,248,248,.72)}
      .theme-toggle{padding:8px 11px}
      .hero-side{border-radius:var(--corner);padding:18px 20px}
      .project{border-radius:var(--corner);padding:clamp(26px,3.6vw,48px)}
      .project:nth-child(1){min-height:370px}
      .project-stack span{border-radius:var(--corner);padding:6px 9px}
      .project-link{border-radius:var(--corner);padding:9px 12px}
      .fact,.skill-group{border-radius:var(--corner);padding:22px}
      .skill-items span{border-radius:var(--corner);padding:6px 9px;background:var(--surface)}
      .mail{border-radius:var(--corner);padding:12px 0}
      .project:hover{transform:translateY(-3px)}
      .project::after{background:radial-gradient(460px circle at var(--mx,50%) var(--my,50%),rgba(255,255,255,.075),transparent 58%)}
      .js .reveal{
        opacity:.28;filter:blur(11px);transform:translate3d(0,22px,0);
        transition:opacity .65s var(--ease),filter .65s var(--ease),transform .65s var(--ease);
        will-change:opacity,filter,transform;
      }
      .js .reveal.visible{opacity:1;filter:blur(0);transform:translate3d(0,0,0)}
      .header{backdrop-filter:none;-webkit-backdrop-filter:none}
      .header.scrolled{background:rgba(9,9,9,.62);backdrop-filter:blur(24px) saturate(125%);-webkit-backdrop-filter:blur(24px) saturate(125%)}
      :root[data-theme="light"] .header.scrolled{background:rgba(245,245,245,.68)}
      @media(max-width:760px){
        .nav{height:50px;padding-inline:15px}
        .project,.project:nth-child(1){border-radius:var(--corner)!important;padding:24px;min-height:0}
        .fact,.skill-group{padding:17px}
      }
      @media(max-width:480px){
        .nav{height:48px}
        .hero-side{padding:14px}
        .project,.project:nth-child(1){padding:21px}
        .fact,.skill-group{padding:15px}
      }
      @media(hover:none),(pointer:coarse){.project:hover{transform:none}}
      @media(prefers-reduced-motion:reduce){
        .js .reveal{opacity:1;filter:none;transform:none;will-change:auto}
      }

    </style>
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem("portfolio-theme");
          const preferred = window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
          document.documentElement.dataset.theme = saved || preferred;
        } catch (_) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="header" id="header">
      <div class="shell nav">
        <a class="wordmark" href="#home" aria-label="Vinith Reddy Banda home">V/RB.</a>
        <div class="nav-actions">
          <nav class="nav-links" aria-label="Main navigation">
            <a href="#work">Work</a>
            <a href="#about">About</a>
            <a href="#contact">Contact</a>
          </nav>
          <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Switch colour theme">Light</button>
        </div>
      </div>
    </header>

    <main id="main">
      <section class="hero shell" id="home">
        <div class="hero-inner">
          <div class="hero-top mono">
            <span class="eyebrow">Software engineer</span>
            <span>Based in Hyderabad, India</span>
          </div>
          <h1><span>Vinith Reddy</span><span class="serif">Banda</span></h1>
          <div class="hero-bottom">
            <p class="hero-copy"><strong>I build across the stack.</strong> Backend systems, mobile products and AI-powered experiences, with an eye for the details that make software feel right.</p>
            <div class="hero-side">
              <div><span class="mono muted">Focus</span><p>Full stack / Android / AI</p></div>
              <div><span class="mono muted">Now</span><p>Programmer Analyst</p></div>
            </div>
          </div>
        </div>
      </section>

      <section class="section" id="work">
        <div class="shell">
          <div class="section-intro reveal">
            <span class="section-kicker mono">A few things I’ve built</span>
            <h2>Selected <em>work</em></h2>
            <p>Products and experiments shaped by practical problems, curious ideas and the craft of building.</p>
          </div>
          <div class="project-list">
            {projects.map((project) => (
              <article class="project reveal">
                <div class="project-main">
                  <span class="project-type mono">{project.type} <span class="project-year">/ {project.year}</span></span>
                  <h3 class="project-name">{project.name}</h3>
                  <p class="project-summary">{project.summary}</p>
                  <p class="project-description">{project.description}</p>
                  <div class="project-bottom">
                    <div class="project-stack">{project.stack.map((item) => <span>{item}</span>)}</div>
                    {project.link ? <a class="project-link" href={project.link} target="_blank" rel="noreferrer">{project.linkLabel}<span aria-hidden="true">↗</span></a> : null}
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section" id="about">
        <div class="shell">
          <div class="section-intro reveal">
            <span class="section-kicker mono">A little about me</span>
            <h2>Curious by <em>nature.</em></h2>
          </div>
          <p class="about-lead reveal">I like understanding how things work, then making them work <em>better.</em></p>
          <div class="about-grid reveal">
            <p class="about-note">My work moves between backend architecture, frontend experiences and native Android. I enjoy the full process: understanding a problem, making sensible technical choices, and refining the small details that shape the finished product.</p>
            <div class="facts">
              <div class="fact"><h3>Education</h3><p>B.E. Information Technology<br />Chaitanya Bharathi Institute of Technology<br /><span class="sub">8.30 CGPA · 2023–2026</span></p></div>
              <div class="fact"><h3>Earlier education</h3><p>Diploma, Computer Engineering<br />Government Polytechnic College, Warangal<br /><span class="sub">9.74 CGPA · 2020–2023</span></p></div>
              <div class="fact"><h3>Experience</h3><p>Programmer Analyst<br />Cognizant · 2026</p></div>
              <div class="fact"><h3>Recognition</h3><p>Microsoft AI for Good · Top 100<br />GFG HackWeek · Rank 6<br />NxtWave Buildathon · State level</p></div>
            </div>
          </div>
          <div class="skills reveal">
            <div class="skills-heading">
              <span class="section-kicker mono">The toolkit</span>
              <h3>Tools I work <em>with.</em></h3>
            </div>
            <div class="skill-groups">
              {skills.map((skill) => (
                <div class="skill-group">
                  <h4>{skill.group}</h4>
                  <div class="skill-items">{skill.items.map((item) => <span>{item}</span>)}</div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section class="contact" id="contact">
        <div class="shell">
          <div class="section-intro reveal"><span class="section-kicker mono">Get in touch</span></div>
          <h2 class="contact-title reveal">Let’s make<br /><em>something matter.</em></h2>
          <div class="contact-bottom reveal">
            <p>Open to interesting problems,<br />good people and thoughtful collaboration.</p>
            <a class="mail" href="mailto:vinithreddybanda@gmail.com">vinithreddybanda@gmail.com <span aria-hidden="true">↗</span></a>
          </div>
          <footer class="mono">
            <span>© {new Date().getFullYear()} Vinith Reddy Banda</span>
            <div class="footer-links">
              <a href="https://github.com/vinithreddybanda" target="_blank" rel="noreferrer">GitHub</a>
              <a href="mailto:vinithreddybanda@gmail.com">Email</a>
            </div>
          </footer>
        </div>
      </section>
    </main>

    <script is:inline>
      document.documentElement.classList.add("js");
      const header = document.getElementById("header");
      const themeButton = document.getElementById("theme-toggle");
      const setThemeLabel = () => {
        const light = document.documentElement.dataset.theme === "light";
        themeButton.textContent = light ? "Dark" : "Light";
        themeButton.setAttribute("aria-label", light ? "Switch to dark theme" : "Switch to light theme");
      };
      setThemeLabel();
      themeButton.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "light" ? "dark" : "light";
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem("portfolio-theme", next); } catch (_) {}
        setThemeLabel();
      });

      const syncHeader = () => header.classList.toggle("scrolled", window.scrollY > 12);
      syncHeader();
      window.addEventListener("scroll", syncHeader, { passive: true });

      const revealNodes = document.querySelectorAll(".reveal");
      if ("IntersectionObserver" in window && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            entry.target.classList.toggle("visible", entry.isIntersecting);
          });
        }, { threshold: 0.01, rootMargin: "-12% 0px -12% 0px" });
        revealNodes.forEach((node) => observer.observe(node));
      } else {
        revealNodes.forEach((node) => node.classList.add("visible"));
      }
    </script>
  </body>
</html>