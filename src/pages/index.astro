---
import IsometricScene from "../components/IsometricScene.astro";

const projects = [
  {
    number: "01",
    scene: "clinic",
    name: "CareSchedule",
    category: "HEALTHCARE SYSTEMS",
    year: "2026",
    summary: "A calmer way to coordinate the moving parts of a clinic.",
    detail: "Built during my .NET Full Stack internship at Cognizant. A clinic operations platform shaped around six-layer Clean Architecture, 148 REST APIs and six role-based workflows. Its appointment engine accounts for provider availability, leave, holidays and resource constraints before offering a slot.",
    stack: ".NET · React · Entity Framework Core · SQL Server",
    mark: "CS",
    metric: "148",
    metricLabel: "REST endpoints"
  },
  {
    number: "02",
    scene: "journal",
    name: "JournalAI",
    category: "APPLIED AI",
    year: "2025",
    summary: "A private space for reflection. Patterns, not noise.",
    detail: "A journaling experience that turns personal entries into structured mood insights. Designed around a cloud-ready architecture and an automated delivery pipeline.",
    stack: "Next.js · TypeScript · Supabase · Azure · Docker",
    mark: "J.",
    metric: "01",
    metricLabel: "space to reflect"
  },
  {
    number: "03",
    scene: "android",
    name: "Activities for Discord",
    category: "ANDROID SYSTEMS",
    year: "2025",
    summary: "Desktop presence controls, rethought for Android.",
    detail: "An Android application bringing mobile control to Discord Rich Presence through a native integration layer, persistent SDK sessions, JNI and encrypted credential storage.",
    stack: "Android · Java · C++ · JNI · Discord Partner SDK",
    mark: "PR",
    metric: "JNI",
    metricLabel: "native integration"
  }
];
const capabilities = ["C# / .NET", "TypeScript", "React / Next.js", "Java / Kotlin", "C++ / JNI", "SQL / PostgreSQL", "Azure / Docker", "Systems design"];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#080808" />
    <meta name="description" content="Vinith Reddy Banda — software engineer building thoughtful systems and digital experiences." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />
    <title>Vinith Reddy Banda — Software Engineer</title>
    <style>
      :root {
        color-scheme: dark;
        --bg: #080808;
        --fg: #f4f4f1;
        --dim: #858581;
        --line: rgba(244,244,241,.17);
        --soft-line: rgba(244,244,241,.09);
        --g: clamp(20px, 5.2vw, 84px);
        --mono: "DM Mono", ui-monospace, monospace;
        --sans: "DM Sans", -apple-system, BlinkMacSystemFont, sans-serif;
        --serif: "Instrument Serif", Georgia, serif;
        --ease: cubic-bezier(.22,1,.36,1);
      }
      *,*::before,*::after{box-sizing:border-box}
      html{background:var(--bg);scroll-behavior:smooth;scroll-padding-top:90px}
      body{margin:0;background:var(--bg);color:var(--fg);font-family:var(--sans);-webkit-font-smoothing:antialiased;overflow-x:clip}
      body::after{content:"";position:fixed;inset:0;z-index:30;pointer-events:none;opacity:.12;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.92' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.13'/%3E%3C/svg%3E");mix-blend-mode:soft-light}
      ::selection{background:var(--fg);color:var(--bg)}
      a{color:inherit;text-decoration:none}
      button,a,summary{-webkit-tap-highlight-color:transparent}
      a:focus-visible,summary:focus-visible{outline:1px solid var(--fg);outline-offset:6px}
      .shell{width:min(100%,1800px);margin:auto;padding-inline:var(--g)}
      .mono{font:10px/1.4 var(--mono);letter-spacing:.08em;text-transform:uppercase}
      .muted{color:var(--dim)}
      .top{position:fixed;z-index:40;inset:0 0 auto;height:74px;transition:background .5s ease,border-color .5s ease,backdrop-filter .5s ease;border-bottom:1px solid transparent}
      .top.is-scrolled{background:rgba(8,8,8,.58);border-color:var(--soft-line);backdrop-filter:blur(22px) saturate(120%);-webkit-backdrop-filter:blur(22px) saturate(120%)}
      .nav{height:100%;display:flex;align-items:center;justify-content:space-between}
      .brand{font-size:14px;font-weight:700;letter-spacing:-.09em}
      .nav-right{display:flex;align-items:center;gap:clamp(18px,3vw,44px)}
      .nav-right a{font:10px var(--mono);letter-spacing:.06em;text-transform:uppercase;color:#aaa;transition:color .25s}
      .nav-right a:hover{color:var(--fg)}
      .nav-index{color:var(--dim);font:10px var(--mono);margin-right:clamp(8px,2vw,26px)}
      .hero{min-height:100svh;position:relative;display:flex;flex-direction:column;justify-content:flex-end;padding-top:130px;padding-bottom:clamp(30px,5vw,70px);isolation:isolate}
      .hero>.hero-art{position:absolute;z-index:0;top:5%;right:var(--g);width:min(66vw,940px);aspect-ratio:720/500;height:auto;pointer-events:none;opacity:.98;overflow:visible}
      .hero>.shell{position:relative;z-index:1}
      .hero .scroll-cue{z-index:2}
      .hero-art svg,.project-art svg{display:block;width:100%;height:100%;overflow:visible}
      .project-art{display:block;grid-column:1/-1;width:100%;height:auto;aspect-ratio:720/500;overflow:visible;margin:0;opacity:1}
      .project-aside{grid-column:2/-1;display:grid;grid-template-columns:minmax(0,1fr) auto auto;align-items:center;gap:18px;min-width:0;padding-top:24px}
      .project-year{grid-column:2}
      .project-metric{grid-column:3}
      @media(max-width:760px){
        .hero>.hero-art{top:9%;right:-8%;width:92vw;opacity:.58}
        .hero>.shell{z-index:1}
        .project-art{width:100%;height:auto;aspect-ratio:720/500;margin:0}
        .project-aside{grid-column:2;grid-template-columns:minmax(0,1fr) auto;gap:14px;padding-top:20px}
        .project-art{grid-column:1/-1}
        .project-year{grid-column:1}
        .project-metric{grid-column:2}
      }
      @media(max-width:430px){.hero>.hero-art{top:14%;right:-20%;width:100vw;opacity:.48}.project-art{height:auto;width:100%;aspect-ratio:720/500}}
      .hero::before{content:"";position:absolute;z-index:-1;width:min(75vw,1050px);aspect-ratio:1;right:-28%;top:-25%;border-radius:50%;background:radial-gradient(circle,rgba(255,255,255,.105),rgba(255,255,255,.025) 36%,transparent 68%);filter:blur(55px);transform:translate3d(0,var(--glow-y,0),0)}
      .hero-topline{display:flex;align-items:center;justify-content:space-between;margin-bottom:clamp(35px,7vh,90px)}
      .hero-topline .mono:last-child{color:var(--dim)}
      .hero-title{margin:0;font-size:clamp(68px,13.9vw,230px);line-height:.76;letter-spacing:-.105em;font-weight:600;max-width:1500px}
      .hero-title .line{display:block;overflow:hidden;padding:0 .08em .12em 0;margin-right:-.08em}
      .hero-title .line span{display:block;transform:translateY(115%);filter:blur(16px);opacity:0;animation:title-in 1.25s var(--ease) forwards}
      .hero-title .line:nth-child(2) span{animation-delay:.13s}
      .hero-title em{font-family:var(--serif);font-weight:400;letter-spacing:-.065em}
      @keyframes title-in{to{transform:translateY(0);filter:blur(0);opacity:1}}
      .hero-foot{display:grid;grid-template-columns:1fr auto;align-items:end;gap:36px;margin-top:clamp(48px,9vh,110px)}
      .intro{max-width:390px;font-size:clamp(15px,1.55vw,21px);line-height:1.5;letter-spacing:-.035em;color:#aaa;margin:0}
      .intro em{font:italic clamp(19px,2vw,27px) var(--serif);color:var(--fg)}
      .hero-meta{display:flex;gap:clamp(25px,5vw,72px)}
      .meta-item .mono{color:var(--dim)}
      .meta-item p{font-size:12px;margin:9px 0 0;letter-spacing:-.01em}
      .scroll-cue{position:absolute;left:var(--g);top:52%;display:flex;align-items:center;gap:12px;writing-mode:vertical-rl;color:var(--dim);transform:rotate(180deg)}
      .scroll-cue::after{content:"";height:44px;width:1px;background:linear-gradient(var(--fg),transparent)}
      .section{padding-block:clamp(100px,14vw,210px)}
      .section-kicker{display:flex;justify-content:space-between;align-items:center;padding-bottom:18px;border-bottom:1px solid var(--line);color:var(--dim)}
      .work-heading{display:flex;justify-content:space-between;align-items:end;gap:30px;padding:clamp(34px,6vw,82px) 0 clamp(48px,8vw,112px)}
      .work-heading h2{font-size:clamp(54px,10vw,150px);line-height:.8;letter-spacing:-.1em;font-weight:500;margin:0}
      .work-heading h2 em{font:italic .98em var(--serif);letter-spacing:-.075em}
      .work-heading p{max-width:220px;font-size:12px;line-height:1.7;color:var(--dim);margin:0 0 4px}
      .projects{border-top:1px solid var(--line)}
      .project{display:grid;grid-template-columns:72px minmax(0,1fr);gap:clamp(16px,3vw,48px);align-items:start;padding:clamp(32px,5.5vw,78px) 0;border-bottom:1px solid var(--line);position:relative;isolation:isolate}
      .project::before{content:"";position:absolute;z-index:-1;inset:0 calc(var(--g)*-.35);background:linear-gradient(100deg,rgba(255,255,255,.055),transparent 72%);opacity:0;transform:scaleY(.86);transform-origin:center;transition:opacity .7s var(--ease),transform .7s var(--ease)}
      .project:hover::before{opacity:1;transform:scaleY(1)}
      .project-num{padding-top:10px;color:var(--dim)}
      .project-main{min-width:0}
      .project-label{display:flex;align-items:center;gap:14px;color:var(--dim);margin-bottom:clamp(18px,3vw,36px)}
      .project-label::before{content:"";width:20px;height:1px;background:var(--fg)}
      .project h3{font-size:clamp(36px,6.5vw,92px);font-weight:500;line-height:.88;letter-spacing:-.085em;margin:0;max-width:850px;transition:transform .7s var(--ease),filter .7s var(--ease)}
      .project:hover h3{transform:translateX(7px);filter:blur(.15px)}
      .project h3 em{font:italic 1em var(--serif);letter-spacing:-.06em}
      .project-summary{max-width:420px;font-size:clamp(14px,1.3vw,17px);line-height:1.65;color:#aaa;margin:24px 0 0}
      .project-aside{grid-column:2/-1;display:grid;grid-template-columns:minmax(0,1fr) auto auto;align-items:center;gap:18px;padding-top:24px;min-width:0}
      .project-year{color:var(--dim)}
      .project-metric{width:100%;max-width:none;min-height:110px;border:1px solid var(--line);display:flex;flex-direction:column;justify-content:space-between;padding:16px;position:relative;overflow:hidden;transition:background .6s var(--ease),color .6s var(--ease),transform .6s var(--ease)}
      .project-metric::after{content:"";position:absolute;width:110px;height:110px;border:1px solid currentColor;border-radius:50%;right:-48px;bottom:-52px;box-shadow:0 0 0 12px transparent,0 0 0 13px currentColor;opacity:.25;transition:transform .8s var(--ease)}
      .project:hover .project-metric{background:var(--fg);color:var(--bg);transform:translateY(-4px)}
      .project:hover .project-metric::after{transform:scale(1.35) rotate(28deg)}
      .metric-value{font-size:clamp(35px,4vw,56px);line-height:1;letter-spacing:-.09em}
      .metric-label{font:9px var(--mono);letter-spacing:.08em;text-transform:uppercase;opacity:.65}
      .details{margin-top:28px;max-width:560px}
      .details summary{cursor:pointer;display:inline-flex;align-items:center;gap:12px;color:var(--fg);font:10px var(--mono);letter-spacing:.07em;text-transform:uppercase;list-style:none}
      .details summary::-webkit-details-marker{display:none}
      .details summary::after{content:"↗";font-size:14px;transition:transform .4s var(--ease)}
      .details[open] summary::after{transform:rotate(45deg)}
      .detail-body{padding:18px 0 0;animation:detail-show .55s var(--ease) both}
      .detail-body p{font-size:13px;line-height:1.8;color:#aaa;margin:0 0 16px}
      .detail-body .mono{color:var(--fg);font-size:9px}
      @keyframes detail-show{from{opacity:0;transform:translateY(12px);filter:blur(7px)}to{opacity:1;transform:none;filter:blur(0)}}
      .about{padding-top:clamp(70px,10vw,140px)}
      .about-lead{max-width:1300px;font-size:clamp(36px,7.6vw,112px);line-height:.99;letter-spacing:-.075em;font-weight:500;margin:clamp(40px,7vw,90px) 0 0}
      .about-lead .serif{font:italic 1.08em var(--serif);letter-spacing:-.06em}
      .about-lead .faint{color:#666}
      .about-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(40px,10vw,150px);margin-top:clamp(90px,14vw,190px)}
      .about-note{max-width:300px;color:#aaa;font-size:14px;line-height:1.85;margin:0}
      .facts{display:grid;grid-template-columns:1fr 1fr;gap:34px 48px}
      .fact{border-top:1px solid var(--line);padding-top:14px}
      .fact h3{font:9px var(--mono);letter-spacing:.09em;text-transform:uppercase;color:var(--dim);margin:0 0 13px}
      .fact p{font-size:12px;line-height:1.8;margin:0;color:#d0d0cc}
      .skills{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(40px,10vw,150px);margin-top:clamp(70px,10vw,130px);padding-top:18px;border-top:1px solid var(--line)}
      .skills-label{color:var(--dim)}
      .skill-list{display:flex;flex-wrap:wrap;gap:12px 24px}
      .skill-list span{font-size:clamp(14px,1.4vw,18px);letter-spacing:-.035em;color:#c5c5c1}
      .contact{padding-top:clamp(100px,15vw,220px);padding-bottom:28px}
      .contact-top{display:flex;justify-content:space-between;align-items:center;padding-bottom:20px;border-bottom:1px solid var(--line);color:var(--dim)}
      .contact-title{font-size:clamp(64px,14vw,205px);line-height:.77;letter-spacing:-.105em;font-weight:500;margin:clamp(48px,8vw,100px) 0}
      .contact-title em{font:italic 1.02em var(--serif);letter-spacing:-.075em}
      .contact-bottom{display:flex;align-items:end;justify-content:space-between;gap:30px;padding-bottom:clamp(80px,12vw,160px)}
      .contact-bottom p{font-size:13px;line-height:1.7;color:var(--dim);margin:0}
      .mail{display:inline-flex;align-items:center;gap:22px;border-bottom:1px solid var(--fg);padding:0 0 12px;font-size:clamp(14px,1.6vw,20px);transition:gap .35s var(--ease)}
      .mail:hover{gap:34px}
      .mail span{font-size:20px}
      footer{display:flex;justify-content:space-between;gap:20px;border-top:1px solid var(--line);padding-top:20px;color:var(--dim)}
      .footer-links{display:flex;gap:24px}
      .footer-links a{transition:color .2s}
      .footer-links a:hover{color:var(--fg)}
      .reveal{opacity:1;transform:none;filter:none}
      html.js .reveal{opacity:0;transform:translate3d(0,34px,0) scale(.985);filter:blur(10px);transition:opacity .95s var(--ease),transform 1.05s var(--ease),filter 1s var(--ease);will-change:opacity,transform,filter}
      html.js .reveal.in-view{opacity:1;transform:translate3d(0,0,0) scale(1);filter:blur(0);will-change:auto}
      html.js .depth{transition:opacity .8s ease,filter .8s ease,transform .8s var(--ease)}
      html.js .depth:not(.in-focus){opacity:.72;filter:blur(1.2px);transform:scale(.992)}
      .skip{position:absolute;top:10px;left:10px;z-index:100;padding:12px;background:var(--fg);color:var(--bg);transform:translateY(-150%)}
      .skip:focus{transform:none}
      @media(min-width:1500px){.hero-title{font-size:min(14vw,250px)}}
      @media(max-width:760px){
        .top{height:64px}
        .hero{padding-top:110px;min-height:94svh}
        .hero-title{font-size:clamp(65px,14.3vw,112px)}
        .scroll-cue{display:none}
        .hero-foot{grid-template-columns:1fr;gap:30px;margin-top:55px}
        .hero-meta{justify-content:flex-start}
        .work-heading{align-items:start;flex-direction:column}
        .work-heading p{max-width:300px}
        .project{grid-template-columns:34px minmax(0,1fr);gap:12px}
        .project-aside{grid-column:2;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:14px;padding-top:20px}.project-art{grid-column:1/-1;width:100%;height:auto;max-height:none;aspect-ratio:720/500}.project-year{grid-column:1}.project-metric{grid-column:2}
        .project-metric{max-width:170px;min-height:105px}
        .project h3{font-size:clamp(40px,9vw,68px)}
        .about-grid,.skills{grid-template-columns:1fr;gap:36px}
        .about-note{max-width:430px}
        .contact-title{font-size:clamp(68px,15vw,112px)}
      }
      @media(max-width:430px){
        :root{--g:20px}
        .nav-index{display:none}
        .nav-right{gap:17px}
        .nav-right a{font-size:9px}
        .hero-title{font-size:clamp(58px,14.8vw,78px)}
        .hero-topline{margin-bottom:55px}
        .hero-meta{gap:30px}
        .meta-item p{font-size:11px}
        .section{padding-block:100px}
        .work-heading h2{font-size:62px}
        .project{padding-block:36px}
        .project h3{font-size:clamp(37px,10vw,48px)}
        .project-aside{gap:12px}
        .project-metric{min-height:96px;padding:12px;max-width:145px}
        .metric-value{font-size:34px}
        .facts{gap:28px 20px}
        .contact-bottom{align-items:start;flex-direction:column}
        footer{flex-direction:column;font-size:9px}
      }
      @media(max-width:350px){.hero-title{font-size:54px}.hero-meta{gap:18px}.nav-right{gap:12px}}
      @media(hover:none),(pointer:coarse){.project:hover::before{opacity:0}.project:hover h3{transform:none}.project:hover .project-metric{background:transparent;color:var(--fg);transform:none}}
      @media(prefers-reduced-motion:reduce){
        *,*::before,*::after{scroll-behavior:auto!important;animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}
        html.js .reveal,html.js .depth,html.js .depth:not(.in-focus){opacity:1;transform:none;filter:none}
      }

      /* Illustrations stay assembled; their own project-specific timelines run continuously. */
      .hero-art,.project-art{filter:grayscale(1) saturate(0) contrast(1.12);transform:none;transform-origin:center}
      .hero-art svg,.project-art svg{width:100%;height:100%}
      .project-art{transition:filter .35s ease}
      .project:hover .project-art{filter:grayscale(1) saturate(0) contrast(1.25)}
      @media(prefers-reduced-motion:reduce){.hero-art,.project-art{transform:none!important}}
    </style>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top" id="top">
      <div class="shell nav">
        <a class="brand" href="#home" aria-label="Vinith Reddy Banda home">V/RB.</a>
        <div class="nav-right">
          <span class="nav-index">PORTFOLIO — 2026</span>
          <a href="#work">Work <span class="muted">01</span></a>
          <a href="#about">About <span class="muted">02</span></a>
          <a href="#contact">Contact <span class="muted">03</span></a>
        </div>
      </div>
    </header>
    <main id="main">
      <section class="hero depth" id="home">
        <IsometricScene scene="hero" class="hero-art" />
        <div class="shell">
          <div class="hero-topline mono"><span>Independent mind. Intentional work.</span><span>Hyderabad, IN · 17°23′N</span></div>
          <h1 class="hero-title">
            <span class="line"><span>Vinith Reddy</span></span>
            <span class="line"><span>Banda<em>.</em></span></span>
          </h1>
          <div class="hero-foot">
            <p class="intro">Engineer by discipline.<br /><em>Curious by default.</em> I build thoughtful software across systems and interfaces.</p>
            <div class="hero-meta">
              <div class="meta-item"><div class="mono">Currently</div><p>Software Engineer</p></div>
              <div class="meta-item"><div class="mono">Based in</div><p>Hyderabad, India</p></div>
            </div>
          </div>
        </div>
        <div class="scroll-cue mono">Scroll to explore</div>
      </section>

      <section class="section" id="work">
        <div class="shell">
          <div class="section-kicker mono reveal"><span>01 / Selected work</span><span>2025 — 2026</span></div>
          <div class="work-heading reveal">
            <h2>Made with<br /><em>intent.</em></h2>
            <p>A small selection of things I've built, and the problems that made them worth building.</p>
          </div>
          <div class="projects">
            {projects.map((project) => (
              <article class="project reveal">
                <div class="project-num mono">{project.number}</div>
                <div class="project-main">
                  <div class="project-label mono">{project.category}</div>
                  <h3>{project.name === "Activities for Discord" ? <>Activities <em>for</em><br />Discord</> : project.name === "CareSchedule" ? <>Care<em>Schedule</em></> : <>{project.name}</>}</h3>
                  <p class="project-summary">{project.summary}</p>
                  <details class="details">
                    <summary>Explore the build</summary>
                    <div class="detail-body">
                      <p>{project.detail}</p>
                      <div class="mono">{project.stack}</div>
                    </div>
                  </details>
                </div>
                <aside class="project-aside">
                  <IsometricScene scene={project.scene} class="project-art" />
                  <span class="project-year mono">{project.year}</span>
                  <div class="project-metric">
                    <span class="metric-value">{project.metric}</span>
                    <span class="metric-label">{project.metricLabel}</span>
                  </div>
                </aside>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section about" id="about">
        <div class="shell">
          <div class="section-kicker mono reveal"><span>02 / A little context</span><span>Person, then profession</span></div>
          <p class="about-lead reveal">I like technology that feels <span class="serif">inevitable.</span> <span class="faint">Clear in its purpose. Thoughtful in its details. Built to hold up.</span></p>
          <div class="about-grid reveal">
            <p class="about-note">I move between engineering disciplines: shaping reliable systems, building useful interfaces and understanding how the two meet. I care about the details people notice, and the ones they never have to.</p>
            <div class="facts">
