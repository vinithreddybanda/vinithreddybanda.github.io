---
import BaseLayout from "../layouts/BaseLayout.astro";
import { projects } from "../data/projects";
const featured = projects.slice(0, 4);
---
<BaseLayout title="Vinith | Creative developer" description="I’m Vinith. I build apps, websites and little experiments for the internet.">
  <section class="hero page-wrap">
    <div class="hero-copy">
      <p class="hello"><span class="hello-dot"></span> Hey, I’m Vinith</p>
      <h1>I make<br /><span>digital things</span><i>✳</i></h1>
      <div class="hero-bottom">
        <p>Apps, websites and experiments. I like making useful things feel really good to use.</p>
        <a class="round-link" href="#work" aria-label="Scroll to selected work">↓</a>
      </div>
    </div>
    <div class="hero-art" aria-hidden="true">
      <div class="hero-shape shape-one"></div><div class="hero-shape shape-two"></div>
      <div class="hero-orbit orbit-one"></div><div class="hero-orbit orbit-two"></div>
      <span class="hero-spark spark-one">✳</span><span class="hero-spark spark-two">✳</span>
      <span class="hero-art-word">MAKE<br />IT<br />REAL.</span>
    </div>
    <div class="hero-scroll">Scroll a little <span>↓</span></div>
  </section>

  <section class="work-section page-wrap" id="work">
    <div class="section-heading"><h2>Things I’ve made<span>({featured.length})</span></h2><a href="/work/">All projects <b>↗</b></a></div>
    <div class="project-grid">
      {featured.map((project, i) => <a class:list={["project-card", "project-card-"+(i+1)]} href={"/work/"+project.slug+"/"}>
        <div class="project-art art-"+(i+1)} aria-hidden="true">
          {i===0 && <div class="care-window"><div class="window-dots"><i></i><i></i><i></i></div><div class="care-title">Care<span>schedule.</span></div><div class="care-calendar"><b>MON</b><b>TUE</b><b>WED</b><b>THU</b><i>09</i><i>10</i><i class="selected">11</i><i>12</i><i>13</i><i>14</i><i>15</i><i>16</i></div><div class="care-pill">Appointment confirmed ✓</div></div>}
          {i===1 && <div class="journal-card"><span>MONDAY, 9:41 AM</span><b>Dear,<br /><em>today.</em></b><div class="journal-lines"></div><small>A little space for your thoughts.</small></div>}
          {i===2 && <div class="status-stack"><div class="status-photo photo-a"></div><div class="status-photo photo-b"></div><div class="status-photo photo-c"></div><span>Saved ✳</span></div>}
          {i===3 && <div class="voice-card"><span>LIVE TRANSCRIPTION</span><b>Listening<span>...</span></b><div class="waveform">{Array.from({length:31},(_,n)=><i style={"--h:"+((n*19)%42+8)+"px"}></i>)}</div><small>40+ languages</small></div>}
        </div>
        <div class="project-info"><div><h3>{project.name}</h3><p>{project.summary}</p></div><span class="project-arrow">↗</span></div>
      </a>)}
    </div>
  </section>

  <section class="about-strip">
    <div class="about-strip-inner page-wrap"><p class="strip-kicker">A bit about me</p><h2>Curious by default.<br /><span>Builder by choice.</span></h2><div class="strip-bottom"><p>I work across web, Android and AI. Most days you’ll find me learning something new, fixing a tiny detail or turning a random idea into a real thing.</p><a class="text-link" href="/about/">More about me <span>↗</span></a></div></div>
    <div class="strip-decoration" aria-hidden="true">✳</div>
  </section>

  <section class="stack-section page-wrap">
    <h2>My kind of toolkit</h2>
    <div class="stack-list"><span>TypeScript</span><span>React</span><span>Next.js</span><span>C# / .NET</span><span>Kotlin</span><span>Android</span><span>SQL</span><span>AI</span><span>Docker</span></div>
  </section>

  <section class="contact-banner page-wrap">
    <div><p>Got something in mind?</p><h2>Let’s make<br /><em>it happen.</em></h2></div>
    <a href="/contact/" aria-label="Get in touch">↗</a>
  </section>
</BaseLayout>