---
import Shell from "../layouts/Shell.astro";
import { projects } from "../data/content";
---
<Shell title="Vinith Reddy Banda — Software Engineer" description="Software engineer building Android apps, web products and applied AI experiments.">
<section class="hero-section" id="top"><div class="hero-meta"><span>INDEPENDENTLY BUILT / PERSONALLY MAINTAINED</span><span>HYDERABAD · INDIA</span></div><div class="hero-layout"><div class="hero-copy"><p class="eyebrow"><span class="eyebrow-mark"></span> SOFTWARE ENGINEER / PRODUCT BUILDER</p><h1>Building<br/><em>useful</em> things<br/>for the <span class="outline-word">real world.</span></h1><div class="hero-foot"><p>I’m Vinith. I work across Android, full-stack engineering and applied AI, with an eye for the details that make software feel considered.</p><a class="circle-link" href="#selected-work" aria-label="Explore selected work">↓</a></div></div><div class="press-stage" aria-label="Interactive abstract print press"><div class="press-label"><span>PROCESS / 01</span><span>IDEA → IMPLEMENTATION</span></div><div class="press-orbit orbit-a"></div><div class="press-orbit orbit-b"></div><div class="press-wheel"><div class="wheel-inner"><span>V</span><i>✳</i></div></div><div class="press-sheet"><span>THOUGHT<br/>INTO<br/><em>SOFTWARE</em></span><small>FIG. 001 — A WORKING PROCESS</small></div><div class="press-stamp">VB<br/><small>HYD / IN</small></div><span class="stage-coordinate coord-a">ANDROID / WEB</span><span class="stage-coordinate coord-b">BUILD · TEST · SHIP</span></div></div><div class="hero-bottomline"><span>SCROLL TO EXPLORE</span><span class="scroll-line"></span><span>ENGINEERING / DESIGN / OPEN SOURCE</span></div></section>
<section class="intro-band section-pad"><div class="section-index"><span>01 / APPROACH</span><span>HOW I LIKE TO WORK</span></div><div class="intro-grid"><p class="intro-lead">Start with the problem.<br/><em>Respect the details.</em></p><div class="intro-copy"><p>I enjoy moving between product thinking and implementation: understanding constraints, choosing a sensible architecture, building the experience and making delivery repeatable.</p><a class="under-link" href="/about/">THE PERSON / BACKGROUND <span>↗</span></a></div></div></section>
<section class="work-section section-pad" id="selected-work"><div class="section-index"><span>02 / SELECTED WORK</span><span>APPLICATIONS / SYSTEMS / EXPERIMENTS</span></div><div class="work-heading"><h2>Built, tested<br/><em>and shipped.</em></h2><a class="under-link" href="/studio/">ALL PROJECTS <span>↗</span></a></div><div class="work-wheel-wrap"><div class="wheel-instruction"><span>DRAG / SWIPE / USE ARROWS</span><span id="wheel-count">01 / 06</span></div><div class="work-wheel" id="work-wheel" aria-label="Selected projects">{projects.map((p,i)=><a class="work-object" href={"/studio/"+p.slug+"/"} style={"--i:"+i} data-wheel-item><div class={"object-art art-"+(i+1)}><span class="object-number">{p.no}</span>{i===0?<div class="music-art"><i></i><i></i><i></i><i></i><i></i><b>PLAY</b></div>:i===1?<div class="journal-art"><span>save,</span><em>share.</em><small>LOCAL MEDIA / ANDROID</small></div>:i===2?<div class="gallery-art"><i></i><i></i><i></i></div>:i===3?<div class="voice-art"><b>CARE</b><span>⌁</span></div>:i===4?<div class="care-art"><b>VOICE</b><span>40+ LANGUAGES</span><i>↗</i></div>:<div class="care-art"><b>NEXUS</b><span>AI / CIVIC</span><i>↗</i></div>}<span class="object-year">{p.year}</span></div><div class="object-caption"><span>{p.name}</span><small>{p.type}</small><b>↗</b></div></a>)}</div><div class="wheel-controls"><button type="button" id="wheel-prev" aria-label="Previous project">←</button><span>01 / 06</span><button type="button" id="wheel-next" aria-label="Next project">→</button></div></div></section>
<section class="github-section section-pad" id="open-source"><div class="section-index"><span>03 / OPEN SOURCE</span><span>LIVE FROM GITHUB</span></div><div class="github-heading"><div><h2>Code in the<br/><em>open.</em></h2><p>Selected public repositories, refreshed from the GitHub API. Star counts and descriptions are live, not typed into the design.</p></div><a class="under-link" href="https://github.com/vinithreddybanda" target="_blank" rel="noreferrer">OPEN GITHUB PROFILE <span>↗</span></a></div><div class="github-stats" id="github-live" aria-live="polite"><div><span>PUBLIC REPOSITORIES</span><b data-github-stat="public_repos">—</b></div><div><span>FOLLOWERS</span><b data-github-stat="followers">—</b></div><div><span>SELECTED STARS</span><b data-github-stat="stars">—</b></div><div><span>LAST SYNC</span><b id="github-sync">WAITING</b></div></div><section class="github-activity" aria-label="GitHub contribution activity"><div class="activity-heading"><span>CONTRIBUTION HISTORY / LAST 12 MONTHS</span><b id="github-contribution-total">LOADING</b></div><div class="activity-scroll"><div class="activity-months" id="github-activity-months" aria-hidden="true"></div><div class="activity-grid" id="github-contributions" aria-label="Daily GitHub contributions for the last year"></div></div><div class="activity-legend"><span>LESS</span><i data-level="0"></i><i data-level="1"></i><i data-level="2"></i><i data-level="3"></i><i data-level="4"></i><span>MORE</span><a href="https://github.com/vinithreddybanda" target="_blank" rel="noreferrer">VIEW PROFILE ↗</a></div></section><div class="github-repos" id="github-repos">{projects.filter(p=>p.url&&p.url.includes("github.com")).slice(0,4).map(p=><a class="github-repo" href={p.url} target="_blank" rel="noreferrer"><span class="repo-top"><i></i>{p.type}</span><b>{p.name}</b><p>{p.summary}</p><span class="repo-meta">PUBLIC REPOSITORY <i>↗</i></span></a>)}</div><p class="github-footnote" id="github-footnote">Live profile and repository details load directly from GitHub. Cached briefly to avoid unnecessary requests.</p></section>
<section class="manifesto-section"><div class="manifesto-mark">“</div><p>Useful software.<br/><em>Thoughtful execution.</em></p><span>— A WORKING PRINCIPLE</span></section>
<section class="now-section section-pad"><div class="section-index"><span>04 / CURRENT FOCUS</span><span>THE WORK IN PROGRESS</span></div><div class="now-grid"><div><span class="micro-label">AT THE DESK</span><h2>Building.<br/><em>Debugging.</em><br/>Learning.</h2></div><div class="now-list"><div><span>01</span><p>Native Android and open-source product work</p><b>↗</b></div><div><span>02</span><p>.NET services, APIs and data systems</p><b>↗</b></div><div><span>03</span><p>Reliable builds, automation and CI/CD</p><b>↗</b></div><div><span>04</span><p>Applied AI and voice interfaces</p><b>↗</b></div><a class="under-link" href="/about/">BACKGROUND & EXPERIENCE <span>↗</span></a></div></div></section>
<section class="contact-slab section-pad"><span class="micro-label">HAVE A GOOD PROBLEM?</span><div><h2>Let’s make<br/><em>something useful.</em></h2><a class="circle-link" href="/contact/" aria-label="Contact Vinith">↗</a></div></section></Shell>