---
import BaseLayout from "@layouts/BaseLayout.astro";
import ProjectCard from "@components/ProjectCard.astro";
import ExperienceEntry from "@components/ExperienceEntry.astro";
import { profile, projects, experience, skills, education, recognition } from "@data/portfolio";
---
<BaseLayout>
  <section class="hero" id="top">
    <div class="container hero-inner">
      <div class="hero-kicker" data-hero-top>
        <span class="eyebrow">Independent mind. Systems thinker.</span>
        <span class="availability"><i></i> Open to what’s next</span>
      </div>
      <h1 class="hero-title" data-hero-title>
        <span class="hero-line">I make</span>
        <span class="hero-line">complex things</span>
        <span class="hero-line"><em>work.</em></span>
      </h1>
      <div class="hero-bottom" data-hero-bottom>
        <p class="hero-intro">I’m <strong>${profile.name}</strong>. I build software across backend systems, Android, and AI, with a soft spot for the details most people never see.</p>
        <a class="scroll-cue" href="#work"><span>Scroll to explore</span><i>↓</i></a>
      </div>
      <div class="hero-index" aria-hidden="true"><span>PORTFOLIO / 2026</span><span>17°N — 78°E</span></div>
    </div>
  </section>

  <div class="ticker" aria-label="Areas of work">
    <div class="ticker-track"><span>BACKEND SYSTEMS</span><b>✳</b><span>ANDROID</span><b>✳</b><span>ARTIFICIAL INTELLIGENCE</span><b>✳</b><span>PRODUCT ENGINEERING</span><b>✳</b><span>BACKEND SYSTEMS</span><b>✳</b><span>ANDROID</span><b>✳</b><span>ARTIFICIAL INTELLIGENCE</span><b>✳</b><span>PRODUCT ENGINEERING</span></div>
  </div>

  <section class="section work-section" id="work">
    <div class="container">
      <div class="chapter-heading" data-reveal>
        <div><span class="chapter-index">01 / SELECTED WORK</span><h2>Not just code.<br /><em>Things that do things.</em></h2></div>
        <p>Three builds. Three different rabbit holes. Each one taught me something worth keeping.</p>
      </div>
      <div class="project-list">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>

  <section class="section experience-section" id="experience">
    <div class="container">
      <div class="chapter-heading" data-reveal>
        <div><span class="chapter-index">02 / IN THE REAL WORLD</span><h2>Where ideas<br /><em>meet constraints.</em></h2></div>
        <p>Shipping software changes the questions you ask. Reliability, edge cases, and what happens after launch start to matter.</p>
      </div>
      <div class="experience-list">{experience.map((item) => <ExperienceEntry item={item} />)}</div>
    </div>
  </section>

  <section class="section approach-section" id="approach">
    <div class="container">
      <div class="chapter-heading" data-reveal>
        <div><span class="chapter-index">03 / THE APPROACH</span><h2>Curiosity is the<br /><em>starting point.</em></h2></div>
        <p>I like understanding the whole machine: the interface, the API, the infrastructure, and the tiny decisions connecting them.</p>
      </div>
      <div class="approach-lines">
        <article data-reveal><span>01</span><h3>Look closer.</h3><p>Understand the problem before reaching for a framework.</p></article>
        <article data-reveal><span>02</span><h3>Make it make sense.</h3><p>Prefer clear architecture over clever complexity.</p></article>
        <article data-reveal><span>03</span><h3>Finish the job.</h3><p>Care about the edge cases, the release, and the people using it.</p></article>
      </div>
    </div>
  </section>

  <section class="section toolkit-section" id="toolkit">
    <div class="container">
      <div class="toolkit-top" data-reveal><div><span class="chapter-index">04 / THE TOOLKIT</span><h2>Tools change.<br /><em>Thinking compounds.</em></h2></div><p>A working set, not a collection of buzzwords.</p></div>
      <div class="toolkit-groups">
        {skills.map((group) => <div class="toolkit-group" data-reveal><span>{group.title}</span><p>{group.items.join("  ·  ")}</p></div>)}
      </div>
    </div>
  </section>

  <section class="section proof-section" id="background">
    <div class="container">
      <div class="proof-grid">
        <div data-reveal><span class="chapter-index">05 / THE FOUNDATION</span><h2>Built on<br /><em>learning.</em></h2>
          <div class="education-list">{education.map((item) => <article class="education-entry"><span>{item.period}</span><div><h3>{item.institution}</h3><p>{item.qualification}</p></div><strong>{item.result}</strong></article>)}</div>
        </div>
        <div data-reveal><span class="chapter-index">A FEW MILESTONES</span><div class="recognition-list">{recognition.map((item) => <article><h3>{item.title}</h3><p>{item.description}</p>{item.link && <a href={item.link} target="_blank" rel="noopener noreferrer">Explore publication ↗</a>}</article>)}</div></div>
      </div>
    </div>
  </section>
  <script>
    import "../scripts/motion";
  </script>
</BaseLayout>
