---
import BaseLayout from "@layouts/BaseLayout.astro";
import ExperienceEntry from "@components/ExperienceEntry.astro";
import { projects, experience, skills, education, recognition } from "@data/portfolio";
---
<BaseLayout>
  <section class="hero" id="top">
    <div class="hero-image" aria-hidden="true">
      <img src="https://images.unsplash.com/photo-1448375240586-882707db888b?auto=format&fit=crop&w=2400&q=88" alt="" fetchpriority="high" />
    </div>
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="hero-content container">
      <p class="hero-overline" data-reveal><span class="overline-mark"></span> SOFTWARE DEVELOPER · INDIA</p>
      <h1 data-reveal>Rooted in curiosity.<br /><em>Built with intent.</em></h1>
      <div class="hero-bottom" data-reveal>
        <p class="hero-intro">I’m Vinith. I build thoughtful software across backend systems, Android and AI, with a focus on the details that make technology feel effortless.</p>
        <a class="hero-link" href="#work">Explore selected work <span>↘</span></a>
      </div>
      <div class="hero-caption"><span>16° 30' N&nbsp; / &nbsp;80° 38' E</span><span>DESIGNING WITH PURPOSE</span></div>
    </div>
    <a class="hero-scroll" href="#work" aria-label="Scroll to selected work"><span></span> SCROLL TO EXPLORE</a>
  </section>

  <section class="intro-section section-pad container" data-reveal>
    <p class="section-index">01 / A NOTE</p>
    <div class="intro-copy">
      <h2>Good software should feel <em>considered.</em></h2>
      <p>I’m drawn to the space where engineering meets experience. From dependable backend systems to small Android utilities, I enjoy turning complex ideas into clear, useful products.</p>
    </div>
  </section>

  <section class="work-section section-pad" id="work">
    <div class="container">
      <div class="section-heading" data-reveal>
        <div><p class="section-index">02 / SELECTED WORK</p><h2>Things grown<br />from <em>ideas.</em></h2></div>
        <p class="section-aside">A few projects shaped by curiosity, care and a healthy amount of iteration.</p>
      </div>
      <div class="project-list">
        {projects.map((project, index) => <article class="project-row" data-reveal>
          <div class:list={["project-art", `project-art--${project.visual}`]} aria-hidden="true">
            <div class="art-atmosphere"></div>
            <div class="art-object"><span>{project.visual === "journal" ? "J." : project.visual === "discord" ? "◌" : "↗"}</span></div>
            <p class="art-caption">{project.type}</p>
            <span class="art-index">0{index + 1}</span>
          </div>
          <div class="project-copy">
            <p class="project-meta"><span>0{index + 1} / 0{projects.length}</span><span>{project.type}</span></p>
            <h3>{project.name}</h3>
            <p class="project-hook">{project.hook}</p>
            <p class="project-description">{project.description}</p>
            <p class="project-stack">{project.stack.join("  ·  ")}</p>
            <a class="text-link" href={project.link} target="_blank" rel="noopener noreferrer">{project.linkLabel} <span>↗</span></a>
          </div>
        </article>)}
      </div>
    </div>
  </section>

  <section class="experience-section section-pad">
    <div class="container">
      <div class="section-heading" data-reveal>
        <div><p class="section-index">03 / THE JOURNEY</p><h2>Learning by<br /><em>doing.</em></h2></div>
        <p class="section-aside">Working with real constraints, real people and real-world systems.</p>
      </div>
      <div class="experience-list">{experience.map((item) => <ExperienceEntry item={item} />)}</div>
    </div>
  </section>

  <section class="capabilities-section section-pad">
    <div class="container">
      <div class="section-heading" data-reveal>
        <div><p class="section-index">04 / THE TOOLSHED</p><h2>Tools of the<br /><em>trade.</em></h2></div>
        <p class="section-aside">A practical toolkit, always growing with the problems worth solving.</p>
      </div>
      <div class="skills-list">
        {skills.map((group) => <div class="skill-row" data-reveal><h3>{group.title}</h3><p>{group.items.join("  /  ")}</p></div>)}
      </div>
    </div>
  </section>

  <section class="about-section section-pad">
    <div class="container">
      <div class="section-heading" data-reveal>
        <div><p class="section-index">05 / ROOTS & REACH</p><h2>Always<br /><em>growing.</em></h2></div>
        <p class="section-aside">The learning, research and milestones behind the work.</p>
      </div>
      <div class="about-grid">
        <div class="about-column" data-reveal>
          <h3>Education</h3>
          {education.map((item) => <article class="about-entry"><span>{item.period}</span><div><h4>{item.institution}</h4><p>{item.qualification}</p></div><strong>{item.result}</strong></article>)}
        </div>
        <div class="about-column" data-reveal>
          <h3>Recognition</h3>
          {recognition.map((item) => <article class="recognition-entry"><div><h4>{item.title}</h4><p>{item.description}</p></div>{item.link && <a href={item.link} target="_blank" rel="noopener noreferrer" aria-label={`Read more about ${item.title}`}>↗</a>}</article>)}
        </div>
      </div>
    </div>
  </section>
  <script>import "../scripts/motion";</script>
</BaseLayout>