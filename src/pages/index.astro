---
import BaseLayout from "@layouts/BaseLayout.astro";
import ExperienceEntry from "@components/ExperienceEntry.astro";
import { profile, projects, experience, skills, education, recognition } from "@data/portfolio";
---
<BaseLayout>
  <section class="hero" id="top">
    <div class="hero-noise" aria-hidden="true"></div>
    <div class="hero-top"><a class="hero-wordmark" href="#top">vinith<span>®</span></a><span class="hero-location">HYDERABAD, INDIA · AVAILABLE WORLDWIDE</span></div>
    <div class="hero-main">
      <p class="hero-intro" data-hero-intro>Developer by practice.<br />Curious by default.</p>
      <h1 class="hero-title" data-hero-title>Building<br /><span>what's</span> <i>next.</i></h1>
      <div class="hero-bottom" data-hero-bottom><p>I’m <strong>${profile.name}</strong>, a software developer exploring the space between thoughtful engineering and products people actually love using.</p><a href="#work" class="hero-scroll">SCROLL A LITTLE <span>↘</span></a></div>
    </div>
    <div class="hero-orbit orbit-one"></div><div class="hero-orbit orbit-two"></div><div class="hero-sticker">IDEAS<br />INTO<br /><b>REALITY</b> ✳</div>
    <div class="hero-side-note">SOFTWARE / PEOPLE / POSSIBILITY</div>
  </section>

  <section class="intro-strip"><p>Not here to collect tech stacks.<br /><span>Here to make useful things happen.</span></p><div class="intro-marquee" aria-hidden="true"><div>BUILD · BREAK · LEARN · REPEAT · BUILD · BREAK · LEARN · REPEAT · </div></div></section>

  <section class="work-section" id="work">
    <div class="section-lead"><p class="eyebrow">A FEW THINGS I’VE MADE</p><h2>Proof of<br /><em>curiosity.</em></h2><p class="section-aside">Different problems.<br />Different rabbit holes.<br />Same urge to build.</p></div>
    {projects.map((project, index) => <article class:list={["project", `project-${project.visual}`]} data-project>
      <div class="project-visual" aria-hidden="true">
        <span class="project-visual-word">{index === 0 ? "feel." : index === 1 ? "online." : "yours."}</span>
        <span class="project-visual-mark">{index === 0 ? "✳" : index === 1 ? "◉" : "↗"}</span>
        {index === 0 && <div class="visual-orb visual-orb-a"></div>}
        {index === 1 && <div class="visual-orb visual-orb-b"></div>}
        {index === 2 && <div class="visual-orb visual-orb-c"></div>}
        <span class="visual-caption">{index === 0 ? "AI / JOURNALING" : index === 1 ? "ANDROID / DISCORD" : "ANDROID / OPEN SOURCE"}</span>
      </div>
      <div class="project-info">
        <div class="project-topline"><span>0{index + 1}</span><span>{project.type}</span></div>
        <div><p class="project-hook">{project.hook}</p><h3>{project.name}</h3><p class="project-description">{project.description}</p></div>
        <div class="project-bottom"><p>{project.stack.slice(0,5).join(" · ")}</p><a href={project.link ?? "#"} target="_blank" rel="noopener noreferrer">{project.linkLabel} <span>↗</span></a></div>
      </div>
    </article>)}
  </section>

  <section class="experience-section" id="experience">
    <div class="experience-intro"><p class="eyebrow">REAL-WORLD PATCH NOTES</p><h2>Learning by<br /><em>shipping.</em></h2></div>
    <div class="experience-list">{experience.map((item) => <ExperienceEntry item={item} />)}</div>
  </section>

  <section class="manifesto-section" id="approach">
    <div class="manifesto-top"><p class="eyebrow">THE WAY I SEE IT</p><span>NO SHORTCUTS. JUST CURIOSITY.</span></div>
    <h2 data-manifesto>Good software<br />should feel <i>obvious.</i><br /><span>Getting there isn't.</span></h2>
    <div class="manifesto-bottom"><p>I enjoy the whole puzzle: understanding a problem, choosing the right tools, building the thing, and caring enough to make the details work.</p><div class="manifesto-symbol">✳</div></div>
  </section>

  <section class="skills-section" id="toolkit">
    <div class="skills-heading"><p class="eyebrow">CURRENTLY IN MY TOOLBOX</p><h2>Things I<br /><em>speak.</em></h2></div>
    <div class="skills-cloud">{skills.map((group, i) => <div class="skill-row" data-reveal><span>{group.title}</span><p>{group.items.map((item) => <b>{item}</b>)}</p></div>)}</div>
  </section>

  <section class="background-section" id="background">
    <div class="background-title"><p class="eyebrow">THE BACKSTORY</p><h2>Still in<br /><em>progress.</em></h2></div>
    <div class="background-content">
      <div class="education-list"><h3>EDUCATION</h3>{education.map((item) => <article><span>{item.period}</span><div><b>{item.institution}</b><p>{item.qualification}</p></div><strong>{item.result}</strong></article>)}</div>
      <div class="recognition-list"><h3>OUTSIDE THE BUILD LOG</h3>{recognition.map((item) => <article><div><b>{item.title}</b><p>{item.description}</p></div>{item.link && <a href={item.link} target="_blank" rel="noopener noreferrer">↗</a>}</article>)}</div>
    </div>
  </section>
  <script>import "../scripts/motion";</script>
</BaseLayout>
