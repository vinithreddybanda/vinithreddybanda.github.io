---
import Shell from "../layouts/Shell.astro";
import { projects, experience, skills, recognition, publicWork } from "../data/content";
const projectNotes = {
  "simp-music": "A listening room",
  "status-saver": "A pocket gallery",
  "journal-ai": "A quiet writing desk",
  "care-schedule": "A calmer clinic",
  "livevoicex": "A voice in many languages",
  "nexus-ai": "A city that can listen"
};
const projectKinds = {
  "simp-music": "music",
  "status-saver": "gallery",
  "journal-ai": "journal",
  "care-schedule": "calendar",
  "livevoicex": "voice",
  "nexus-ai": "city"
};
---
<Shell>
  <section class="hero" id="home" aria-labelledby="hero-title">
    <div class="hero-sky" aria-hidden="true"></div>
    <div class="hero-overline"><span>AN INDEPENDENT LITTLE CORNER OF THE INTERNET</span><span>17° 23' N&nbsp; / &nbsp;78° 29' E</span></div>
    <div class="hero-copy">
      <p class="handwritten hello-note">Hello, traveller!</p>
      <p class="eyebrow"><span class="tiny-flower">✳</span> SOFTWARE ENGINEER · PRODUCT BUILDER</p>
      <h1 id="hero-title">I make<br /><em>useful</em> things<br />for people<span class="period">.</span></h1>
      <p class="hero-description">I'm Vinith. I build software across Android, web, backend and applied AI. This is a small world of the things I've made, learned and shipped.</p>
      <div class="hero-actions">
        <a class="button button-primary" href="#work">Wander through my work <span>↘</span></a>
        <a class="quiet-link" href="#about">A little about me <span>↗</span></a>
      </div>
      <div class="hero-signoff"><span class="signoff-line"></span><span>Built with curiosity, somewhere in India.</span></div>
    </div>
    <div class="world-stage" data-world-stage>
      <canvas id="storybook-world" aria-label="A slowly rotating, hand-painted miniature world with tiny houses, trees and winding roads"></canvas>
      <div class="world-fallback" aria-hidden="true">
        <div class="fallback-planet"><span></span><i></i><b></b><em></em></div>
        <div class="fallback-cloud cloud-one"></div><div class="fallback-cloud cloud-two"></div>
      </div>
      <div class="world-caption"><span class="caption-dot"></span><span>MY WORLD, IN MINIATURE</span><span>DRAG TO LOOK AROUND</span></div>
      <div class="floating-note note-one"><span class="note-doodle">✳</span><span>Ideas grow<br />here</span></div>
      <div class="floating-note note-two"><span class="note-doodle">⌁</span><span>Built one<br />commit at a time</span></div>
    </div>
    <div class="hero-bottomline"><span>ANDROID</span><i></i><span>FULL STACK</span><i></i><span>APPLIED AI</span><span class="scroll-hint">SCROLL A LITTLE <b>↓</b></span></div>
  </section>

  <section class="intro-section section-wrap" data-reveal>
    <div class="section-label"><span>01 / A QUICK INTRODUCTION</span><span class="label-flower">✳</span></div>
    <div class="intro-layout">
      <h2>Curious by nature.<br /><em>Builder by choice.</em></h2>
      <div class="intro-copy">
        <p>I like taking an idea from a scribble to something people can actually use. Sometimes that means tuning an Android interaction. Sometimes it's a backend, a tiny AI experiment, or fixing the unglamorous edge case.</p>
        <p>The common thread: thoughtful engineering, useful details and a little bit of play.</p>
        <a class="underlined-link" href="#about">Get to know the person behind it <span>↗</span></a>
      </div>
    </div>
    <div class="intro-stamps"><span>THINK</span><i>✳</i><span>MAKE</span><i>✳</i><span>TEST</span><i>✳</i><span>REPEAT</span></div>
  </section>

  <section class="work-section" id="work">
    <div class="section-wrap work-inner">
      <div class="section-label"><span>02 / THINGS I'VE MADE</span><span>{projects.length} SMALL WORLDS</span></div>
      <div class="work-heading" data-reveal>
        <div><p class="handwritten section-note">A few favourites</p><h2>Made with<br /><em>purpose.</em></h2></div>
        <p>Different problems, different tools. Each project taught me something worth keeping.</p>
      </div>
      <div class="project-grid">
        {projects.map((project, index) => (
          <article class="project-card" data-reveal style={`--card-delay:${(index % 2) * 90}ms`}>
            <div class={`project-art art-${projectKinds[project.slug]}`}>
              <div class="art-scribble">{project.no}</div>
              {project.slug === "simp-music" && <div class="art-object vinyl-object"><div class="vinyl-disc"><i></i><b></b></div><span class="music-note note-a">♪</span><span class="music-note note-b">♫</span></div>}
              {project.slug === "status-saver" && <div class="art-object gallery-object"><i></i><b></b><span></span></div>}
              {project.slug === "journal-ai" && <div class="art-object journal-object"><span>dear<br /><em>thoughts.</em></span><i></i><b></b></div>}
              {project.slug === "care-schedule" && <div class="art-object calendar-object"><div class="calendar-sheet"><small>YOUR WEEK</small><b>24</b><i></i><i></i><i></i></div><span>+</span></div>}
              {project.slug === "livevoicex" && <div class="art-object voice-object"><span>voice</span><div>{Array.from({length: 13}, (_, i) => <i style={`--bar:${18 + ((i * 17) % 50)}px`}></i>)}</div><small>LISTEN · UNDERSTAND · CONNECT</small></div>}
              {project.slug === "nexus-ai" && <div class="art-object city-object"><span class="city-pin">+</span><i></i><b></b><em></em><small>ONE CITY / MANY STORIES</small></div>}
              <div class="art-bottom"><span>{project.type.toUpperCase()}</span><span>{project.year}</span></div>
            </div>
            <div class="project-meta"><div><span class="project-number">PROJECT {project.no}</span><h3>{project.name}</h3></div><span class="project-arrow">↗</span></div>
            <p class="project-note handwritten">{projectNotes[project.slug]}</p>
            <p class="project-summary">{project.summary}</p>
            <div class="stack-list">{project.stack.slice(0, 4).map((skill) => <span>{skill}</span>)}</div>
            <div class="project-footer">
              <span>{project.status}</span>
              {project.url ? <a href={project.url} target="_blank" rel="noreferrer">Explore project <b>↗</b></a> : <span class="no-link">Build in progress</span>}
            </div>
          </article>
        ))}
      </div>
      <div class="work-footer-note"><span class="handwritten">More experiments are always growing...</span><a href="https://github.com/vinithreddybanda" target="_blank" rel="noreferrer" class="underlined-link">Find the rest on GitHub <span>↗</span></a></div>
    </div>
  </section>

  <section class="about-section section-wrap" id="about">
    <div class="section-label"><span>03 / THE HUMAN BEHIND THE KEYBOARD</span><span>VB—001</span></div>
    <div class="about-top" data-reveal>
      <div class="about-portrait-wrap">
        <div class="portrait-frame"><img src="https://avatars.githubusercontent.com/u/116493221?v=4" alt="Vinith Reddy Banda" loading="lazy" /><span class="portrait-corner">A FRIENDLY FACE<br />FROM THE INTERNET</span></div>
        <span class="portrait-caption handwritten">That's me, hello!</span>
      </div>
      <div class="about-intro">
        <p class="handwritten about-hello">A little note about me</p>
        <h2>Hi, I'm<br /><em>Vinith.</em></h2>
        <p>I'm an Informat