    <script>
      document.documentElement.classList.add("js");
      const header = document.querySelector("#top");
      let ticking = false;
      const syncHeader = () => {
        header.classList.toggle("is-scrolled", window.scrollY > 18);
        ticking = false;
      };
      addEventListener("scroll", () => {
        if (!ticking) {
          requestAnimationFrame(syncHeader);
          ticking = true;
        }
      }, { passive: true });
      syncHeader();

      const revealObserver = new IntersectionObserver((entries, observer) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("in-view");
            observer.unobserve(entry.target);
          }
        }
      }, { threshold: 0.12, rootMargin: "0px 0px -8% 0px" });
      document.querySelectorAll(".reveal").forEach((node) => revealObserver.observe(node));

      const depthObserver = new IntersectionObserver((entries) => {
        for (const entry of entries) entry.target.classList.toggle("in-focus", entry.isIntersecting);
      }, { threshold: 0.18, rootMargin: "-22% 0px -22% 0px" });
      document.querySelectorAll(".depth").forEach((node) => depthObserver.observe(node));


      // Keep the page progress indicator independent from the artwork's continuous loops.
      const syncPageProgress = () => {
        const doc = document.documentElement;
        const maxScroll = Math.max(1, doc.scrollHeight - window.innerHeight);
        doc.style.setProperty("--page-progress", String(Math.max(0, Math.min(1, window.scrollY / maxScroll))));
      };
      addEventListener("scroll", syncPageProgress, { passive: true });
      addEventListener("resize", syncPageProgress, { passive: true });
      syncPageProgress();

      const hero = document.querySelector(".hero");
      let heroFrame = false;
      addEventListener("scroll", () => {
        if (heroFrame || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        heroFrame = true;
        requestAnimationFrame(() => {
          const y = Math.min(window.scrollY, window.innerHeight);
          hero.style.setProperty("--glow-y", (y * .12) + "px");
          heroFrame = false;
        });
      }, { passive: true });
    </script>
  </body>
</html>
