---
const projects = [
  {
    number: "01",
    name: "CareSchedule",
    type: "Healthcare platform",
    year: "2026",
    summary: "A clinic operations platform built around the realities of scheduling care.",
    description: "Developed during my Cognizant .NET training. The system uses six-layer Clean Architecture, 148 REST APIs and role-based workflows. Its appointment engine considers provider availability, leave, holidays and resource constraints before offering a slot.",
    stack: [".NET", "ASP.NET Core", "React", "Entity Framework Core", "SQL Server"],
    link: null,
    linkLabel: "Case study"
  },
  {
    number: "02",
    name: "JournalAI",
    type: "AI · Full stack · DevOps",
    year: "2025",
    summary: "A private journaling space that turns reflection into useful patterns.",
    description: "A full-stack journaling application with AI-assisted insights. The project explores Supabase-backed data, containerization, CI/CD, Kubernetes orchestration and Azure deployment.",
    stack: ["Next.js", "TypeScript", "Supabase", "Groq", "Docker", "Kubernetes", "Azure"],
    link: "https://github.com/vinithreddybanda/journalai",
    linkLabel: "View repository"
  },
  {
    number: "03",
    name: "WhatsApp Status Saver",
    type: "Android · Kotlin",
    year: "2026",
    summary: "A native Android gallery for viewing, saving and sharing status media.",
    description: "A privacy-focused Android app that works locally on-device. Built with Kotlin and Jetpack Compose, with progressive media loading and a Pinterest-inspired gallery experience.",
    stack: ["Kotlin", "Jetpack Compose", "Android", "MediaStore"],
    link: "https://github.com/vinithreddybanda/WhatsapStatusSaver",
    linkLabel: "View repository"
  },
  {
    number: "04",
    name: "LiveVoiceX",
    type: "Applied AI · Voice",
    year: "2025",
    summary: "Real-time voice transcription designed for multilingual conversations.",
    description: "An in-progress voice transcription experience built around live speech recognition and multilingual support.",
    stack: ["React", "TypeScript", "Deepgram"],
    link: "https://github.com/vinithreddybanda/livevoicex",
    linkLabel: "View repository"
  }
];

const skills = [
  ["Backend", "C#", ".NET", "ASP.NET Core", "Entity Framework Core", "REST APIs"],
  ["Frontend", "TypeScript", "React", "Next.js", "Angular"],
  ["Mobile & systems", "Kotlin", "Android", "Java", "C++", "JNI"],
  ["Data & delivery", "SQL Server", "PostgreSQL", "Supabase", "Docker", "Azure", "CI/CD"]
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#11110f" />
    <meta name="description" content="Vinith Reddy Banda is a software engineer working across full-stack development, Android and applied AI." />
    <meta property="og:title" content="Vinith Reddy Banda · Software Engineer" />
    <meta property="og:description" content="Engineering thoughtful software across systems, interfaces and applied AI." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://vinithreddybanda.github.io/" />
    <title>Vinith Reddy Banda · Software Engineer</title>
    <style>
      :root {
        color-scheme: dark;
        --bg: #11110f;
        --surface: #191916;
        --ink: #f0efe9;
        --muted: #a09f97;
        --quiet: #77766f;
        --line: rgba(240,239,233,.16);
        --soft-line: rgba(240,239,233,.09);
        --accent: #c9d2b8;
        --gutter: clamp(22px, 6vw, 92px);
        --sans: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "Helvetica Neue", Inter, ui-sans-serif, system-ui, sans-serif;
        --serif: "Iowan Old Style", "Baskerville", "Palatino Linotype", Georgia, serif;
        --mono: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
        --ease: cubic-bezier(.2,.75,.25,1);
      }
      :root[data-theme="light"] {
        color-scheme: light;
        --bg: #f3f2ed;
        --surface: #e9e8e1;
        --ink: #171714;
        --muted: #5f5f58;
        --quiet: #85847b;
        --line: rgba(23,23,20,.19);
        --soft-line: rgba(23,23,20,.1);
        --accent: #53634a;
      }
      *,*::before,*::after{box-sizing:border-box}
      html{background:var(--bg);scroll-behavior:smooth;scroll-padding-top:92px}
      body{margin:0;min-width:320px;background:var(--bg);color:var(--ink);font-family:var(--sans);-webkit-font-smoothing:antialiased;overflow-x:hidden;transition:background .3s,color .3s}
      ::selection{background:var(--accent);color:var(--bg)}
      a{color:inherit;text-decoration:none}
      button{font:inherit}
      a:focus-visible,button:focus-visible,summary:focus-visible{outline:2px solid var(--accent);outline-offset:5px}
      .shell{width:100%;max-width:1600px;margin-inline:auto;padding-inline:var(--gutter)}
      .mono{font:10px/1.55 var(--mono);letter-spacing:.075em;text-transform:uppercase}
      .muted{color:var(--muted)}
      .skip{position:absolute;z-index:100;top:10px;left:10px;padding:12px 16px;background:var(--ink);color:var(--bg);transform:translateY(-150%)}
      .skip:focus{transform:none}
      .header{position:fixed;z-index:50;inset:0 0 auto;height:72px;border-bottom:1px solid transparent;transition:background .3s,border-color .3s,backdrop-filter .3s}
      .header.scrolled{background:color-mix(in srgb,var(--bg) 84%,transparent);border-color:var(--soft-line);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px)}
      .nav{height:100%;display:flex;align-items:center;justify-content:space-between;gap:20px}
      .wordmark{font-size:15px;font-weight:650;letter-spacing:-.07em;white-space:nowrap}
      .nav-links{display:flex;align-items:center;gap:clamp(17px,3vw,42px)}
      .nav-links a,.theme-toggle{font:10px var(--mono);letter-spacing:.055em;text-transform:uppercase;color:var(--muted);transition:color .2s}
      .nav-links a:hover,.theme-toggle:hover{color:var(--ink)}
      .nav-actions{display:flex;align-items:center;gap:clamp(16px,2.5vw,34px)}
      .theme-toggle{padding:8px 0;border:0;background:none;cursor:pointer}
      .hero{min-height:min(900px,100svh);min-height:max(700px,100svh);display:flex;align-items:flex-end;padding-top:150px;padding-bottom:clamp(48px,7vw,96px)}
      .hero-inner{width:100%}
      .hero-top{display:flex;justify-content:space-between;gap:20px;margin-bottom:clamp(65px,12vh,145px);color:var(--muted)}
      .hero-top span:last-child{text-align:right}
      .eyebrow{display:flex;align-items:center;gap:12px;color:var(--muted)}
      .eyebrow::before{content:"";width:24px;height:1px;background:var(--accent)}
      h1{max-width:1200px;margin:0;font-size:clamp(68px,12.5vw,190px);font-weight:570;line-height:.83;letter-spacing:-.105em}
      h1 span{display:block}
      h1 .serif{font-family:var(--serif);font-weight:400;font-style:italic;letter-spacing:-.09em}
      .hero-bottom{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:end;gap:36px;margin-top:clamp(60px,10vh,120px)}
      .hero-copy{max-width:470px;margin:0;color:var(--muted);font-size:clamp(16px,1.65vw,21px);line-height:1.65;letter-spacing:-.035em}
      .hero-copy strong{color:var(--ink);font-weight:500}
      .hero-side{display:flex;gap:clamp(24px,5vw,72px)}
      .hero-side p{margin:8px 0 0;font-size:12px;color:var(--ink)}
      .section{padding-block:clamp(105px,14vw,205px)}
      .section-head{display:flex;justify-content:space-between;gap:20px;padding-bottom:17px;border-bottom:1px solid var(--line);color:var(--muted)}
      .section-title{display:flex;justify-content:space-between;align-items:end;gap:30px;padding:clamp(48px,7vw,92px) 0 clamp(54px,8vw,112px)}
      .section-title h2{margin:0;font-size:clamp(58px,10vw,145px);font-weight:520;line-height:.82;letter-spacing:-.1em}
      .section-title h2 em{font-family:var(--serif);font-weight:400;letter-spacing:-.075em}
      .section-title p{max-width:270px;margin:0 0 5px;color:var(--muted);font-size:13px;line-height:1.8}
      .project-list{border-top:1px solid var(--line)}
      .project{display:grid;grid-template-columns:clamp(30px,5vw,72px) minmax(0,1fr) auto;gap:clamp(14px,3vw,44px);align-items:start;padding:clamp(38px,6vw,78px) 0;border-bottom:1px solid var(--line)}
      .project-number{padding-top:9px;color:var(--quiet)}
      .project-main{min-width:0}
      .project-type{margin-bottom:clamp(18px,2.5vw,30px);color:var(--muted)}
      .project-name{margin:0;font-size:clamp(39px,6.7vw,92px);font-weight:520;line-height:.94;letter-spacing:-.085em;overflow-wrap:anywhere}
      .project-summary{max-width:570px;margin:20px 0 0;color:var(--muted);font-size:clamp(14px,1.35vw,17px);line-height:1.8}
      .project-side{display:flex;flex-direction:column;align-items:flex-end;gap:24px;padding-top:5px}
      .project-year{color:var(--quiet)}
      .project-link{display:inline-flex;align-items:center;gap:10px;padding-bottom:7px;border-bottom:1px solid var(--line);font:10px var(--mono);letter-spacing:.045em;text-transform:uppercase;white-space:nowrap;transition:gap .25s,border-color .25s}
      .project-link:hover{gap:16px;border-color:var(--ink)}
      .project-link span{font-size:15px}
      .project-more{grid-column:2/4;margin-top:2px}
      .project-more summary{display:inline-flex;align-items:center;gap:10px;cursor:pointer;list-style:none;color:var(--muted);font:10px var(--mono);letter-spacing:.055em;text-transform:uppercase}
      .project-more summary::-webkit-details-marker{display:none}
      .project-more summary::after{content:"+";font:16px var(--sans);transition:transform .25s}
      .project-more[open] summary::after{transform:rotate(45deg)}
      .project-detail{max-width:720px;padding-top:18px;animation:appear .35s var(--ease) both}
      .project-detail p{margin:0 0 18px;color:var(--muted);font-size:13px;line-height:1.9}
      .tags{display:flex;flex-wrap:wrap;gap:8px}
      .tags span{padding:7px 9px;border:1px solid var(--soft-line);color:var(--muted);font:9px var(--mono)}
      @keyframes appear{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
      .about-lead{max-width:1280px;margin:clamp(48px,7vw,92px) 0 0;font-size:clamp(36px,7.2vw,104px);font-weight:500;line-height:1.04;letter-spacing:-.075em}
      .about-lead em{font-family:var(--serif);font-weight:400;letter-spacing:-.065em}
      .about-grid{display:grid;grid-template-columns:minmax(180px,.7fr) minmax(0,1.3fr);gap:clamp(40px,10vw,145px);margin-top:clamp(72px,11vw,150px)}
      .about-note{max-width:360px;margin:0;color:var(--muted);font-size:14px;line-height:2}
      .facts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:34px 48px}
      .fact{min-width:0;padding-top:14px;border-top:1px solid var(--line)}
      .fact h3{margin:0 0 14px;color:var(--muted);font:9px var(--mono);letter-spacing:.08em;text-transform:uppercase}
      .fact p{margin:0;color:var(--ink);font-size:13px;line-height:1.9}
      .fact .sub{color:var(--muted)}
      .skills{display:grid;grid-template-columns:minmax(180px,.7fr) minmax(0,1.3fr);gap:clamp(40px,10vw,145px);margin-top:clamp(72px,10vw,130px);padding-top:18px;border-top:1px solid var(--line)}
      .skills-label{color:var(--muted)}
      .skill-groups{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:30px 40px}
      .skill-group h3{margin:0 0 12px;color:var(--muted);font:9px var(--mono);letter-spacing:.08em;text-transform:uppercase}
      .skill-group p{margin:0;color:var(--ink);font-size:14px;line-height:1.9}
      .contact{padding-top:clamp(100px,15vw,210px);padding-bottom:28px}
      .contact-title{margin:clamp(50px,8vw,100px) 0;font-size:clamp(66px,13vw,185px);font-weight:520;line-height:.84;letter-spacing:-.105em}
      .contact-title em{font-family:var(--serif);font-weight:400;letter-spacing:-.075em}
      .contact-bottom{display:flex;justify-content:space-between;align-items:end;gap:28px;padding-bottom:clamp(75px,11vw,145px)}
      .contact-bottom p{margin:0;color:var(--muted);font-size:13px;line-height:1.9}
      .mail{display:inline-flex;align-items:center;gap:18px;padding-bottom:10px;border-bottom:1px solid var(--ink);font-size:clamp(16px,1.6vw,20px);transition:gap .25s}
      .mail:hover{gap:27px}
      .mail span{font-size:19px}
      footer{display:flex;justify-content:space-between;gap:20px;padding-top:18px;border-top:1px solid var(--line);color:var(--muted)}
      .footer-links{display:flex;gap:24px}
      .footer-links a:hover{color:var(--ink)}
      .reveal{opacity:1;transform:none}
      .js .reveal{opacity:0;transform:translateY(18px);transition:opacity .7s var(--ease),transform .7s var(--ease)}
      .js .reveal.visible{opacity:1;transform:none}
      @media(max-width:760px){
        .header{height:64px}
        .hero{min-height:850px;min-height:100svh;padding-top:120px}
        h1{font-size:clamp(65px,13.8vw,105px)}
        .hero-bottom{grid-template-columns:1fr;gap:30px;margin-top:62px}
        .hero-side{justify-content:flex-start}
        .section-title{align-items:flex-start;flex-direction:column;gap:22px}
        .section-title p{max-width:370px}
        .project{grid-template-columns:26px minmax(0,1fr);gap:12px}
        .project-side{grid-column:2;grid-row:2;flex-direction:row;align-items:center;justify-content:space-between;padding-top:4px}
        .project-more{grid-column:2;grid-row:3}
        .about-grid,.skills{grid-template-columns:1fr;gap:34px}
        .about-note{max-width:520px}
        .contact-title{font-size:clamp(68px,14vw,112px)}
      }
      @media(max-width:480px){
        :root{--gutter:21px}
        .nav-links{gap:15px}
        .nav-links a{font-size:9px}
        .nav-actions{gap:14px}
        .theme-toggle{font-size:9px}
        .hero{min-height:820px;min-height:100svh;padding-bottom:38px}
        .hero-top{margin-bottom:65px;font-size:8px}
        .hero-top span:last-child{max-width:110px}
        h1{font-size:clamp(54px,13.8vw,72px)}
        .hero-side{gap:30px}
        .hero-side p{font-size:11px}
        .section{padding-block:90px}
        .section-head{font-size:8px}
        .section-title h2{font-size:clamp(58px,15vw,76px)}
        .project{padding-block:38px}
        .project-name{font-size:clamp(38px,9.7vw,48px)}
        .project-summary{margin-top:16px;font-size:14px}
        .project-type{font-size:8px}
        .facts{gap:28px 20px}
        .fact p{font-size:12px}
        .skill-groups{gap:24px 18px}
        .skill-group p{font-size:12px}
        .contact-title{font-size:clamp(60px,15vw,78px)}
        .contact-bottom{align-items:flex-start;flex-direction:column;gap:28px}
        footer{flex-direction:column;font-size:9px}
      }
      @media(max-width:350px){
        .nav-links{gap:10px}
        .nav-links a{font-size:8px}
        .theme-toggle{font-size:8px}
        h1{font-size:51px}
        .project-name{font-size:36px}
      }
      @media(hover:none),(pointer:coarse){.mail:hover{gap:18px}.project-link:hover{gap:10px}}
      @media(prefers-reduced-motion:reduce){
        *,*::before,*::after{scroll-behavior:auto!important;animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}
        .js .reveal{opacity:1;transform:none}
      }
    </style>
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem("portfolio-theme");
          const preferred = window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
          document.documentElement.dataset.theme = saved || preferred;
        } catch (_) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="header" id="header">
      <div class="shell nav">
        <a class="wordmark" href="#home" aria-label="Vinith Reddy Banda home">V/RB.</a>
        <div class="nav-actions">
          <nav class="nav-links" aria-label="Main navigation">
            <a href="#work">Work</a>
            <a href="#about">About</a>
            <a href="#contact">Contact</a>
          </nav>
          <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Switch colour theme">Light</button>
        </div>
      </div>
    </header>

    <main id="main">
      <section class="hero shell" id="home">
        <div class="hero-inner">
          <div class="hero-top mono">
            <span class="eyebrow">Software engineer · Portfolio 2026</span>
            <span>Hyderabad, India</span>
          </div>
          <h1><span>Vinith Reddy</span><span class="serif">Banda.</span></h1>
          <div class="hero-bottom">
            <p class="hero-copy"><strong>I build software that works beneath the surface.</strong> From backend systems to mobile interfaces, I care about the engineering and the experience.</p>
            <div class="hero-side">
              <div><span class="mono muted">Working across</span><p>Full stack · Android · AI</p></div>
              <div><span class="mono muted">Currently</span><p>Programmer Analyst</p></div>
            </div>
          </div>
        </div>
      </section>

      <section class="section" id="work">
        <div class="shell">
          <div class="section-head mono reveal"><span>01 / Selected work</span><span>Things made useful</span></div>
          <div class="section-title reveal">
            <h2>Selected<br /><em>work.</em></h2>
            <p>A selection of engineering projects, experiments and products. Each one started with a problem worth solving.</p>
          </div>
          <div class="project-list">
            {projects.map((project) => (
              <article class="project reveal">
                <span class="project-number mono">{project.number}</span>
                <div class="project-main">
                  <div class="project-type mono">{project.type}</div>
                  <h3 class="project-name">{project.name}</h3>
                  <p class="project-summary">{project.summary}</p>
                </div>
                <div class="project-side">
                  <span class="project-year mono">{project.year}</span>
                  {project.link ? <a class="project-link" href={project.link} target="_blank" rel="noreferrer">{project.linkLabel}<span aria-hidden="true">↗</span></a> : <span class="project-year mono">Selected work</span>}
                </div>
                <details class="project-more">
                  <summary>Inside the build</summary>
                  <div class="project-detail">
                    <p>{project.description}</p>
                    <div class="tags">{project.stack.map((item) => <span>{item}</span>)}</div>
                  </div>
                </details>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section" id="about">
        <div class="shell">
          <div class="section-head mono reveal"><span>02 / About</span><span>Engineering, with curiosity</span></div>
          <p class="about-lead reveal">Good software is <em>considered.</em> It solves the right problem, stays understandable, and makes the complicated feel simple.</p>
          <div class="about-grid reveal">
            <p class="about-note">I enjoy moving between layers of a product: designing APIs, working with data, building interfaces and exploring native systems. I’m interested in the decisions that make software reliable, useful and pleasant to use.</p>
            <div class="facts">
              <div class="fact"><h3>Education</h3><p>B.E. Information Technology<br />Chaitanya Bharathi Institute of Technology<br /><span class="sub">8.30 CGPA · 2023–2026</span></p></div>
              <div class="fact"><h3>Earlier education</h3><p>Diploma, Computer Engineering<br />Government Polytechnic College, Warangal<br /><span class="sub">9.74 CGPA · 2020–2023</span></p></div>
              <div class="fact"><h3>Experience</h3><p>Programmer Analyst<br />Cognizant · 2026</p></div>
              <div class="fact"><h3>Recognition</h3><p>Microsoft AI for Good · Top 100<br />GFG HackWeek · Rank 6<br />NxtWave Buildathon · State level</p></div>
            </div>
          </div>
          <div class="skills reveal">
            <div class="skills-label mono">Tools & technologies</div>
            <div class="skill-groups">
              {skills.map(([group, ...items]) => (
                <div class="skill-group">
                  <h3>{group}</h3>
                  <p>{items.join(" · ")}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section class="contact" id="contact">
        <div class="shell">
          <div class="section-head mono reveal"><span>03 / Contact</span><span>Start a conversation</span></div>
          <h2 class="contact-title reveal">Have something<br /><em>in mind?</em></h2>
          <div class="contact-bottom reveal">
            <p>For thoughtful collaborations,<br />interesting problems and good conversations.</p>
            <a class="mail" href="mailto:vinithreddybanda@gmail.com">vinithreddybanda@gmail.com <span aria-hidden="true">↗</span></a>
          </div>
          <footer class="mono">
            <span>© {new Date().getFullYear()} Vinith Reddy Banda</span>
            <div class="footer-links">
              <a href="https://github.com/vinithreddybanda" target="_blank" rel="noreferrer">GitHub</a>
              <a href="mailto:vinithreddybanda@gmail.com">Email</a>
            </div>
          </footer>
        </div>
      </section>
    </main>

    <script is:inline>
      document.documentElement.classList.add("js");
      const header = document.getElementById("header");
      const themeButton = document.getElementById("theme-toggle");
      const setThemeLabel = () => {
        const light = document.documentElement.dataset.theme === "light";
        themeButton.textContent = light ? "Dark" : "Light";
        themeButton.setAttribute("aria-label", light ? "Switch to dark theme" : "Switch to light theme");
      };
      setThemeLabel();
      themeButton.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "light" ? "dark" : "light";
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem("portfolio-theme", next); } catch (_) {}
        setThemeLabel();
      });

      const syncHeader = () => header.classList.toggle("scrolled", window.scrollY > 12);
      syncHeader();
      window.addEventListener("scroll", syncHeader, { passive: true });

      const revealNodes = document.querySelectorAll(".reveal");
      if ("IntersectionObserver" in window && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const observer = new IntersectionObserver((entries, current) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("visible");
              current.unobserve(entry.target);
            }
          });
        }, { threshold: 0.08, rootMargin: "0px 0px -4% 0px" });
        revealNodes.forEach((node) => observer.observe(node));
      } else {
        revealNodes.forEach((node) => node.classList.add("visible"));
      }
    </script>
