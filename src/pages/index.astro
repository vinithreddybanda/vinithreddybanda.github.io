---
import Shell from "../layouts/Shell.astro"; import {projects} from "../data/content";
---
<Shell title="Vinith Reddy Banda — Software Engineer" description="Android, full-stack engineering and applied AI. Selected projects, open-source work and contact.">
<section class="home-hero section-pad"><div class="section-index"><span>SOFTWARE ENGINEER / PRODUCT BUILDER</span><span>HYDERABAD, INDIA · 17°23' N</span></div><div class="home-hero-grid"><div class="home-hero-copy"><p class="eyebrow">PORTFOLIO / 2026</p><h1 class="display-title">I build<br/><em>software</em><br/>that works<span>.</span></h1><div class="hero-bottom-copy"><p>I'm Vinith. I work across Android, full-stack engineering and applied AI, turning useful ideas into working products.</p><a class="text-link" href="#selected-work">EXPLORE SELECTED WORK ↓</a></div></div><div class="hero-object"><div class="hero-object-orbit"></div><div class="hero-object-orbit orbit-two"></div><div class="hero-object-core"><span>VB</span><i>✳</i></div><small>DESIGN / ENGINEERING</small></div></div><div class="hero-footline"><span>ANDROID · WEB · BACKEND · AI</span><span>INDEPENDENT / OPEN SOURCE</span><span>SCROLL TO EXPLORE ↓</span></div></section>
<section class="work-section-home section-pad" id="selected-work"><div class="section-index"><span>01 / SELECTED WORK</span><span>{projects.length} PROJECTS / 2025—26</span></div><div class="section-heading-row"><h2 class="section-heading">Selected<br/><em>work.</em></h2><p>Products, tools and experiments. Open a project for its working brief, technical stack and build notes.</p></div><div class="project-grid">{projects.map((p,i)=><a class="project-card rebuilt-card" href={"/studio/"+p.slug+"/"}><div class={"project-art art-"+(i+1)}><div class="art-topline"><span>{p.no} / {p.year}</span><span>{p.status.toUpperCase()}</span></div><div class="art-stage"><div class="project-preview"><small>{p.type.toUpperCase()}</small><b>{p.name}</b><em>{["PLAYBACK / ANDROID","LOCAL MEDIA / DEVICE","AI / PERSONAL WRITING","CLINIC / SCHEDULING","LIVE SPEECH / 40+ LANGUAGES","CIVIC / ISSUE ROUTING"][i]}</em><div class="preview-graphic"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div><span>OPEN PROJECT FILE ↗</span></div></div><span class="art-open">↗</span></div><div class="project-card-info"><div><span>{p.type.toUpperCase()}</span><h3>{p.name}</h3></div><b>↗</b></div><p class="project-summary">{p.summary}</p><div class="card-stack">{p.stack.slice(0,4).map(s=><span>{s}</span>)}</div></a>)}</div><div class="work-index-link"><span>TECHNICAL DETAILS / STACK / BUILD NOTES</span><a class="text-link" href="/studio/">OPEN PROJECT INDEX ↗</a></div></section>
<section class="open-source-band section-pad"><div class="section-index"><span>02 / OPEN SOURCE</span><span>GITHUB / LIVE PROFILE</span></div><div class="open-source-row"><h2 class="section-heading">Code in<br/><em>the open.</em></h2><div><p>Android apps, experiments and engineering work. Follow the repositories and see what is moving.</p><a class="text-link" href="https://github.com/vinithreddybanda" target="_blank" rel="noreferrer">GITHUB PROFILE ↗</a></div></div><div class="github-stats rebuilt-stats" id="github-live"><div><span>PUBLIC REPOSITORIES</span><b data-github-stat="public_repos">—</b></div><div><span>FOLLOWERS</span><b data-github-stat="followers">—</b></div><div><span>PUBLIC STARS</span><b data-github-stat="stars">—</b></div></div></section>
<section class="home-about section-pad"><div class="section-index"><span>03 / THE PERSON BEHIND THE WORK</span><span>ABOUT / VB—001</span></div><div class="home-about-row"><h2 class="section-heading">Engineering<br/><em>with range.</em></h2><div><p>Information Technology at CBIT. Computer Engineering before that. Working across Android, .NET, web and applied AI.</p><a class="text-link" href="/about/">READ THE BACKGROUND ↗</a></div></div></section><section class="home-contact section-pad"><span>HAVE A PROJECT OR A GOOD PROBLEM?</span><div><h2>Let's talk<span>.</span></h2><a href="/contact/">↗</a></div></section></Shell>