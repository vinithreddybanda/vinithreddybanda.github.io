---
const projects = [
  {
    name: "CareSchedule",
    type: "Healthcare systems",
    year: "2026",
    summary: "Making the moving parts of clinic operations work together.",
    detail: "Built during my .NET Full Stack internship at Cognizant. A clinic operations platform shaped around six-layer Clean Architecture, 148 REST APIs and six role-based workflows. Its appointment engine accounts for provider availability, leave, holidays and resource constraints before offering a slot.",
    stack: ".NET · React · Entity Framework Core · SQL Server",
    visual: "148",
    visualLabel: "REST endpoints"
  },
  {
    name: "JournalAI",
    type: "Applied AI",
    year: "2025",
    summary: "A private space for reflection, with patterns that emerge over time.",
    detail: "A journaling experience that turns personal entries into structured mood insights. Designed around a cloud-ready architecture and an automated delivery pipeline.",
    stack: "Next.js · TypeScript · Supabase · Azure · Docker",
    visual: "J",
    visualLabel: "A quieter mind"
  },
  {
    name: "Activities for Discord",
    type: "Android systems",
    year: "2025",
    summary: "Taking desktop presence controls somewhere they were never meant to be.",
    detail: "An Android application bringing mobile control to Discord Rich Presence through a native integration layer, persistent SDK sessions, JNI and encrypted credential storage.",
    stack: "Android · Java · C++ · JNI · Discord Partner SDK",
    visual: "PR",
    visualLabel: "Presence, rethought"
  }
];
const capabilities = ["C# and .NET", "TypeScript", "React and Next.js", "Java and Kotlin", "C++ and JNI", "SQL and PostgreSQL", "Azure and Docker", "Systems design"];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#000000" />
    <meta name="description" content="Vinith Reddy Banda is a software engineer building thoughtful software across systems and interfaces." />
    <title>Vinith Reddy Banda</title>
    <style>
      :root {
        color-scheme: dark;
        --black: #000;
        --white: #fff;
        --muted: rgba(255,255,255,.62);
        --quiet: rgba(255,255,255,.36);
        --hairline: rgba(255,255,255,.16);
        --gutter: clamp(22px, 6vw, 104px);
        --nav-height: 76px;
        --ease: cubic-bezier(.2,.75,.2,1);
        --sans: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "Helvetica Neue", Inter, ui-sans-serif, system-ui, sans-serif;
      }
      *, *::before, *::after { box-sizing: border-box; }
      html { background: var(--black); scroll-behavior: smooth; scroll-padding-top: var(--nav-height); }
      body { margin: 0; background: var(--black); color: var(--white); font-family: var(--sans); -webkit-font-smoothing: antialiased; overflow-x: clip; }
      body, button, a { font-family: var(--sans); }
      a { color: inherit; text-decoration: none; }
      button { color: inherit; }
      ::selection { color: var(--black); background: var(--white); }
      .wrap { width: min(100%, 1720px); margin-inline: auto; padding-inline: var(--gutter); }
      .topbar { position: fixed; z-index: 20; inset: 0 0 auto; height: var(--nav-height); transition: background .45s ease, border-color .45s ease, backdrop-filter .45s ease; border-bottom: 1px solid transparent; }
      .topbar.scrolled { background: rgba(0,0,0,.72); border-color: rgba(255,255,255,.1); -webkit-backdrop-filter: blur(18px); backdrop-filter: blur(18px); }
      .nav { height: 100%; display: flex; align-items: center; justify-content: space-between; }
      .wordmark { font-size: 15px; font-weight: 650; letter-spacing: -.08em; }
      .navlinks { display: flex; align-items: center; gap: clamp(22px, 3.5vw, 54px); }
      .navlinks a { color: var(--muted); font-size: 12px; transition: color .25s ease; }
      .navlinks a:hover, .navlinks a:focus-visible { color: var(--white); }
      a:focus-visible, button:focus-visible, summary:focus-visible { outline: 2px solid var(--white); outline-offset: 5px; }
      .hero { min-height: 100svh; min-height: 100dvh; display: flex; flex-direction: column; justify-content: flex-end; padding: calc(var(--nav-height) + 10vh) 0 clamp(42px, 7vh, 84px); position: relative; isolation: isolate; }
      .hero:before { content: ""; position: absolute; z-index: -1; width: min(68vw, 1000px); aspect-ratio: 1; right: -28%; top: 2%; border-radius: 50%; background: radial-gradient(circle, rgba(255,255,255,.075), rgba(255,255,255,.018) 34%, transparent 69%); filter: blur(32px); pointer-events: none; }
      .hero-content { width: 100%; }
      .hero-title { font-size: clamp(66px, 13.5vw, 218px); line-height: .79; letter-spacing: -.105em; font-weight: 560; margin: 0; max-width: 1500px; }
      .hero-title span { display: block; }
      .hero-title span:last-child { margin-top: .12em; }
      .hero-bottom { display: grid; grid-template-columns: minmax(0,1fr) auto; align-items: end; gap: 40px; margin-top: clamp(56px, 10vh, 120px); }
      .hero-statement { max-width: 440px; margin: 0; font-size: clamp(16px, 1.65vw, 23px); line-height: 1.55; letter-spacing: -.035em; color: var(--muted); }
      .hero-statement strong { color: var(--white); font-weight: 500; }
      .identity { display: grid; grid-template-columns: auto auto; gap: clamp(24px, 5vw, 72px); padding-bottom: 4px; }
      .identity span { display: block; font-size: 12px; color: var(--muted); white-space: nowrap; }
      .identity strong { display: block; font-size: 14px; font-weight: 500; margin-top: 8px; white-space: nowrap; }
      .section { padding: clamp(112px, 16vw, 230px) 0; }
      .section-heading { display: grid; grid-template-columns: minmax(0,1fr) minmax(180px, 300px); align-items: end; gap: 30px; margin-bottom: clamp(54px, 8vw, 112px); }
      .section-heading h2 { margin: 0; font-size: clamp(48px, 8.8vw, 132px); line-height: .86; letter-spacing: -.095em; font-weight: 520; }
      .section-heading p { max-width: 280px; margin: 0 0 5px auto; color: var(--muted); font-size: 14px; line-height: 1.7; }
      .project-list { display: grid; gap: clamp(82px, 13vw, 190px); }
      .project { display: grid; grid-template-columns: minmax(0,1.1fr) minmax(260px,.9fr); align-items: center; gap: clamp(28px, 7vw, 112px); }
      .project:nth-child(even) { grid-template-columns: minmax(260px,.9fr) minmax(0,1.1fr); }
      .project:nth-child(even) .project-art { order: 2; }
      .project-art { min-height: clamp(260px, 40vw, 590px); display: grid; place-items: center; position: relative; overflow: hidden; background: var(--white); color: var(--black); isolation: isolate; }
      .project-art:before { content: ""; position: absolute; width: 72%; aspect-ratio: 1; border: 1px solid rgba(0,0,0,.22); border-radius: 50%; transform: rotateX(68deg) rotateZ(-28deg) scale(1.12); transition: transform 1.1s var(--ease); }
      .project-art:after { content: ""; position: absolute; inset: 12%; border: 1px solid rgba(0,0,0,.12); transform: perspective(900px) rotateY(-12deg) rotateX(8deg); transition: transform 1.1s var(--ease); }
      .project:hover .project-art:before, .project:focus-within .project-art:before { transform: rotateX(68deg) rotateZ(-12deg) scale(1.28); }
      .project:hover .project-art:after, .project:focus-within .project-art:after { transform: perspective(900px) rotateY(0) rotateX(0); }
      .art-word { position: relative; z-index: 1; font-size: clamp(90px, 19vw, 270px); line-height: .8; letter-spacing: -.12em; font-weight: 650; transition: transform .9s var(--ease), filter .9s var(--ease); }
      .project:hover .art-word { transform: scale(1.06) translateY(-5px); filter: blur(.35px); }
      .art-caption { position: absolute; z-index: 2; bottom: 22px; left: 24px; font-size: 10px; letter-spacing: -.01em; }
      .project-copy { padding-block: 8px; }
      .project-meta { display: flex; align-items: center; justify-content: space-between; gap: 18px; color: var(--muted); font-size: 12px; margin-bottom: clamp(24px, 4vw, 48px); }
      .project-copy h3 { font-size: clamp(38px, 5.6vw, 82px); line-height: .91; letter-spacing: -.085em; font-weight: 540; margin: 0 0 24px; }
      .project-summary { max-width: 430px; color: var(--muted); font-size: clamp(15px, 1.35vw, 18px); line-height: 1.7; margin: 0; }
      .project-details { margin-top: 32px; border-top: 1px solid var(--hairline); }
      .project-details summary { list-style: none; cursor: pointer; padding: 17px 0; display: flex; justify-content: space-between; align-items: center; gap: 18px; font-size: 12px; color: var(--white); }
      .project-details summary::-webkit-details-marker { display: none; }
      .project-details summary:after { content: "+"; font-size: 20px; font-weight: 300; transition: transform .35s var(--ease); }
      .project-details[open] summary:after { transform: rotate(45deg); }
      .detail-content { padding: 0 0 22px; animation: detail-in .5s var(--ease) both; }
      .detail-content p { color: var(--muted); font-size: 14px; line-height: 1.8; max-width: 480px; margin: 0 0 18px; }
      .detail-content span { color: var(--white); font-size: 11px; line-height: 1.7; }
      @keyframes detail-in { from { opacity: 0; transform: translateY(10px); filter: blur(5px); } to { opacity: 1; transform: translateY(0); filter: blur(0); } }
      .about { padding-top: clamp(90px, 12vw, 170px); }
      .about-statement { max-width: 1250px; margin: 0; font-size: clamp(38px, 7.2vw, 106px); line-height: 1.02; letter-spacing: -.078em; font-weight: 500; }
      .about-statement span { color: var(--quiet); }
      .about-bottom { display: grid; grid-template-columns: minmax(0,.8fr) minmax(0,1.2fr); gap: clamp(44px, 10vw, 150px); margin-top: clamp(82px, 12vw, 160px); }
      .about-note { max-width: 350px; color: var(--muted); font-size: 15px; line-height: 1.8; margin: 0; }
      .facts { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 34px 48px; }
      .fact h3 { font-size: 13px; font-weight: 500; margin: 0 0 12px; }
      .fact p { font-size: 12px; line-height: 1.7; color: var(--muted); margin: 0; }
      .capabilities { margin-top: clamp(80px, 12vw, 160px); padding-top: 24px; border-top: 1px solid var(--hairline); display: grid; grid-template-columns: minmax(0,.8fr) minmax(0,1.2fr); gap: 32px; }
      .capabilities h3 { margin: 0; font-size: 13px; font-weight: 500; }
      .capability-list { display: flex; flex-wrap: wrap; gap: 14px 26px; }
      .capability-list span { color: var(--muted); font-size: clamp(14px,1.45vw,18px); letter-spacing: -.035em; }
      .contact { min-height: 80svh; display: flex; flex-direction: column; justify-content: center; padding: clamp(120px, 18vw, 240px) 0 40px; }
      .contact h2 { max-width: 1250px; margin: 0 0 clamp(44px, 7vw, 88px); font-size: clamp(64px, 13vw, 190px); line-height: .82; letter-spacing: -.105em; font-weight: 540; }
      .contact-row { display: flex; align-items: center; justify-content: space-between; gap: 24px; }
      .contact-row p { color: var(--muted); font-size: 14px; line-height: 1.6; margin: 0; }
      .contact-link { display: inline-flex; align-items: center; justify-content: center; min-height: 54px; padding: 0 24px; border: 1px solid rgba(255,255,255,.6); border-radius: 100px; font-size: 13px; transition: color .3s ease, background .3s ease, transform .3s ease; }
      .contact-link:hover { color: var(--black); background: var(--white); transform: translateY(-3px); }
      footer { display: flex; justify-content: space-between; align-items: center; gap: 22px; padding: 28px 0 calc(28px + env(safe-area-inset-bottom)); border-top: 1px solid var(--hairline); color: var(--muted); font-size: 11px; }
      .footer-links { display: flex; gap: 24px; }
      .footer-links a:hover { color: var(--white); }
      .reveal { opacity: 1; transform: none; filter: none; }
      html.js .reveal { opacity: 0; transform: translateY(22px); filter: blur(7px); transition: opacity .8s var(--ease), transform .8s var(--ease), filter .8s var(--ease); }
      html.js .reveal.is-visible { opacity: 1; transform: translateY(0); filter: blur(0); }
      html.js .focus-zone .focus-content { transition: opacity .8s var(--ease), transform .8s var(--ease), filter .8s var(--ease); }
      html.js .focus-zone:not(.is-focused) .focus-content { opacity: .72; transform: scale(.99); filter: blur(1px); }
      .skip-link { position: absolute; left: 16px; top: 12px; z-index: 50; padding: 12px 16px; background: var(--white); color: var(--black); transform: translateY(-160%); }
      .skip-link:focus { transform: translateY(0); }
      @media (min-width: 1500px) { .hero-title { max-width: 1550px; } }
      @media (max-width: 760px) {
        :root { --nav-height: 68px; }
        .hero { min-height: 92svh; }
        .hero-bottom { grid-template-columns: 1fr; gap: 34px; }
        .identity { justify-content: start; }
        .section-heading { grid-template-columns: 1fr; gap: 24px; }
        .section-heading p { margin: 0; }
        .project, .project:nth-child(even) { grid-template-columns: 1fr; gap: 28px; }
        .project:nth-child(even) .project-art { order: 0; }
        .project-art { min-height: clamp(270px, 65vw, 440px); }
        .art-word { font-size: clamp(120px, 32vw, 230px); }
        .about-bottom, .capabilities { grid-template-columns: 1fr; gap: 34px; }
        .contact { min-height: 70svh; }
      }
      @media (max-width: 480px) {
        :root { --gutter: 21px; --nav-height: 62px; }
        .navlinks { gap: 18px; }
        .navlinks a { font-size: 11px; }
        .wordmark { font-size: 14px; }
        .hero { padding-top: calc(var(--nav-height) + 13vh); }
        .hero-title { font-size: clamp(58px, 15.6vw, 82px); letter-spacing: -.105em; }
        .hero-bottom { margin-top: 58px; }
        .hero-statement { font-size: 16px; max-width: 330px; }
        .identity { gap: 30px; }
        .identity span { font-size: 11px; }
        .identity strong { font-size: 13px; }
        .section { padding: 104px 0; }
        .section-heading h2 { font-size: clamp(48px, 12vw, 66px); }
        .project-list { gap: 92px; }
        .project-art { min-height: 270px; }
        .project-copy h3 { font-size: 42px; }
        .facts { gap: 28px 22px; }
        .contact h2 { font-size: clamp(62px, 16vw, 88px); }
        .contact-row { align-items: flex-start; flex-direction: column; }
        footer { align-items: flex-start; flex-direction: column; }
      }
      @media (max-width: 340px) {
        .navlinks { gap: 12px; }
        .hero-title { font-size: 55px; }
        .identity { gap: 20px; }
        .identity strong { font-size: 12px; }
      }
      @media (hover: none), (pointer: coarse) {
        .project:hover .art-word { transform: none; filter: none; }
        .contact-link:hover { transform: none; }
      }
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
        html.js .reveal, html.js .focus-zone .focus-content, html.js .focus-zone:not(.is-focused) .focus-content { opacity: 1; transform: none; filter: none; }
      }
      @supports not (height: 100dvh) { .hero { min-height: 100svh; } }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="topbar" id="topbar">
      <div class="wrap nav">
        <a class="wordmark" href="#home" aria-label="Vinith Reddy Banda home">VRB</a>
        <nav class="navlinks" aria-label="Main navigation">
          <a href="#work">Work</a>
          <a href="#about">About</a>
          <a href="#contact">Contact</a>
        </nav>
      </div>
    </header>
    <main id="main">
      <section class="hero focus-zone" id="home">
        <div class="wrap hero-content focus-content">
          <h1 class="hero-title"><span>Vinith Reddy</span><span>Banda.</span></h1>
          <div class="hero-bottom">
            <p class="hero-statement">I build <strong>thoughtful software</strong> across systems, interfaces and the spaces between them.</p>
            <div class="identity" aria-label="Professional role and location">
              <div><span>Role</span><strong>Software Engineer</strong></div>
              <div><span>Location</span><strong>Hyderabad, India</strong></div>
            </div>
          </div>
        </div>
      </section>
      <section class="section" id="work">
        <div class="wrap">
          <div class="section-heading reveal">
            <h2>Selected<br />work.</h2>
            <p>A few things I've built, explored and learned from. Each one started with a problem worth understanding.</p>
          </div>
          <div class="project-list">
            {projects.map((project, index) => (
              <article class="project focus-zone reveal">
                <div class="project-art focus-content" aria-hidden="true">
                  <span class="art-word">{project.visual}</span>
                  <span class="art-caption">{project.visualLabel}</span>
                </div>
                <div class="project-copy focus-content">
                  <div class="project-meta"><span>{project.type}</span><span>{project.year}</span></div>
                  <h3>{project.name}</h3>
                  <p class="project-summary">{project.summary}</p>
                  <details class="project-details">
                    <summary>Project details</summary>
                    <div class="detail-content">
                      <p>{project.detail}</p>
                      <span>{project.stack}</span>
                    </div>
                  </details>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
      <section class="section about" id="about">
        <div class="wrap">
          <p class="about-statement reveal">The best technology feels <span>considered, clear and almost invisible.</span> That's the standard I work towards.</p>
          <div class="about-bottom reveal">
            <p class="about-note">I enjoy moving between engineering disciplines: shaping reliable systems, building useful interfaces and understanding how the two meet.</p>
            <div class="facts">
              <div class="fact"><h3>Education</h3><p>B.E. Information Technology<br />Chaitanya Bharathi Institute of Technology<br />8.43 CGPA · 2026</p></div>
              <div class="fact"><h3>Experience</h3><p>.NET Full Stack Intern<br />Cognizant · 2026</p></div>
              <div class="fact"><h3>Research</h3><p>Published research<br />I3CTCON · 2026</p></div>
              <div class="fact"><h3>Interests</h3><p>Software architecture, native systems, product design and applied AI.</p></div>
            </div>
          </div>
          <div class="capabilities reveal">
            <h3>Tools and technologies</h3>
            <div class="capability-list">{capabilities.map((item) => <span>{item}</span>)}</div>
          </div>
        </div>
      </section>
      <section class="contact" id="contact">
        <div class="wrap">
          <h2 class="reveal">Let's make<br />something<br />matter.</h2>
          <div class="contact-row reveal">
            <p>Have an interesting problem or an idea to explore?<br />I'd like to hear about it.</p>
            <a class="contact-link" href="mailto:vinithreddybanda@gmail.com">Get in touch</a>
          </div>
          <footer>
            <span>© {new Date().getFullYear()} Vinith Reddy Banda</span>
            <div class="footer-links">
              <a href="mailto:vinithreddybanda@gmail.com">Email</a>
              <a href="https://github.com/vinithreddybanda" target="_blank" rel="noreferrer">GitHub</a>
            </div>
          </footer>
        </div>
      </section>
    </main>
    <script>
      document.documentElement.classList.add("js");
      const topbar = document.querySelector("#topbar");
      let scrollQueued = false;
      const updateHeader = () => {
        topbar.classList.toggle("scrolled", window.scrollY > 24);
        scrollQueued = false;
      };
      addEventListener("scroll", () => {
        if (!scrollQueued) {
          requestAnimationFrame(updateHeader);
          scrollQueued = true;
        }
      }, { passive: true });
      updateHeader();

      const revealObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12, rootMargin: "0px 0px -35px 0px" });
      document.querySelectorAll(".reveal").forEach((element) => revealObserver.observe(element));

      const focusObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          entry.target.classList.toggle("is-focused", entry.isIntersecting);
        });
      }, { threshold: 0.22, rootMargin: "-28% 0px -28% 0px" });
      document.querySelectorAll(".focus-zone").forEach((element) => focusObserver.observe(element));
    </script>
  </body>
</html>
