---
const projects = [
  {
    number: "01",
    name: "CareSchedule",
    category: "Healthcare systems",
    year: "2026",
    summary: "A calmer way to coordinate the moving parts of a clinic.",
    detail: "Built during my .NET Full Stack internship at Cognizant. A clinic operations platform shaped around six-layer Clean Architecture, 148 REST APIs and six role-based workflows. Its appointment engine accounts for provider availability, leave, holidays and resource constraints before offering a slot.",
    stack: [".NET", "React", "Entity Framework Core", "SQL Server"],
    metric: "148",
    metricLabel: "REST endpoints"
  },
  {
    number: "02",
    name: "JournalAI",
    category: "Applied AI",
    year: "2025",
    summary: "A private space for reflection. Patterns, not noise.",
    detail: "A journaling experience that turns personal entries into structured mood insights. Designed around a cloud-ready architecture and an automated delivery pipeline.",
    stack: ["Next.js", "TypeScript", "Supabase", "Azure", "Docker"],
    metric: "01",
    metricLabel: "space to reflect"
  },
  {
    number: "03",
    name: "Activities for Discord",
    category: "Android systems",
    year: "2025",
    summary: "Desktop presence controls, rethought for Android.",
    detail: "An Android application bringing mobile control to Discord Rich Presence through a native integration layer, persistent SDK sessions, JNI and encrypted credential storage.",
    stack: ["Android", "Java", "C++", "JNI", "Discord Partner SDK"],
    metric: "JNI",
    metricLabel: "native integration"
  }
];
const capabilities = ["C# / .NET", "TypeScript", "React / Next.js", "Java / Kotlin", "C++ / JNI", "SQL / PostgreSQL", "Azure / Docker", "Systems design"];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#090909" />
    <meta name="description" content="Vinith Reddy Banda — software engineer building thoughtful systems and digital experiences." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />
    <title>Vinith Reddy Banda — Software Engineer</title>
    <style>
      :root {
        color-scheme: dark;
        --bg: #090909;
        --paper: #f1f0eb;
        --ink: #f1f0eb;
        --muted: #898985;
        --quiet: #5e5e5a;
        --line: rgba(241,240,235,.16);
        --soft-line: rgba(241,240,235,.09);
        --gutter: clamp(20px, 5.4vw, 88px);
        --sans: "DM Sans", Arial, sans-serif;
        --serif: "Instrument Serif", Georgia, serif;
        --mono: "DM Mono", monospace;
        --ease: cubic-bezier(.22,1,.36,1);
      }
      *,*::before,*::after{box-sizing:border-box}
      html{background:var(--bg);scroll-behavior:smooth;scroll-padding-top:90px}
      body{margin:0;min-width:0;width:100%;background:var(--bg);color:var(--ink);font-family:var(--sans);-webkit-font-smoothing:antialiased;overflow-x:hidden}
      body::after{content:"";position:fixed;inset:0;z-index:20;pointer-events:none;opacity:.1;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.92' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.13'/%3E%3C/svg%3E");mix-blend-mode:soft-light}
      ::selection{background:var(--paper);color:var(--bg)}
      a{color:inherit;text-decoration:none}
      a:focus-visible,summary:focus-visible{outline:1px solid var(--ink);outline-offset:5px}
      .shell{width:100%;max-width:1720px;margin-inline:auto;padding-inline:var(--gutter)}
      .mono{font:10px/1.5 var(--mono);letter-spacing:.09em;text-transform:uppercase}
      .muted{color:var(--muted)}
      .skip{position:absolute;z-index:100;top:8px;left:8px;padding:12px;background:var(--paper);color:var(--bg);transform:translateY(-150%)}
      .skip:focus{transform:none}
      .top{position:fixed;z-index:30;inset:0 0 auto;height:72px;border-bottom:1px solid transparent;transition:background .45s,border-color .45s,backdrop-filter .45s}
      .top.is-scrolled{background:rgba(9,9,9,.76);border-color:var(--soft-line);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px)}
      .nav{height:100%;display:flex;align-items:center;justify-content:space-between;gap:24px}
      .brand{font-size:15px;font-weight:700;letter-spacing:-.09em;white-space:nowrap}
      .nav-right{display:flex;align-items:center;gap:clamp(16px,3vw,42px)}
      .nav-right a{font:10px var(--mono);letter-spacing:.07em;text-transform:uppercase;color:#b6b6b1;transition:color .2s}
      .nav-right a:hover{color:var(--ink)}
      .nav-index{margin-right:clamp(4px,1vw,18px);color:var(--quiet);white-space:nowrap}
      .hero{min-height: min(940px,100svh);min-height:max(740px,100svh);position:relative;display:flex;flex-direction:column;justify-content:flex-end;padding-top:150px;padding-bottom:clamp(38px,6vw,82px);isolation:isolate}
      .hero::before{content:"";position:absolute;z-index:-1;right:-15%;top:8%;width:min(70vw,920px);aspect-ratio:1;border-radius:50%;background:radial-gradient(circle,rgba(255,255,255,.09),rgba(255,255,255,.025) 38%,transparent 69%);filter:blur(58px);pointer-events:none}
      .hero-topline{display:flex;justify-content:space-between;gap:24px;margin-bottom:clamp(54px,10vh,120px);color:var(--muted)}
      .hero-title{max-width:1450px;margin:0;font-size:clamp(64px,13.2vw,216px);font-weight:600;line-height:.78;letter-spacing:-.105em}
      .hero-title .line{display:block;overflow:hidden;padding:0 .12em .15em 0;margin-right:-.12em}
      .hero-title .line span{display:block;opacity:0;filter:blur(12px);transform:translateY(105%);animation:title-enter 1.15s var(--ease) forwards}
      .hero-title .line:nth-child(2) span{animation-delay:.14s}
      .hero-title em{font:italic .98em var(--serif);font-weight:400;letter-spacing:-.07em}
      @keyframes title-enter{to{opacity:1;filter:blur(0);transform:translateY(0)}}
      .hero-foot{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:end;gap:42px;margin-top:clamp(58px,10vh,120px)}
      .intro{max-width:420px;margin:0;color:#aaa;font-size:clamp(15px,1.5vw,20px);line-height:1.65;letter-spacing:-.035em}
      .intro em{font:italic 1.35em var(--serif);color:var(--ink)}
      .hero-meta{display:flex;gap:clamp(26px,5vw,76px)}
      .meta-item .mono{color:var(--quiet)}
      .meta-item p{margin:9px 0 0;font-size:12px;color:#d2d2ce}
      .section{padding-block:clamp(100px,14vw,205px)}
      .section-kicker{display:flex;justify-content:space-between;gap:20px;padding-bottom:17px;border-bottom:1px solid var(--line);color:var(--muted)}
      .work-heading{display:flex;justify-content:space-between;align-items:end;gap:36px;padding:clamp(42px,7vw,92px) 0 clamp(52px,8vw,112px)}
      .work-heading h2{margin:0;font-size:clamp(58px,10.5vw,154px);font-weight:500;line-height:.79;letter-spacing:-.105em}
      .work-heading h2 em{font:italic 1em var(--serif);letter-spacing:-.075em}
      .work-heading p{max-width:250px;margin:0 0 5px;color:var(--muted);font-size:13px;line-height:1.8}
      .projects{border-top:1px solid var(--line)}
      .project{position:relative;display:grid;grid-template-columns:clamp(34px,5vw,72px) minmax(0,1fr);gap:clamp(14px,3vw,46px);padding:clamp(38px,6vw,86px) 0;border-bottom:1px solid var(--line);min-width:0}
      .project::before{content:"";position:absolute;z-index:-1;inset:0 calc(var(--gutter)*-.25);background:linear-gradient(100deg,rgba(255,255,255,.045),transparent 72%);opacity:0;transition:opacity .55s}
      .project:hover::before{opacity:1}
      .project-num{padding-top:8px;color:var(--quiet)}
      .project-main{min-width:0}
      .project-label{display:flex;align-items:center;gap:12px;margin-bottom:clamp(20px,3vw,38px);color:var(--muted)}
      .project-label::before{content:"";width:19px;height:1px;background:var(--ink)}
      .project-heading{display:flex;align-items:baseline;flex-wrap:wrap;column-gap:.24em;row-gap:.05em;max-width:100%;margin:0;font-size:clamp(42px,7.4vw,104px);font-weight:500;line-height:.92;letter-spacing:-.09em;overflow-wrap:anywhere}
      .project-heading .serif{font:italic 1em var(--serif);letter-spacing:-.065em}
      .project-summary{max-width:520px;margin:23px 0 0;color:#aaa;font-size:clamp(14px,1.35vw,17px);line-height:1.75}
      .project-bottom{grid-column:2;display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:end;gap:28px;margin-top:clamp(26px,4vw,48px);min-width:0}
      .project-aside{display:flex;align-items:center;gap:20px;min-width:0}
      .project-year{color:var(--muted)}
      .project-metric{display:flex;flex-direction:column;gap:7px;padding-left:18px;border-left:1px solid var(--line)}
      .metric-value{font:italic clamp(25px,3vw,40px)/.9 var(--serif);letter-spacing:-.035em}
      .metric-label{font:9px/1.4 var(--mono);letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
      .details{max-width:620px;margin-top:28px}
      .details summary{display:inline-flex;align-items:center;gap:12px;cursor:pointer;list-style:none;color:var(--ink);font:10px var(--mono);letter-spacing:.08em;text-transform:uppercase}
      .details summary::-webkit-details-marker{display:none}
      .details summary::after{content:"+";font:16px var(--sans);transition:transform .35s var(--ease)}
      .details[open] summary::after{transform:rotate(45deg)}
      .detail-body{padding:18px 0 0;animation:detail-in .45s var(--ease) both}
      .detail-body p{max-width:590px;margin:0 0 18px;color:#aaa;font-size:13px;line-height:1.9}
      .stack-list{display:flex;flex-wrap:wrap;gap:8px}
      .stack-list span{padding:7px 10px;border:1px solid var(--soft-line);border-radius:2px;color:#c7c7c2;font:9px/1.4 var(--mono);letter-spacing:.025em}
      @keyframes detail-in{from{opacity:0;transform:translateY(9px);filter:blur(5px)}to{opacity:1;transform:none;filter:blur(0)}}
      .about{padding-top:clamp(80px,11vw,150px)}
      .about-lead{max-width:1320px;margin:clamp(42px,7vw,92px) 0 0;font-size:clamp(38px,7.6vw,112px);font-weight:500;line-height:1.02;letter-spacing:-.08em}
      .about-lead .serif{font:italic 1.08em var(--serif);letter-spacing:-.065em}
      .about-lead .faint{color:#666}
      .about-grid{display:grid;grid-template-columns:minmax(180px,.8fr) minmax(0,1.2fr);gap:clamp(42px,10vw,150px);margin-top:clamp(76px,12vw,170px)}
      .about-note{max-width:330px;margin:0;color:#aaa;font-size:14px;line-height:1.95}
      .facts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:32px 48px}
      .fact{min-width:0;padding-top:14px;border-top:1px solid var(--line)}
      .fact h3{margin:0 0 14px;color:var(--muted);font:9px var(--mono);letter-spacing:.1em;text-transform:uppercase}
      .fact p{margin:0;color:#d0d0cc;font-size:13px;line-height:1.9}
      .skills{display:grid;grid-template-columns:minmax(180px,.8fr) minmax(0,1.2fr);gap:clamp(42px,10vw,150px);margin-top:clamp(72px,10vw,130px);padding-top:18px;border-top:1px solid var(--line)}
      .skills-label{color:var(--muted)}
      .skill-list{display:flex;flex-wrap:wrap;gap:13px 25px}
      .skill-list span{color:#d0d0cc;font-size:clamp(14px,1.4vw,18px);letter-spacing:-.035em}
      .contact{padding-top:clamp(100px,15vw,220px);padding-bottom:28px}
      .contact-top{display:flex;justify-content:space-between;gap:20px;padding-bottom:18px;border-bottom:1px solid var(--line);color:var(--muted)}
      .contact-title{margin:clamp(50px,8vw,105px) 0;font-size:clamp(65px,13.5vw,200px);font-weight:500;line-height:.8;letter-spacing:-.105em}
      .contact-title em{font:italic 1em var(--serif);letter-spacing:-.075em}
      .contact-bottom{display:flex;justify-content:space-between;align-items:end;gap:30px;padding-bottom:clamp(78px,12vw,160px)}
      .contact-bottom p{margin:0;color:var(--muted);font-size:13px;line-height:1.8}
      .mail{display:inline-flex;align-items:center;gap:20px;padding-bottom:11px;border-bottom:1px solid var(--ink);font-size:clamp(15px,1.6vw,20px);transition:gap .3s var(--ease)}
      .mail:hover{gap:30px}
      .mail span{font-size:20px}
      footer{display:flex;justify-content:space-between;gap:20px;padding-top:18px;border-top:1px solid var(--line);color:var(--muted)}
      .footer-links{display:flex;gap:24px}
      .footer-links a:hover{color:var(--ink)}
      .reveal{opacity:1;transform:none;filter:none}
      html.js .reveal{opacity:0;transform:translateY(24px);filter:blur(7px);transition:opacity .8s var(--ease),transform .9s var(--ease),filter .8s var(--ease)}
      html.js .reveal.in-view{opacity:1;transform:none;filter:none}
      @media(max-width:760px){
        .top{height:64px}
        .hero{min-height:880px;min-height:100svh;padding-top:120px}
        .hero-title{font-size:clamp(64px,14vw,112px)}
        .hero-foot{grid-template-columns:1fr;gap:32px;margin-top:62px}
        .hero-meta{justify-content:flex-start}
        .work-heading{align-items:start;flex-direction:column;gap:24px}
        .work-heading p{max-width:340px}
        .project-heading{font-size:clamp(42px,8.7vw,68px)}
        .project-bottom{grid-template-columns:minmax(0,1fr) auto;gap:18px}
        .about-grid,.skills{grid-template-columns:1fr;gap:34px}
        .about-note{max-width:470px}
        .contact-title{font-size:clamp(68px,14.5vw,112px)}
      }
      @media(max-width:480px){
        :root{--gutter:20px}
        .nav{gap:12px}
        .nav-index{display:none}
        .nav-right{gap:clamp(13px,4vw,20px)}
        .nav-right a{font-size:9px}
        .hero{min-height:820px;min-height:100svh;padding-bottom:36px}
        .hero-topline{margin-bottom:64px;font-size:8px}
        .hero-topline span:last-child{max-width:105px;text-align:right}
        .hero-title{font-size:clamp(55px,14.1vw,72px);letter-spacing:-.105em}
        .hero-foot{margin-top:58px}
        .hero-meta{gap:26px}
        .meta-item p{font-size:11px}
        .section{padding-block:92px}
        .section-kicker{font-size:8px}
        .work-heading h2{font-size:clamp(58px,16vw,76px)}
        .project{grid-template-columns:25px minmax(0,1fr);gap:10px;padding-block:38px}
        .project-num{font-size:9px}
        .project-label{font-size:8px;margin-bottom:22px}
        .project-heading{font-size:clamp(39px,10.2vw,51px);line-height:.96}
        .project-summary{margin-top:18px;font-size:14px}
        .project-bottom{grid-column:2;grid-template-columns:minmax(0,1fr);align-items:start;gap:22px;margin-top:25px}
        .project-aside{justify-content:space-between;gap:12px}
        .project-metric{padding-left:14px}
        .metric-value{font-size:29px}
        .metric-label{font-size:8px}
        .details{margin-top:23px}
        .facts{gap:27px 20px}
        .fact p{font-size:12px}
        .skill-list{gap:12px 18px}
        .contact-title{font-size:clamp(61px,15.4vw,82px);line-height:.84}
        .contact-bottom{align-items:start;flex-direction:column;gap:28px}
        footer{flex-direction:column;font-size:9px}
      }
      @media(max-width:350px){
        .nav-right{gap:10px}
        .nav-right a{font-size:8px}
        .hero-title{font-size:52px}
        .hero-meta{gap:17px}
        .project-heading{font-size:37px}
      }
      @media(hover:none),(pointer:coarse){.project:hover::before{opacity:0}.mail:hover{gap:20px}}
      @media(prefers-reduced-motion:reduce){
        *,*::before,*::after{scroll-behavior:auto!important;animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}
        html.js .reveal{opacity:1;transform:none;filter:none}
      }
    </style>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top" id="top">
      <div class="shell nav">
        <a class="brand" href="#home" aria-label="Vinith Reddy Banda home">V/RB.</a>
        <nav class="nav-right" aria-label="Main navigation">
          <span class="nav-index mono">Portfolio / 2026</span>
          <a href="#work">Work <span class="muted">01</span></a>
          <a href="#about">About <span class="muted">02</span></a>
          <a href="#contact">Contact <span class="muted">03</span></a>
        </nav>
      </div>
    </header>
    <main id="main">
      <section class="hero" id="home">
        <div class="shell">
          <div class="hero-topline mono"><span>Independent mind. Intentional work.</span><span>Hyderabad, India</span></div>
          <h1 class="hero-title">
            <span class="line"><span>Vinith Reddy</span></span>
            <span class="line"><span>Banda<em>.</em></span></span>
          </h1>
          <div class="hero-foot">
            <p class="intro">Engineer by discipline.<br /><em>Curious by default.</em> I build thoughtful software across systems and interfaces.</p>
            <div class="hero-meta">
              <div class="meta-item"><div class="mono muted">Currently</div><p>Software Engineer</p></div>
              <div class="meta-item"><div class="mono muted">Based in</div><p>Hyderabad, India</p></div>
            </div>
          </div>
        </div>
      </section>

      <section class="section" id="work">
        <div class="shell">
          <div class="section-kicker mono reveal"><span>01 / Selected work</span><span>2025 — 2026</span></div>
          <div class="work-heading reveal">
            <h2>Made with<br /><em>intent.</em></h2>
            <p>A considered selection of things I've built, and the problems that made them worth building.</p>
          </div>
          <div class="projects">
            {projects.map((project) => (
              <article class="project reveal">
                <div class="project-num mono">{project.number}</div>
                <div class="project-main">
                  <div class="project-label mono">{project.category}</div>
                  <h3 class="project-heading">
                    {project.name === "Activities for Discord" ? <>Activities <span class="serif">for</span> Discord</> : project.name === "CareSchedule" ? <>Care<span class="serif">Schedule</span></> : <>Journal<span class="serif">AI</span></>}
                  </h3>
                  <p class="project-summary">{project.summary}</p>
                  <details class="details">
                    <summary>Explore the build</summary>
                    <div class="detail-body">
                      <p>{project.detail}</p>
                      <div class="stack-list">{project.stack.map((item) => <span>{item}</span>)}</div>
                    </div>
                  </details>
                </div>
                <div class="project-bottom">
                  <span class="project-year mono">{project.year}</span>
                  <div class="project-metric">
                    <span class="metric-value">{project.metric}</span>
                    <span class="metric-label">{project.metricLabel}</span>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section about" id="about">
        <div class="shell">
          <div class="section-kicker mono reveal"><span>02 / A little context</span><span>Person, then profession</span></div>
          <p class="about-lead reveal">I like technology that feels <span class="serif">inevitable.</span> <span class="faint">Clear in its purpose. Thoughtful in its details. Built to hold up.</span></p>
          <div class="about-grid reveal">
            <p class="about-note">I move between engineering disciplines: shaping reliable systems, building useful interfaces and understanding how the two meet. I care about the details people notice, and the ones they never have to.</p>
            <div class="facts">
              <div class="fact"><h3>Education</h3><p>B.E. Information Technology<br />Chaitanya Bharathi Institute of Technology<br />8.43 CGPA · 2026</p></div>
              <div class="fact"><h3>Experience</h3><p>.NET Full Stack Intern<br />Cognizant · 2026</p></div>
              <div class="fact"><h3>Research</h3><p>Published research<br />I3CTCON · 2026</p></div>
              <div class="fact"><h3>Interests</h3><p>Software architecture, native systems, product design and applied AI.</p></div>
            </div>
          </div>
          <div class="skills reveal">
            <div class="skills-label mono">Tools I work with</div>
            <div class="skill-list">{capabilities.map((item) => <span>{item}</span>)}</div>
          </div>
        </div>
      </section>

      <section class="contact" id="contact">
        <div class="shell">
          <div class="contact-top mono reveal"><span>03 / The next thing</span><span>Open to good problems</span></div>
          <h2 class="contact-title reveal">Have a good<br /><em>one in mind?</em></h2>
          <div class="contact-bottom reveal">
            <p>Interesting problems make for<br />interesting conversations.</p>
            <a class="mail" href="mailto:vinithreddybanda@gmail.com">Let's talk <span>↗</span></a>
          </div>
          <footer class="mono">
            <span>© {new Date().getFullYear()} Vinith Reddy Banda</span>
            <div class="footer-links">
              <a href="mailto:vinithreddybanda@gmail.com">Email</a>
              <a href="https://github.com/vinithreddybanda" target="_blank" rel="noreferrer">GitHub</a>
            </div>
          </footer>
        </div>
      </section>
    </main>
    <script>
      document.documentElement.classList.add("js");
      const header = document.querySelector("#top");
      let headerFrame = false;
      const syncHeader = () => {
        header.classList.toggle("is-scrolled", window.scrollY > 18);
        headerFrame = false;
      };
      addEventListener("scroll", () => {
        if (!headerFrame) {
          requestAnimationFrame(syncHeader);
          headerFrame = true;
        }
      }, { passive: true });
      syncHeader();

      const revealNodes = document.querySelectorAll(".reveal");
      if ("IntersectionObserver" in window) {
        const revealObserver = new IntersectionObserver((entries, observer) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("in-view");
              observer.unobserve(entry.target);
            }
          }
        }, { threshold: 0.1, rootMargin: "0px 0px -6% 0px" });
        revealNodes.forEach((node) => revealObserver.observe(node));
      } else {
        revealNodes.forEach((node) => node.classList.add("in-view"));
      }
    </script>
  </body>
</html>
