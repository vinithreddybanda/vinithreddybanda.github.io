---
import BaseLayout from "@layouts/BaseLayout.astro";
import ExperienceEntry from "@components/ExperienceEntry.astro";
import { profile, projects, experience, skills, education, recognition } from "@data/portfolio";
---
<BaseLayout>
  <section class="hero section-wrap" id="top">
    <div class="hero-top"><span class="availability"><i></i> Available for opportunities</span><span class="hero-location">Based in {profile.location}</span></div>
    <div class="hero-main">
      <p class="hero-kicker">HELLO, I'M</p>
      <h1>Vinith Reddy<br /><em>Banda.</em></h1>
      <div class="hero-bottom">
        <p class="hero-role">Software developer <span>·</span> Full-stack, Android & AI</p>
        <p class="hero-description">{profile.intro}</p>
        <div class="hero-actions"><a class="button button-primary" href="#work">View selected work <span>↗</span></a><a class="quiet-link" href="#contact">Get in touch</a></div>
      </div>
    </div>
    <div class="hero-rule"><span>Engineering with care.</span><span>Scroll to explore ↓</span></div>
  </section>

  <section class="work-section section-wrap" id="work">
    <div class="section-heading"><div><p class="eyebrow">01 / SELECTED WORK</p><h2>Things I've <em>built.</em></h2></div><p class="section-note">A few projects I've worked on, from AI products to native Android.</p></div>
    <div class="project-list">
      {projects.map((project, index) => <article class="project-row" data-reveal>
        <div class="project-number">0{index + 1}</div>
        <div class="project-main"><p class="project-type">{project.type}</p><h3>{project.name}</h3><p class="project-description">{project.description}</p><div class="project-stack">{project.stack.slice(0, 5).map((item) => <span>{item}</span>)}</div></div>
        <a class="project-open" href={project.link} target="_blank" rel="noopener noreferrer" aria-label={project.linkLabel + ": " + project.name}>↗</a>
      </article>)}
    </div>
  </section>

  <section class="experience-section section-wrap" id="experience">
    <div class="section-heading"><div><p class="eyebrow">02 / EXPERIENCE</p><h2>Where I've <em>worked.</em></h2></div><p class="section-note">Learning from teams, real products, and practical engineering constraints.</p></div>
    <div class="experience-list">{experience.map((item) => <ExperienceEntry item={item} />)}</div>
  </section>

  <section class="skills-section section-wrap" id="skills">
    <div class="section-heading"><div><p class="eyebrow">03 / TOOLKIT</p><h2>What I <em>work with.</em></h2></div><p class="section-note">The languages, frameworks, and tools I use to make software.</p></div>
    <div class="skills-list">{skills.map((group) => <div class="skill-group" data-reveal><h3>{group.title}</h3><div>{group.items.map((item) => <span>{item}</span>)}</div></div>)}</div>
  </section>

  <section class="about-section section-wrap" id="about">
    <div class="section-heading"><div><p class="eyebrow">04 / BACKGROUND</p><h2>A little <em>about me.</em></h2></div><p class="section-note">Education, research, and a few milestones.</p></div>
    <div class="about-columns">
      <div class="about-block"><h3>EDUCATION</h3>{education.map((item) => <article class="about-entry" data-reveal><span>{item.period}</span><div><h4>{item.institution}</h4><p>{item.qualification}</p></div><strong>{item.result}</strong></article>)}</div>
      <div class="about-block"><h3>RECOGNITION</h3>{recognition.map((item) => <article class="recognition-entry" data-reveal><div><h4>{item.title}</h4><p>{item.description}</p></div>{item.link && <a href={item.link} target="_blank" rel="noopener noreferrer" aria-label="Read details">↗</a>}</article>)}</div>
    </div>
  </section>
</BaseLayout>
