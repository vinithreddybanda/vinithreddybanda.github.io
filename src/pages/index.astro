---
import BaseLayout from "../layouts/BaseLayout.astro";
import { projects } from "../data/projects";
const cards = projects.map((project,index)=>({...project,index}));
---
<BaseLayout title="Vinith Reddy Banda — Software Engineer" description="Selected work, experiments and notes from Vinith Reddy Banda.">
<section class="workshop page-wrap" id="top">
<div class="workshop-topline"><span>PERSONAL WORKSHOP <b>№ 001</b></span><span>HYDERABAD, INDIA <i></i> OPEN TO GOOD PROBLEMS</span></div>
<div class="workshop-intro"><div><p class="micro-label">THE FRONT OFFICE / 2026</p><h1>Ideas in.<br /><em>Working things out.</em></h1></div><p class="intro-note">I’m Vinith. Software engineer working across web, mobile, backend systems and applied AI. This is a record of things I’ve built, broken and made better.</p></div>
<div class="press-stage" data-press-stage>
<div class="press-stage__heading"><span>SELECTED WORK / THE PRESS</span><span data-wheel-readout>01 — 0{projects.length}</span></div>
<div class="press-floor" data-wheel>
<div class="wheel-glow" aria-hidden="true"></div>
<div class="wheel-track" data-wheel-track>
{cards.map((project)=><button class="wheel-card" type="button" data-wheel-card data-index={project.index} aria-label={`Select ${project.name}`} aria-pressed={project.index===0} style={`--i:${project.index};--n:${projects.length};--plate:${project.index%4};`}>
<span class="plate-frame"><span class="plate-top"><small>{project.number} / PROJECT PLATE</small><small>{project.year}</small></span><span class:list={["plate-art",`plate-art--${project.index%4}`]}><i></i><b></b><em></em><strong>{project.name.split(/\s+/).map(x=>x[0]).join("").slice(0,3)}</strong></span><span class="plate-bottom"><strong>{project.name}</strong><small>{project.category}</small></span></span>
</button>)}
</div>
<div class="wheel-shadow" aria-hidden="true"></div>
<button class="wheel-control wheel-control--prev" type="button" data-wheel-prev aria-label="Previous project">←</button><button class="wheel-control wheel-control--next" type="button" data-wheel-next aria-label="Next project">→</button>
<div class="wheel-hint">DRAG TO TURN <span>·</span> CLICK A PRINT TO SELECT</div>
</div>
<div class="press-caption" aria-live="polite"><div class="press-caption__number" data-active-number>01</div><div class="press-caption__copy"><span class="micro-label" data-active-category>{projects[0].category}</span><h2 data-active-title>{projects[0].name}</h2><p data-active-summary>{projects[0].summary}</p><div class="plate-tags" data-active-tags>{projects[0].stack.slice(0,5).map(tag=><span>{tag}</span>)}</div></div><a class="open-project" data-active-link href={`/work/${projects[0].slug}/`}>OPEN PROJECT <span>↗</span></a></div>
<div class="press-controls"><div class="press-dots" data-wheel-dots>{cards.map((project)=><button type="button" data-dot={project.index} aria-label={`Go to project ${project.index+1}`} aria-pressed={project.index===0}></button>)}</div><div class="press-instructions"><span>← → TO BROWSE</span><span>DRAG / SCROLL / TOUCH</span><span>⌘ K COMMANDS</span></div></div>
</div>
<div class="workshop-bottom"><div class="bottom-statement"><span class="micro-label">A NOTE FROM THE DESK</span><p>Curiosity is the brief.<br /><em>Shipping is the point.</em></p></div><div class="bottom-links"><a href="/about/"><span>01</span> THE PERSON <b>↗</b></a><a href="/work/"><span>02</span> THE ARCHIVE <b>↗</b></a><a href="/contact/"><span>03</span> GET IN TOUCH <b>↗</b></a></div></div>
</section>
<section class="workshop-lab page-wrap" id="lab"><div class="lab-heading"><span class="micro-label">AFTER HOURS / LAB NOTES</span><span>SMALL EXPERIMENTS, USEFUL CURIOSITY</span></div><div class="lab-grid"><a href="/work/whatsapp-status-saver/" class="lab-tile"><span>01 / ANDROID</span><strong>Native interfaces</strong><small>Exploring fluid galleries and useful interactions.</small><b>↗</b></a><a href="/work/journalai/" class="lab-tile"><span>02 / APPLIED AI</span><strong>Personal software</strong><small>Making AI features feel like part of the product.</small><b>↗</b></a><a href="/about/" class="lab-tile lab-tile--note"><span>03 / FIELD NOTE</span><strong>Keep it simple.<br /><em>Make it work.</em></strong><small>More about how I approach engineering.</small><b>↗</b></a></div></section>
</BaseLayout>
<script define:vars={{ projects: projects.map(({slug,number,name,category,year,summary,stack})=>({slug,number,name,category,year,summary,stack})) }}>
window.__portfolioProjects=projects;
</script>