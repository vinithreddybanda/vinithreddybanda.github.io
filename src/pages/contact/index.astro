---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout title="Contact — Vinith Reddy Banda" description="Write a note to Vinith Reddy Banda.">
<section class="contact-shell page-shell">
  <div class="contact-head"><div class="intro-overline"><span>INCOMING / 001</span><span>THE LETTER BOX</span></div><h1>Let's make<br /><em>something matter.</em></h1><p>A project, an idea, an interesting problem. Put it on paper and send it over.</p></div>
  <form class="typed-contact-letter" data-letter-form>
    <div class="letter-paper-head"><span>TO / VINITH REDDY BANDA</span><span>FROM / YOU</span></div>
    <label>YOUR NAME<input name="name" autocomplete="name" placeholder="What should I call you?" required /></label>
    <label>YOUR EMAIL<input name="email" type="email" autocomplete="email" placeholder="you@example.com" required /></label>
    <label>YOUR NOTE<textarea name="message" rows="5" placeholder="Write something..." required></textarea></label>
    <div class="letter-paper-foot"><span>THANK YOU FOR TAKING THE TIME.</span><button type="submit">FOLD & SEND <b>↗</b></button></div>
  </form>
  <p class="contact-alternative">Prefer email? <a href="mailto:vinithreddybanda@gmail.com">vinithreddybanda@gmail.com ↗</a></p>
</section>
</BaseLayout>