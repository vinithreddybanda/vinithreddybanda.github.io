{n:"02",type:"HACKATHON BUILD",date:"AUG 2025",title:"Nexus AI",desc:"An AI-assisted civic issue intake, prioritization and routing concept.",href:"https://devpost.com/software/nexus-ai-yao2hv",source:"DEVPOST"},
{n:"03",type:"OPEN-SOURCE RELEASE",date:"JAN 2026",title:"Whatsap Status",desc:"A local-first Android utility listed in the F-Droid repository.",href:"https://f-droid.org/packages/com.vinithreddybanda.whatsapstatus/",source:"F-DROID"}];
---
<Shell title="Writing & Research — Vinith Reddy Banda" description="Public research records, hackathon builds and open-source releases.">
<section class="page-hero section-pad"><div class="section-index"><span>THE READING ROOM</span><span>PUBLIC NOTES / RECORDS</span></div><p class="eyebrow"><span class="eyebrow-mark"></span> WORK THAT LEFT THE DESK</p><h1 class="page-heading">Research.<br/><em>Builds. Releases.</em></h1><p class="page-deck">A short index of work with a public record. No placeholder articles or invented publication dates.</p></section>
<section class="writing-list section-pad"><div class="section-index"><span>THE INDEX</span><span>EXTERNAL RECORDS / 03</span></div>{notes.map(n=><a class="writing-row writing-link" href={n.href} target="_blank" rel="noreferrer"><div class="writing-meta"><span>{n.n} / {n.type}</span><small>{n.date}</small></div><div><h2>{n.title}</h2><p>{n.desc}</p></div><span class="writing-arrow">{n.source} ↗</span></a>)}</section>
<section class="writing-foot section-pad"><span class="micro-label">SOURCE FIRST</span><p>Each entry opens its original public record. Research, project ownership and publication status should be judged from the source, not a portfolio summary.</p></section></Shell>