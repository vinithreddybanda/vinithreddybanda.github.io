---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { projects } from "../../data/projects";
---
<BaseLayout title="Work — Vinith Reddy Banda" description="Selected software engineering projects.">
<section class="archive page-wrap">
  <header class="archive-heading"><span class="micro-label">SELECTED WORK / 2024—2026</span><h1>Things I've<br /><em>put into the world.</em></h1><p>A few products and experiments across software, systems and interfaces.</p></header>
  <div class="archive-meta"><span>PROJECT</span><span>{String(projects.length).padStart(2,"0")} ENTRIES</span></div>
  <div class="project-grid project-grid--archive">{projects.map((project,index)=><ProjectCard project={project} featured={index===0} />)}</div>
</section>
</BaseLayout>