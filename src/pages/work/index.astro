---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { projects } from "../../data/projects";
---
<BaseLayout title="Selected Work — Vinith Reddy Banda" description="A selection of software products and engineering projects.">
<section class="archive-shell page-shell">
  <div class="archive-head"><div class="intro-overline"><span>THE ARCHIVE</span><span>2024 — 2026</span></div><h1>Selected<br /><em>work.</em></h1><p>Products, tools and experiments I’ve helped bring to life.</p></div>
  <div class="archive-list">
    {projects.map(project => <a class="archive-row" href={"/work/" + project.slug + "/"}>
      <span class="archive-number">{project.number}</span><span class="archive-name"><b>{project.name}</b><small>{project.summary}</small></span><span class="archive-category">{project.category}</span><span class="archive-year">{project.year}</span><span class="archive-arrow">↗</span>
    </a>)}
  </div>
  <div class="archive-foot"><span>{String(projects.length).padStart(2, "0")} PROJECTS</span><span>MORE WORK IN PROGRESS</span></div>
</section>
</BaseLayout>