---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { projects } from "../../data/projects";
---
<BaseLayout title="Work | Vinith" description="A collection of apps, websites and experiments I’ve built.">
<section class="inner-page page-wrap">
  <div class="inner-intro"><p>Some things I’ve made</p><h1>Selected<br /><em>work.</em></h1><span>A few projects from my corner of the internet.</span></div>
  <div class="project-grid archive-grid">
    {projects.map((project,i)=><a class:list={["project-card","project-card-"+(i%4+1)]} href={"/work/"+project.slug+"/"}>
      <div class={"project-art art-"+(i%4+1)} aria-hidden="true"><div class="archive-art-word">{project.name}</div><span class="archive-art-shape">✳</span></div>
      <div class="project-info"><div><h3>{project.name}</h3><p>{project.summary}</p></div><span class="project-arrow">↗</span></div>
    </a>)}
  </div>
</section>
</BaseLayout>