---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { projects } from "../../data/projects";
export function getStaticPaths() { return projects.map(project => ({ params: { slug: project.slug }, props: { project } })); }
const { project } = Astro.props;
---
<BaseLayout title={project.name + " — Vinith Reddy Banda"} description={project.summary}>
<article class="case-shell page-shell">
  <a class="back-to-work" href="/work/">← ALL WORK</a>
  <div class="case-heading"><div class="intro-overline"><span>{project.number} / {project.category}</span><span>{project.year}</span></div><h1>{project.name}<em>.</em></h1><p>{project.summary}</p></div>
  <div class="case-visual"><div class="case-visual-top"><span>PROJECT / {project.number}</span><span>{project.status.toUpperCase()}</span></div><div class="case-visual-art" aria-hidden="true"><span class="case-orbit"></span><span class="case-orbit case-orbit--two"></span><b>{project.name.split(/\s+/).map(x => x[0]).join("").slice(0, 3)}</b></div><div class="case-visual-bottom"><span>{project.category}</span><span>VINITH REDDY BANDA</span></div></div>
  <div class="case-content"><div><span class="section-label">THE BRIEF</span><p class="case-description">{project.description}</p></div><aside class="case-details"><div><span>ROLE</span><b>{project.role}</b></div><div><span>STACK</span><p>{project.stack.join(" · ")}</p></div>{project.href && <a href={project.href} target="_blank" rel="noreferrer">SOURCE REPOSITORY ↗</a>}</aside></div>
  <section class="case-notes"><div class="section-kicker"><span>BUILD NOTES</span><span>DETAILS / {project.highlights.length}</span></div>{project.highlights.map((item, i) => <div class="case-note"><span>0{i + 1}</span><p>{item}</p></div>)}</section>
  <a class="next-work" href="/work/"><span>BACK TO THE ARCHIVE</span><b>Explore other work ↗</b></a>
</article>
</BaseLayout>