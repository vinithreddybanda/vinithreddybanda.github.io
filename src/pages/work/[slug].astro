---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { projects } from "../../data/projects";
export function getStaticPaths() { return projects.map(project => ({ params: { slug: project.slug }, props: { project } })); }
const { project } = Astro.props;
---
<BaseLayout title={project.name + " | Vinith"} description={project.summary}>
<article class="inner-page page-wrap case-page">
  <a class="back-link" href="/work/">← All work</a>
  <div class="inner-intro"><p>{project.category}</p><h1>{project.name}<em>.</em></h1><span>{project.summary}</span></div>
  <div class="case-hero-art"><span>{project.name.split(/\s+/).map(x=>x[0]).join("")}</span><i>✳</i></div>
  <div class="case-copy"><div><h2>What it is</h2><p>{project.description}</p></div><aside><h3>Made with</h3><div class="skill-pills">{project.stack.map(item=><span>{item}</span>)}</div>{project.href && <a class="text-link" href={project.href} target="_blank" rel="noreferrer">View source <span>↗</span></a>}</aside></div>
  <section class="simple-section"><h2>Some details</h2><div class="case-highlights">{project.highlights.map(item=><p><span>✳</span>{item}</p>)}</div></section>
  <a class="next-project" href="/work/">More projects <span>↗</span></a>
</article>
</BaseLayout>