---
import Shell from "../layouts/Shell.astro"; import {projects} from "../data/content";
---
<Shell title="Selected Work — Vinith Reddy Banda" description="Software projects, Android applications and applied AI experiments.">
<section class="inner-hero section-pad"><div class="section-index"><span>THE WORKSHOP / 01</span><span>PROJECT INDEX / 2025—26</span></div><p class="eyebrow">SELECTED WORK</p><h1 class="display-title">Made to<br/><em>be useful.</em></h1><p class="inner-deck">Software across mobile, web, backend and AI. Open a project for its brief, stack and build notes.</p><div class="inner-hero-foot"><span>{projects.length} PROJECT FILES</span><span>SCROLL TO BROWSE ↓</span></div></section>
<section class="work-section-home section-pad inner-work"><div class="section-index"><span>PROJECT FILES</span><span>01 — 0{projects.length}</span></div><div class="project-grid">{projects.map((p,i)=><a class="project-card rebuilt-card" href={"/studio/"+p.slug+"/"}><div class={"project-art art-"+(i+1)}><div class="art-topline"><span>{p.no} / {p.year}</span><span>{p.status.toUpperCase()}</span></div><div class="art-stage"><div class="project-preview"><small>{p.type.toUpperCase()}</small><b>{p.name}</b><em>{p.stack.slice(0,3).join(" / ")}</em><div class="preview-graphic"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div><span>VIEW CASE FILE ↗</span></div></div><span class="art-open">↗</span></div><div class="project-card-info"><div><span>{p.type.toUpperCase()}</span><h3>{p.name}</h3></div><b>↗</b></div><p class="project-summary">{p.summary}</p><div class="card-stack">{p.stack.slice(0,4).map(s=><span>{s}</span>)}</div></a>)}</div></section></Shell>