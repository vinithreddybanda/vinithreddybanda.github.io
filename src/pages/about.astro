---
import BaseLayout from "../layouts/BaseLayout.astro";
import { experience, skillGroups } from "../data/skills";
---
<BaseLayout title="About — Vinith Reddy Banda" description="Background and engineering interests of Vinith Reddy Banda.">
<section class="about-page page-wrap">
  <header class="archive-heading"><span class="micro-label">A LITTLE ABOUT ME</span><h1>Engineer by<br /><em>curiosity.</em></h1><p>I like turning complicated problems into software that feels straightforward. My work moves between backend engineering, web interfaces, Android and applied AI.</p></header>
  <div class="about-facts">
    <div><span>BASED IN</span><strong>Hyderabad, India</strong></div>
    <div><span>EDUCATION</span><strong>B.E. Information Technology · CBIT</strong></div>
    <div><span>ALSO</span><strong>Diploma in Computer Engineering</strong></div>
  </div>
  <section class="about-section"><div class="about-section__title"><span>01 / EXPERIENCE</span><h2>Where I've worked</h2></div><div class="timeline">{experience.map((item)=><article class="timeline-item"><span class="eyebrow">{item.period}</span><div><h3>{item.role}</h3><p class="timeline-item__org">{item.organisation}</p></div></article>)}</div></section>
  <section class="about-section"><div class="about-section__title"><span>02 / TOOLKIT</span><h2>What I work with</h2></div><div class="capability-grid">{skillGroups.map((group)=><div class="capability-group"><span class="eyebrow">{group.title}</span><div class="tag-list tag-list--large">{group.items.map(item=><span>{item}</span>)}</div></div>)}</div></section>
  <div class="about-cta"><p>Good problems are worth a conversation.</p><a href="mailto:vinithreddybanda@gmail.com">GET IN TOUCH ↗</a></div>
</section>
</BaseLayout>