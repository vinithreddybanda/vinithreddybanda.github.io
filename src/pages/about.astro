---
import Shell from "../layouts/Shell.astro";
import { experience, skills, recognition } from "../data/content";
---
<Shell title="About — Vinith Reddy Banda" description="The person behind the work: background, experience, skills and recognition.">
<section class="page-hero section-pad">
  <div class="section-index"><span>THE FRONT OFFICE</span><span>JOB Nº 001 / EST. 2005 / STATUS: OPEN</span></div>
  <div class="about-hero-grid"><div><p class="eyebrow"><span class="eyebrow-mark"></span> ABOUT THE BUILDER</p><h1>The person<br/>behind the<br/><em>pixels.</em></h1><p class="page-deck">A software engineer with a soft spot for thoughtful interfaces, useful tools and figuring out how things work.</p></div><div class="profile-file"><div class="file-top"><span>PERSONNEL FILE</span><span>VB—001</span></div><img src="https://avatars.githubusercontent.com/u/116493221?v=4" alt="Vinith Reddy Banda's profile portrait" loading="eager"/><div class="file-bottom"><b>VINITH REDDY BANDA</b><span>ENGINEER / BUILDER</span></div><div class="file-stamp">ON<br/>FILE</div></div></div>
  <div class="location-strip"><span>ORIGIN / WARANGAL, IN</span><span class="location-route">WARANGAL <i>→</i> HYDERABAD</span><span>BASED IN / INDIA</span></div>
</section>
<section class="telemetry-section section-pad">
  <div class="section-index"><span>TELEMETRY / SYNC</span><span>LIVE LOCAL READOUT</span></div>
  <div class="telemetry-grid">
    <div><span>LOCAL TIME</span><b id="about-clock">--:--:--</b></div>
    <div><span>POSITION</span><b>17°23′ N / 78°29′ E</b></div>
    <div><span>SESSION</span><b id="session-time">00:00</b></div>
    <div><span>STATUS</span><b id="about-presence">HERE / ONLINE</b></div>
  </div>
</section>
<section class="radio-section section-pad">
  <div class="section-index"><span>RADIO / TUNING</span><span>INTERACTIVE FREQUENCY DIAL</span></div>
  <div class="radio-layout">
    <div class="radio-copy"><span class="micro-label">THE DESK RADIO</span><h2>Find a<br/><em>frequency.</em></h2><p>Turn the dial. Each station has its own tone. Audio is generated locally and only plays when you press the control.</p><div class="radio-readout"><span id="radio-station">SEARCHING</span><b id="radio-frequency">88.0 FM</b></div><div class="radio-controls"><button type="button" id="radio-play">PLAY TONE <span>▶</span></button><button type="button" id="radio-stop" disabled>STOP <span>■</span></button></div></div>
    <div class="radio-dial-wrap"><div class="radio-dial" id="radio-dial" role="slider" tabindex="0" aria-label="Radio frequency" aria-valuemin="88" aria-valuemax="108" aria-valuenow="88"><div class="dial-ticks"></div><div class="dial-center"><span>VB</span><small>FM / ANALOG</small></div><div class="dial-pointer"></div></div><span class="dial-hint">DRAG OR USE ← → KEYS TO TUNE</span></div>
  </div>
</section>
<section class="rotation-section section-pad">
  <div class="section-index"><span>ROTATION / TAPE</span><span>DRAG TO TRAVEL</span></div>
  <div class="rotation-tape" id="rotation-tape" tabindex="0" aria-label="Draggable location tape">
    <div class="rotation-track"><span>WARANGAL · IN</span><i>✳</i><span>HYDERABAD · IN</span><i>✳</i><span>BUILDING ON THE WEB</span><i>✳</i><span>OPEN SOURCE / ANDROID</span><i>✳</i><span>WARANGAL · IN</span><i>✳</i><span>HYDERABAD · IN</span><i>✳</i><span>BUILDING ON THE WEB</span><i>✳</i><span>OPEN SOURCE / ANDROID</span><i>✳</i></div>
  </div>
  <div class="rotation-caption"><span>17°23′ N / 78°29′ E</span><span id="rotation-distance">WARANGAL → HYDERABAD</span><span>INDIA / IST +05:30</span></div>
</section>
<section class="letter-section section-pad">
  <div class="section-index"><span>01 / THE LETTER</span><span>PERSONAL STATEMENT</span></div>
  <div class="letter-layout"><div class="letter-aside"><span>TO WHOM IT MAY CONCERN</span><div class="letter-seal">V.</div><span>FILED UNDER<br/>CURIOSITY</span></div><div class="letter-body"><p class="letter-greeting">Hey, you pulled my file.</p><p>I’m Vinith, an IT engineer who enjoys making things for the web and Android. I like the full process: understanding a problem, shaping a solution, building the system behind it and polishing the details until the experience feels right.</p><p>My interests move between product development, backend engineering, interface design and applied AI. I’m drawn to projects where the technical challenge and the human experience matter equally.</p><p>Outside the code, I learn by building, contribute to open source and keep a running list of ideas that are probably too ambitious for a weekend.</p><p class="letter-signoff">Still figuring things out,<br/><em>Vinith.</em></p></div></div>
</section>
<section class="record-section section-pad">
  <div class="section-index"><span>02 / THE RECORD</span><span>EDUCATION & EXPERIENCE</span></div>
  <h2 class="section-title">Where I’ve<br/><em>been building.</em></h2>
  <div class="record-list">{experience.map((item,i)=><div class="record-row"><span class="record-no">0{i+1}</span><span class="record-when">{item.when}</span><div><h3>{item.place}</h3><p>{item.role}</p><small>{item.detail}</small></div><span class="record-arrow">↗</span></div>)}</div>
</section>
<section class="skills-section section-pad">
  <div class="section-index"><span>03 / THE TOOLBOX</span><span>TOOLS ARE NOT THE WORK</span></div>
  <div class="skills-layout"><h2 class="section-title">A flexible<br/><em>toolkit.</em></h2><div class="skill-cloud">{skills.map((skill,i)=><span style={"--delay:"+i*30+"ms"}>{skill}</span>)}</div></div>
</section>
<section class="recognition-section section-pad">
  <div class="section-index"><span>04 / ON FILE</span><span>RECOGNITION & MILESTONES</span></div>
  <h2 class="section-title">A few things<br/><em>picked up.</em></h2>
  <div class="recognition-list">{recognition.map((item,i)=><div><span>0{i+1}</span><b>{item[0]}</b><p>{item[1]}</p><i>↗</i></div>)}</div>
</section>
<section class="about-end section-pad"><span class="micro-label">THERE’S MORE TO BUILD</span><h2>Back to the<br/><em>workbench.</em></h2><a class="under-link" href="/studio/">EXPLORE SELECTED WORK <span>↗</span></a></section>
</Shell>