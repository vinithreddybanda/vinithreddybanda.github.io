---
import Shell from "../layouts/Shell.astro";
import { experience, skills, recognition, credentials, publicWork, socials } from "../data/content";
---
<Shell title="About — Vinith Reddy Banda" description="Background, engineering experience, achievements, research and public work.">
<section class="page-hero section-pad"><div class="section-index"><span>THE FRONT OFFICE</span><span>PERSONNEL FILE / VB—001</span></div><div class="about-hero-grid"><div><p class="eyebrow"><span class="eyebrow-mark"></span> ABOUT THE BUILDER</p><h1>Engineer by<br/>training.<br/><em>Builder by habit.</em></h1><p class="page-deck">I’m Vinith, an IT engineer working across Android, full-stack software and applied AI. I like solving the underlying problem as much as shaping the interface around it.</p></div><div class="profile-file"><div class="file-top"><span>PERSONNEL FILE</span><span>VB—001</span></div><img src="https://avatars.githubusercontent.com/u/116493221?v=4" alt="Vinith Reddy Banda" loading="eager"/><div class="file-bottom"><b>VINITH REDDY BANDA</b><span>ENGINEER / BUILDER</span></div><div class="file-stamp">ON<br/>FILE</div></div></div><div class="location-strip"><span>ORIGIN / WARANGAL</span><span class="location-route">WARANGAL <i>→</i> HYDERABAD</span><span>BASED IN / INDIA</span></div></section>



<section class="letter-section section-pad"><div class="section-index"><span>01 / THE LETTER</span><span>PERSONAL STATEMENT</span></div><div class="letter-layout"><div class="letter-aside"><span>TO WHOM IT MAY CONCERN</span><div class="letter-seal">V.</div><span>FILED UNDER<br/>CURIOSITY</span></div><div class="letter-body"><p class="letter-greeting">Hey, you pulled my file.</p><p>I’m an Information Technology graduate from CBIT, Hyderabad. I started with computer engineering, kept following the parts of software that interested me, and ended up building across Android, web and backend systems.</p><p>My day-to-day interests include Kotlin and Jetpack Compose, C# and .NET, TypeScript, databases and delivery automation. I enjoy the engineering underneath a product, but I care just as much about whether the finished thing is clear, responsive and pleasant to use.</p><p>I contribute to open-source projects, publish small tools, experiment with applied AI and learn by shipping things that can be tested outside a slide deck.</p><p class="letter-signoff">Still building,<br/><em>Vinith.</em></p></div></div></section>
<section class="record-section section-pad"><div class="section-index"><span>02 / THE RECORD</span><span>EDUCATION & EXPERIENCE</span></div><h2 class="section-title">The path<br/><em>so far.</em></h2><div class="record-list">{experience.map((item,i)=><div class="record-row"><span class="record-no">0{i+1}</span><span class="record-when">{item.when}</span><div><h3>{item.place}</h3><p>{item.role}</p><small>{item.detail}</small></div><span class="record-arrow">↗</span></div>)}</div></section>
<section class="skills-section section-pad"><div class="section-index"><span>03 / THE TOOLBOX</span><span>WORKING TECHNOLOGIES</span></div><div class="skills-layout"><h2 class="section-title">Tools for<br/><em>the job.</em></h2><div class="skill-cloud">{skills.map((skill,i)=><span style={"--delay:"+i*30+"ms"}>{skill}</span>)}</div></div></section>
<section class="recognition-section section-pad"><div class="section-index"><span>04 / RECOGNITION</span><span>SELECTED MILESTONES</span></div><h2 class="section-title">Work that<br/><em>got noticed.</em></h2><div class="recognition-list">{recognition.map((item,i)=><div><span>0{i+1}</span><b>{item[0]}</b><p>{item[1]}</p><i>↗</i></div>)}</div><div class="credentials-block"><div class="credentials-heading"><span>ADDITIONAL LEARNING</span><span>COURSES / COMMUNITY</span></div>{credentials.map((item,i)=><div class="credential-row"><span>0{i+1}</span><b>{item.title}</b><small>{item.issuer}</small><time>{item.date}</time></div>)}</div></section>
<section class="featured-section section-pad"><div class="section-index"><span>05 / PUBLIC RECORD</span><span>RESEARCH / BUILDS / RELEASES</span></div><h2 class="section-title">Out in<br/><em>the world.</em></h2><div class="featured-list">{publicWork.map((item,i)=><a class="featured-row" href={item.href} target="_blank" rel="noreferrer"><span>0{i+1}</span><div><small>{item.type}</small><b>{item.title}</b><p>{item.detail}</p></div><span class="featured-source">{item.source} ↗</span></a>)}</div><div class="social-index">{socials.map((item,i)=><a href={item.href} target="_blank" rel="noreferrer"><span>0{i+1}</span><b>{item.label}</b><small>{item.detail}</small><i>↗</i></a>)}</div></section>
<section class="about-end section-pad"><span class="micro-label">BACK TO THE WORK</span><h2>Less talk.<br/><em>More building.</em></h2><a class="under-link" href="/studio/">EXPLORE PROJECT FILES <span>↗</span></a></section></Shell>