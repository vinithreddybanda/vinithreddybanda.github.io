---
import BaseLayout from "../layouts/BaseLayout.astro";
import { experience, skillGroups } from "../data/skills";
---
<BaseLayout title="About — Vinith Reddy Banda" description="A short introduction to Vinith Reddy Banda.">
<section class="about-shell page-shell">
  <div class="about-head"><div class="intro-overline"><span>PERSONAL FILE</span><span>FILE / 001</span></div><h1>The person<br /><em>behind the work.</em></h1></div>
  <div class="badge-layout">
    <aside class="lanyard-badge"><div class="badge-clip"></div><div class="badge-top"><span>IDENTIFICATION</span><span>VB / 001</span></div><div class="badge-monogram">V<span>.</span>B</div><div class="badge-name">VINITH REDDY BANDA</div><div class="badge-role">SOFTWARE ENGINEER</div><div class="badge-bottom"><span>HYDERABAD, INDIA</span><span>2026</span></div></aside>
    <article class="typed-letter">
      <span class="letter-label">A LETTER / FROM THE DESK</span><h2>Hello, there.</h2>
      <p>I’m Vinith, an Information Technology engineer based in Hyderabad. I enjoy building software that solves a real problem, then giving it an interface that feels considered rather than complicated.</p>
      <p>My work moves between backend systems, web applications, Android and applied AI. I’m especially interested in the details that make products dependable: architecture, performance, interaction and the experience around the code.</p>
      <p>Outside the editor, I’m usually exploring open-source projects, learning a new tool or taking an idea from a rough sketch to something people can use.</p>
      <div class="letter-signoff"><span>Regards,</span><strong>Vinith.</strong></div>
    </article>
  </div>
  <section class="file-section"><div class="section-kicker"><span>THE RECORD</span><span>01 / EXPERIENCE</span></div><div class="record-list">{experience.map(item => <div class="record-row"><span>{item.period}</span><div><b>{item.organisation}</b><small>{item.role}</small></div><p>{item.detail}</p></div>)}</div></section>
  <section class="file-section"><div class="section-kicker"><span>ON THE DESK</span><span>02 / TOOLKIT</span></div><div class="toolkit-list">{skillGroups.map(group => <div class="toolkit-row"><b>{group.title}</b><p>{group.items.join(" · ")}</p></div>)}</div></section>
  <div class="about-contact"><p>Have a good problem?</p><a href="mailto:vinithreddybanda@gmail.com">WRITE TO ME ↗</a></div>
</section>
</BaseLayout>